@article{kim2025ais,
  abbr={한국SCM학회지},
  level = {KCI},
  title={준지도 학습을 이용한 AIS 정박 패턴 분석과 비공식 묘박지 탐지 연구},
  author={Kim, Jongmin and Park, Kikun and Lee, Hyunha and Park, Hanbyeol and Bae, Hyerim},
  journal={한국SCM학회지},
  doi={10.25052/KSCM.2025.12.25.3.35},
  year={2025},
  volume={3},
  number={특집호},
  pages={35-47},
  keywords={Automatic Identification System (AIS), Port and Anchorage Classification and Generalization, Semi-supervised Learning},
  abstract={For efficient port logistics and precise maritime traffic management, automatic recognition of vessel anchoring behavior is essential. This study proposes a semi-supervised learning–based anchorage detection framework using AIS data to overcome the limitations of official anchorage information. By quantifying vessel stopping trajectory features and applying a stepwise semi-supervised structure based on high-confidence data, the method reduces labeling costs while maintaining generalization across ports. Trained with Busan and Ulsan data and validated with Yeosu–Gwangyang and Pyeongtaek–Dangjin data, the model achieved 98% accuracy and an F1-score of 0.98. The results demonstrate the potential of Automatic Identification System (AIS)-based automation for port activity recognition and its applicability to port operation optimization and real-time vessel monitoring.},
  html={https://www.kci.go.kr/kciportal/ci/sereArticleSearch/ciSereArtiView.kci?sereArticleSearchBean.artiId=ART003289132},
}

