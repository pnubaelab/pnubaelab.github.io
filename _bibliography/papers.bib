@misc{sim2024metaverse,
  level = {Arxiv},
  abbr={arXiv},
  arxiv={2409.10519},
  title={Artificial Intelligence-based Smart Port Logistics Metaverse for Enhancing Productivity, Environment, and Safety in Port Logistics: A Case Study of Busan Port},
  author={Sim, Sunghyun and Kim, Dohee and Park, Kikun and Bae, Hyerim},
  keywords={Smart port, Metaverse, Artificial intelligence, Port logistics, Digital twin},
  abstract={The increase in global trade, the impact of COVID-19, and the tightening of environmental and safety regulations have brought significant changes to the maritime transportation market. The port logistics industry is under pressure to respond to these changes, and is increasingly adopting data-driven approaches to meet this need. Recently, the development of digital twins and the metaverse utilizing artificial intelligence and big data has been attracting significant attention in smart port research. In this paper, we review the main challenges of port logistics, which involve productivity improvement and environmental conservation and safety and risk management, and present the metaverse and digital twin frameworks that incorporate artificial intelligence-based methodologies to support decision-making regarding each challenge. Furthermore, we provide a comprehensive review of the current development status and future outlook of Busan Port-related data platforms and AI-based port logistics research, focusing on the challenges discussed, with the aim of contributing to the development of smart ports in Busan.},
  journal={arXiv preprint arXiv:2409.10519},
  year={2024}
}

