@inproceedings{lee2025darkvessel,
  level = {International Conference},
  abbr={LOGMS},
  abstract={Illegal maritime operations, including AIS-off navigation and dark vessel activities, present persistent challenges to maritime domain awareness. This study proposes a real-time multimodal fusion framework that integrates X-band radar tracks and Automatic Identification System (AIS) data for robust detection and characterization of dark vessels. Temporal asynchrony between radar (3–4 s) and AIS (10–180 s) sampling is addressed through a three-stage alignment strategy combining nearest assignment, linear interpolation, and geodesic-based motion prediction. Candidate associations are refined via temporal, spatial, and angular gating, with final matches optimized by a composite cost function. A systematic hyperparameter search identifies an optimal configuration ensuring both matching reliability and spatial accuracy. Subsequently, unmatched radar tracks are processed through a six-stage rule-based checker—covering trajectory continuity, speed consistency, and update regularity—to filter out physically implausible motions. Applied to real maritime data collected near Busan Port (August 1, 2025), the system successfully identifies dark-vessel candidates with a 0.744 matching rate and ~106 m 90th-percentile error across 32,770 radar detections and 198 vessels. Finally, trajectories are projected into radar coordinates and rasterized for sensor-level validation, bridging the gap between traditional rule-based tracking and learning-based multimodal vessel classification. The proposed approach enables reliable dark-vessel monitoring even under limited AIS coverage, providing a scalable foundation for intelligent maritime surveillance systems.},
  title={A Real-Time Dark Vessel Detection System Using Multimodal Fusion},
  author={Lee, Kyunghoon and Kim, Seonghan and Bae, Hyerim and Changdong Lee},
  booktitle={13th International Conference on Logistics and Maritime Systems},
  year={2025},
}

@inproceedings{choo2025ALMA,
  level = {International Conference},
  abbr={LOGMS},
  abstract={To support sustainable maritime operations, international organizations have enforced stricter 
environmental regulations, highlighting the need for accurate ship fuel consumption forecasting. However, 
existing models face generalization challenges due to limited historical data, especially for newly deployed 
vessels. We propose Adaptive Lag Moment Alignment (ALMA), a domain adaptation framework that 
transfers knowledge from data-rich source ships to target ships with only a single recorded voyage. ALMA 
introduces Lag Moment Discrepancy (LMD) to align temporal characteristics between domains and 
combines it with prediction loss. To stabilize training and balance objectives, we incorporate Dynamic 
Weight Averaging (DWA) into the loss function. Experimental results demonstrate that ALMA 
significantly reduces domain gaps and improves prediction accuracy under data-scarce conditions, 
offering a robust solution for maritime fuel forecasting in support of global sustainability efforts.},
  title={ALMA: Adaptive Lag Moment Alignment for Domain-Adaptive Time Series Forecasting of Ship Fuel Consumption},
  author={Choo, Jungho and Kim, Dohee and Lee, Hyunha and Kim, Minhee and Bae, Hyerim},
  journal={13th International Conference on Logistics and Maritime Systems},
  year={2025},
}

@inproceedings{hong2025LURKER,
  level = {International Conference},
  abbr={ICICIC},
  title={LURKER: Language models for Unveiling maritime Risks via Knowledge-driven Event forecasting and Reasoning},
  author={Hong, Seongmoon and Park, Taekhyun and Kim, Dohee and Jo, Sangmin and Bae, Hyerim},
  abstract={Maritime accident risk prediction has highlighted the limitations of purely statistical classifiers and numerical scoring schemes, driving demand for scenario-driven analytical methods that can elucidate both the context and progression of incidents. In response, we propose LURKER (Language models for Unveiling maritime Risks via Knowledge-driven Event forecasting and Reasoning), an explainable framework that leverages the reasoning capabilities of large language models (LLMs) to analyze maritime accident severity. LURKER quantifies accident risk by integrating a tree-based classification model with isotonic regression for probability calibration, then generates dynamic scenarios through a prompt-engineering module that summarizes tribunal reports and incorporates real-time data. By employing few-shot learning and chain-of-thought prompting, LURKER produces context-rich descriptions of causal factors, incident progression, and potential impacts. This approach transcends purely numerical analysis, offering comprehensive explanations of accident causes and consequences, and functions as an intelligent decision-support tool. Case-based experiments integrating tribunal reports, AIS vessel-track data, and meteorological observations demonstrate LURKER’s feasibility and practical utility as a severity-prediction tool for operational maritime safety management.},
  booktitle={19th International Conference on Innovative Computing, Information and Control (ICICIC 2025)},
  address={Kitakyushu, Japan},
  organization={ICIC International},
  keywords={Maritime Accident, Large Language Model, Prompt Engineering, Severity Prediction, Probability Calibration},
  year={2025},
}


@misc{park2025reasoningawaregrpousingprocess,
      level = {Arxiv},
      abbr={arXiv},
      journal={arXiv preprint},
      title={Reasoning-Aware GRPO using Process Mining}, 
      author={Park, Taekhyun and Lee, Yongjae and Bae, Hyerim},
      abstract={Reinforcement learning (RL)-based post-training has been crucial for enabling multi-step reasoning in large reasoning models (LRMs), yet current reward schemes are typically outcome-centric. We propose PM4GRPO, a reasoning-aware Group Relative Policy Optimization (GRPO) that augments standard answer/format rewards with signals over the reasoning procedure. To this end, process mining techniques are utilized to compute a scalar conformance reward that measures how closely a policy model's reasoning aligns with the pretrained teacher model. The empirical results on five benchmarks demonstrate that PM4GRPO significantly outperforms existing methodologies for GRPO-based post-training. These results highlight that leveraging process mining for reasoning-aware GRPO effectively enhances the reasoning capabilities of policy models.},
      year={2025},
      eprint={2510.25065},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      pdf={https://arxiv.org/abs/2510.25065}, 
      arxiv={2510.25065},
      doi={https://doi.org/10.48550/arXiv.2510.25065}
}

@article{PARK2025111610,
level = {SCI},
abbr={Comput.Ind.Eng.},
title = {Optimizing yard truck deployment at container terminals: a machine learning-enhanced non-dominated sorting genetic algorithm},
journal = {Computers & Industrial Engineering},
pages = {111610},
year = {2025},
issn = {0360-8352},
doi = {https://doi.org/10.1016/j.cie.2025.111610},
pdf = {https://www.sciencedirect.com/science/article/pii/S0360835225007569},
author = {Park, Kikun  and Kim, Kihun and Kim, Minseop and Bae, Hyerim},
keywords = {Container terminal operations, Yard truck deployment, Non-dominated sorting genetic algorithm 2, Mult-objective optimization with tradeoff relationship},
abstract = {The continuous rise in global container traffic has necessitated more efficient operational strategies at container terminals (CTs). However, developing effective strategies requires mitigating delays in handling equipment operations. Yard trucks (YTs) are pivotal for transporting containers between quay cranes (QCs) and yard cranes (YCs). A YT shortage can cause operational delays for both QCs and YCs, extending the makespan of main-vessel operations at the berth. Conversely, deploying an excessive number of YTs eliminates these delays but incurs higher operational costs. Consequently, determining the optimal number of YTs constitutes a bi-objective optimization problem involving a tradeoff between minimizing the operational makespan and associated YT deployment costs. This study introduces a machine learning (ML)-enhanced non-dominated sorting genetic algorithm 2 (NSGA-2) approach designed to address this challenge by minimizing both the makespan and deployment costs. The proposed method uses ML models to predict fitness scores and efficiently guide the search toward optimal solutions, while also assisting in generating, selecting, and mutating promising solutions during the optimization process. The effectiveness of ML-enhanced NSGA-2 was validated using empirical data from Busan Port Terminal in South Korea. The results highlight the superior performance and practical applicability of the proposed approach, which achieved a significant reduction of 16% in deployed YTs compared to existing strategies.},
additional_info={. **JCR Q1, Top 14.29%!!!**},
selected={true},
}

@article{PARK2026103974,
level = {SCI},
title = {Time-series approach to vessel turnaround time forecasting using queuing-based operation indicators},
journal = {Advanced Engineering Informatics},
abbr={Adv.Eng.Info},
volume = {69},
pages = {103974},
year = {2026},
issn = {1474-0346},
doi = {https://doi.org/10.1016/j.aei.2025.103974},
pdf = {https://www.sciencedirect.com/science/article/pii/S1474034625008675},
author = {Park, Daesan and Noh, Taeeon and Koo, Yohan and Lee, Hyeonjik and Kim, Dowon and Bae, Hyerim},
keywords = {Maritime transport, Vessel turnaround time, Operation indicator, Two-stage queuing system, Time-series forecasting},
abstract = {As global supply chains grow increasingly complex and cargo volumes continue to rise, the accurate prediction of vessel turnaround time (VTT) has become essential for enhancing port operational efficiency. Previous studies primarily utilized static features, such as vessel specifications and container volumes, often failing to capture the dynamic nature of real-world operations. To address this limitation, we propose a forecasting framework that incorporates dynamic operation indicators (OIs) from a two-stage queuing model into time-series models. Leveraging operational data from Busan Port, our approach achieves of up to 28% improvement in mean absolute percentage error compared with existing techniques. Explainability analysis using Shapley additive explanations (SHAP) further demonstrates that OIs rank among the most influential features. By providing more reliable VTT predictions, port operators can enhance berth planning, optimize resource allocation, minimize scheduling delays, and enhance overall port efficiency. These results highlight the practical value of the framework for data-driven decision-making in port operations.},
additional_info={. **JCR Q1, Top 2.00%!!!**},
selected={true},
}


@misc{lee2025iconv,
  level = {Arxiv},
  abbr={arXiv},
  abstract={Real-world time-series data often exhibit non-stationarity, including changing trends, irregular seasonality, and residuals. In terms of changing trends, recently proposed multi-layer perceptron (MLP)-based models have shown excellent performance owing to their computational efficiency and ability to capture long-term dependency. However, the linear nature of MLP architectures poses limitations when applied to channels with diverse distributions, resulting in local variations such as seasonal patterns and residual components being ignored. However, convolutional neural networks (CNNs) can effectively incorporate these variations. To resolve the limitations of MLP, we propose combining them with CNNs. The overall trend is modeled using an MLP to consider long-term dependencies. The CNN uses diverse kernels to model fine-grained local patterns in conjunction with MLP trend predictions. To focus on modeling local variation, we propose IConv, a novel convolutional architecture that processes the temporal dependency channel independently and considers the inter-channel relationship through distinct layers. Independent channel processing enables the modeling of diverse local temporal dependencies and the adoption of a large kernel size. Distinct inter-channel considerations reduce computational cost. The proposed model is evaluated through extensive experiments on time-series datasets. The results reveal the superiority of the proposed method for multivariate time-series forecasting.},
  title={IConv: Focusing on Local Variation with Channel Independent Convolution for Multivariate Time Series Forecasting},
  author={Lee, Gawon and Park, Hanbyeol and Kim, Minseop and Kim, Dohee and Bae, Hyerim},
  journal={arXiv preprint arXiv:2509.20783},
  year={2025},
  arxiv={2509.20783}
}

@article{kim2025forecasting,
  level= {Arxiv},
  abbr={Authorea},
  abstract={The continuous growth in global trade and rising
uncertainty have driven extensive research on container
throughput (CT) forecasting at monthly and annual scales.
Recently, the demand for high-resolution CT forecasting has
emerged to support real-time decision-making by practitioners.
However, this presents challenges in effectively utilizing realtime port operation information and managing high-noise time
series data. To address these limitations, this study introduces a
preprocessing strategy and novel neural network architecture
for forecasting hourly CT with a 72-hour horizon, an approach
not attempted in previous studies. In the preprocessing strategy,
we examined the electronic data interchange (EDI) system and
extracted key factors affecting CT. Additionally, we present a
novel neural network architecture—the decomposition
pairwise mixer (DPM)—which is designed to effectively capture
interactions among these factors. Extensive experiments were
conducted with real operational data from the port of Busan in
Korea, the world’s sixth-busiest port. The results reveal two key
findings: derived key factors enhance the forecasting
performance, and the proposed method outperforms state-ofthe-art time-series forecasting models. These findings suggest
that the proposed method is not limited to long-term planning
but can also substantially enhance short-term operational
decision-making, thereby improving port operation efficiency.},
  pdf={https://d197for5662m48.cloudfront.net/documents/publicationstatus/277654/preprint_pdf/311668491e95663eaf73d410e37c395e.pdf},
  title={Forecasting Hourly Container Throughput with EDI-Derived Factors and a Decomposition Pairwise Mixer},
  author={Kim, Minseop and Park, Kikun and Park, Hanbyeol and Lee, Kyunghoon and Kim, Kihun and Bae, Hyerim},
  journal={Authorea Preprints},
  year={2025},
  publisher={Authorea}
}

@ARTICLE{11153658,
  level = {SCI},
  abbr={IEEE Access},
  html={https://ieeexplore.ieee.org/document/11153658},
  author={Park, Hanbyeol and Sim, Sunghyun and Park, Yunkyung and Bae, Hyerim},
  journal={IEEE Access}, 
  title={Trend-fluctuation correlated attention unit for remaining useful life prediction}, 
  abstract={Health indicators (HIs) are measures that consolidate complex machinery characteristics into a single dimension and have been extensively studied for predicting the remaining useful life (RUL). Recent research has proposed HI-prediction models based on recursive cell structures that demonstrate promising performance. However, recent cell structures have limitations, such as saturation in hidden states and difficulty learning interdependent patterns among various components. Accurate RUL predictions require minimizing error accumulation in the recursive HI-prediction process, which can be achieved using a cell structure capable of capturing interdependent patterns. This study proposes a new cell structure termed the trend-fluctuation correlated attention unit (TFCAU) that employs a gate mechanism to capture interactions between divided trends and fluctuations in HI and an attention mechanism for robust long-term predictions. The superiority of the TFCAU was validated using a bearing dataset from the PRONOSTIA platform and a real-world dataset from the Korean weapons system. Comparative experiments using six sub-datasets demonstrated that TFCAU outperformed the state-of-the-art model—the gated transient fluctuation dual-attention unit—achieving a 169.37% improvement in the score metric and a reduction of 49.93 units in the mean-absolute error. An extensive ablation study experimentally confirmed that the TFCAU effectively captured the interdependent characteristics between trends and fluctuations. TFCAU delivered excellent performance for both rotating and non-rotating systems, suggesting its potential applicability across multiple operational scenarios.},
  year={2025},
  volume={13},
  number={},
  pages={164486-164507},
  keywords={Fluctuations;Degradation;Market research;Computer architecture;Vectors;Logic gates;Microprocessors;Predictive models;Accuracy;Maintenance;Decomposition;health indicators;interdependent patterns;long-term predictions;remaining useful life (RUL) prediction;temporal dependencies},
  doi={10.1109/ACCESS.2025.3607444}}

@inproceedings{lee2025multi,
  level = {International Conference},
  abbr={BPM},
  html={https://link.springer.com/chapter/10.1007/978-3-032-02867-9_22},
  doi={https://doi.org/10.1007/978-3-032-02867-9_22},
  abstract={Anomaly detection in business processes is crucial to prevent erroneous organizational decision-making. Existing anomaly detection methods often assume access to a clean event log without anomalies, a scenario that is impractical in the real world. To solve this problem, MuGAD is proposed, a novel framework that detects anomalies in scenarios where only a limited number of labeled anomalies are available. By converting traces into a newly designed graph structure, the framework captures the control flow, order of events, and attribute information, facilitating the effective use of graph neural networks. Furthermore, MuGAD uses a two-stage training procedure designed to (1) reduce the risks posed by unlabeled traces and (2) enable the detection of anomalous traces and events. Comparative experiments are conducted on five real-life event logs to validate our proposed framework. The experimental results indicate that MuGAD outperforms the existing methods and provides better detection accuracy along with better interpretability in terms of F1-score.},
  title={Multi-task Trained Graph Neural Network for Business Process Anomaly Detection with a Limited Number of Labeled Anomalies},
  author={Lee, Yongjae and Kim, Dohee and Kim, Donghwan and Bae, Hyerim},
  booktitle={International Conference on Business Process Management},
  pages={361--378},
  year={2025},
}

@misc{park2025justdense,
  level = {Arxiv},
  abbr={arXiv},
  arxiv={2508.09153},
  abstract = {Sequence and channel mixers, the core mechanism in sequence models, have become the de facto standard in time series analysis (TSA). However, recent studies have questioned the necessity of complex sequence mixers, such as attention mechanisms, demonstrating that simpler architectures can achieve comparable or even superior performance. This suggests that the benefits attributed to complex sequencemixers might instead emerge from other architectural or optimization factors. Based on this observation, we pose a central question: Are common sequence mixers necessary for time-series analysis? Therefore, we propose JustDense, an empirical study that systematically replaces sequence mixers in various well-established TSA models with dense layers. Grounded in the MatrixMixer framework, JustDense treats any sequence mixer as a mixing matrix and replaces it with a dense layer. This substitution isolates the mixing operation, enabling a clear theoretical foundation for understanding its role. Therefore, we conducted extensive experiments on 29 benchmarks covering five representative TSA tasks using seven state-of-the-art TSA models to address our research question. The results show that replacing sequence mixers with dense layers yields comparable or even superior performance. In the cases where dedicated sequence mixers still offer benefits, JustDense challenges the assumption that "deeper and more complex architectures are inherently better" in TSA.},
  title={JustDense: Just using Dense instead of Sequence Mixer for Time Series analysis},
  author={Park, Taekhyun and Lee, Yongjae and Park, Daesan and Kim, Dohee and Bae, Hyerim},
  journal={arXiv preprint},
  year={2025}
}

@article{kim2025long,
  level = {SCI},
  abbr={J. Forecasting},
  pdf={https://onlinelibrary.wiley.com/doi/pdf/10.1002/for.3176},
  html={https://onlinelibrary.wiley.com/doi/full/10.1002/for.3176},
  abstract={Forecasting the maritime economics index, including container volume and Baltic Panamax Index, is essential for long-term planning and decision-making in the shipping industry. However, studies on container volume prediction are not sufficient, and the bulk freight index has highly fluctuating characteristics, which pose a challenge in long-term prediction. This study proposes a new hybrid framework for the long-term prediction of the maritime economics index. The framework consists of time-series decomposition to break down a time-series into several components (trend, seasonality, and residual), a two-stage attention mechanism that prioritizes important variables to increase long-term prediction accuracy and a long short-term memory network that predicts and combines all components to derive the final predictive outcome. Extensive experiments are conducted using the container volume data, bulk freight index data, and various external variables. The proposed framework achieved a better predictive performance than existing time-series methods, including conventional machine learning and deep learning-based models, in the long-term prediction of container volume and the Baltic Panamax Index. Hence, the proposed method can help in decision-making through accurate long-term predictions of the maritime economics index.},
  title={Long-term forecasting of maritime economics index using time-series decomposition and two-stage attention},
  author={Kim, Dohee and Lee, Eunju and Kamal, Imam Mustafa and Bae, Hyerim},
  journal={Journal of Forecasting},
  volume={44},
  number={1},
  pages={153--172},
  year={2025},
  google_scholar_id={48xauSegjOkC},
  publisher={Wiley Online Library},
  selected={true},
  additional_info={. **JCR Q1, Top 16.17%!!!**}
}

@article{sim2023correlation,
  level = {SCI},
  abbr={TPAMI},
  pdf={https://ieeexplore.ieee.org/abstract/document/10264112/},
  html={https://ieeexplore.ieee.org/document/10264112},
  arxiv={https://arxiv.org/pdf/2211.16653},
  abstract={Time-series forecasting (TSF) is a traditional problem in the field of artificial intelligence, and models such as recurrent neural network, long short-term memory, and gate recurrent units have contributed to improving its predictive accuracy. Furthermore, model structures have been proposed to combine time-series decomposition methods such as seasonal-trend decomposition using LOESS. However, this approach is learned in an independent model for each component, and therefore, it cannot learn the relationships between the time-series components. In this study, we propose a new neural architecture called a correlation recurrent unit (CRU) that can perform time-series decomposition within a neural cell and learn correlations (autocorrelation and correlation) between each decomposition component. The proposed neural architecture was evaluated through comparative experiments with previous studies using four univariate and four multivariate time-series datasets. The results showed that long- and short-term predictive performance was improved by more than 10%. The experimental results indicate that the proposed CRU is an excellent method for TSF problems compared to other neural architectures.},
  title={Correlation recurrent units: A novel neural architecture for improving the predictive performance of time-series data},
  author={Sim, Sunghyun and Kim, Dohee and Bae, Hyerim},
  journal={IEEE Transactions on Pattern Analysis and Machine Intelligence},
  selected={true},
  volume={45},
  number={12},
  pages={14266--14283},
  google_sholar_id={roLk4NBRz8UC},
  year={2023},
  publisher={IEEE},
  doi={10.1109/TPAMI.2023.3319557},
  additional_info={. **JCR Q1, Top 0.85%!!!!**}
}

@article{park2021vessel,
  level = {SCOPUS},
  abbr={MARTRA},
  abstract={Port operation efficiency has grown in importance as container volumes and vessel sizes have increased. For improved port operations efficiency, the estimated time of arrival (ETA) of sea-going vessels must be accurately predicted. In this paper, an AIS data-driven method- ology is proposed for the estimation of vessel ETA at ports. For ETA prediction, we first introduce how to find possible vessel trajectories using AIS data mining methods and reinforcement learning (RL); next, we introduce the Markov Chain property and Bayesian Sampling to estimate the speed over ground (SOG) of a vessel. Experimentation comparing the proposed methodology with an existing one was performed to verify the former's performance. We expect the proposed ETA prediction methodology to predict ETA to help build an intelligent port system.},
