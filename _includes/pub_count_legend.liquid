{% assign pub_count = site.data.pub_count %}
<div class="pub-legend" style="display:flex; gap: 1rem; align-items:center; flex-wrap: wrap; margin: 0.25rem 0 1.25rem;">
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color: var(--legend-primary-color);">KCI</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.kci }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color: var(--legend-primary-color);">SCOPUS</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.scopus }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color: var(--legend-primary-color);">SCI</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.sci }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color: var(--legend-primary-color);">Intl. Conf.</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.international_conference }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color: var(--legend-primary-color);">Dom. Conf.</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.domestic_conference }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color: var(--legend-primary-color);">Arxiv</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.arxiv }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span role="img" aria-label="Total" style="font-size:1.1em;">📊</span>
    <span style="font-weight:600; color: var(--legend-primary-color);">Total</span>
    <span style="color: var(--legend-secondary-color);">{{ pub_count.total }}</span>
  </div>
</div>

