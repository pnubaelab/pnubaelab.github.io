{% assign pub_count = site.data.pub_count %}
<div class="pub-legend" style="display:flex; gap: 1rem; align-items:center; flex-wrap: wrap; margin: 0.25rem 0 1.25rem;">
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color:#1f2937;">KCI</span>
    <span style="color:#6b7280;">{{ pub_count.kci }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color:#1f2937;">SCOPUS</span>
    <span style="color:#6b7280;">{{ pub_count.scopus }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color:#1f2937;">SCI</span>
    <span style="color:#6b7280;">{{ pub_count.sci }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color:#1f2937;">Intl. Conf.</span>
    <span style="color:#6b7280;">{{ pub_count.international_conference }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color:#1f2937;">Dom. Conf.</span>
    <span style="color:#6b7280;">{{ pub_count.domestic_conference }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span style="font-weight:600; color:#1f2937;">Arxiv</span>
    <span style="color:#6b7280;">{{ pub_count.arxiv }}</span>
  </div>
  <div style="display:flex; align-items:center; gap:0.5rem;">
    <span role="img" aria-label="Total" style="font-size:1.1em;">📊</span>
    <span style="font-weight:600; color:#1f2937;">Total</span>
    <span style="color:#6b7280;">{{ pub_count.total }}</span>
  </div>
</div>

