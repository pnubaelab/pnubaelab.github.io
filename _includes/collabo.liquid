<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600&display=swap">
<style>
  .collabo-section,
  .collabo-section * {
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.02em;
  }
  .collabo-legend,
  .collabo-legend *,
  .collabo-node-tooltip,
  .collabo-node-tooltip *,
  #coauthor-graph-loader {
    color: #ffffff !important;
  }
  .collabo-node-tooltip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    font-size: 15px;
    line-height: 1.3;
    min-width: 180px;
    max-width: 280px;
  }
  .collabo-tooltip-theme {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .collabo-tooltip-topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    max-width: 260px;
  }
  .collabo-topic-chip {
    display: inline-block;
    max-width: 150px;
    padding: 0.14rem 0.38rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: #ffffff !important;
    font-size: 0.62rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .collabo-tooltip-meta {
    color: rgba(255, 255, 255, 0.72) !important;
    font-size: 0.68rem;
  }
  .collabo-node-photo-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.75);
    background: #0b0f1c;
  }
  #coauthor-graph-loader {
    font-weight: 400;
    text-transform: uppercase;
  }
  #coauthor-graph-wrapper {
    box-sizing: border-box;
    padding: 7px;
    border: 1px solid rgba(132, 171, 230, 0.18);
    border-radius: clamp(18px, 2.4vw, 26px);
    background: linear-gradient(145deg, rgba(18, 31, 56, 0.9), rgba(2, 6, 17, 0.96));
    box-shadow:
      0 18px 48px rgba(0, 0, 0, 0.32),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  #coauthor-graph {
    border-radius: clamp(14px, 2vw, 20px);
  }
  .collabo-legend {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(2, 6, 17, 0.85);
    border-radius: 8px;
    font-size: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .collabo-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff !important;
  }
  .collabo-legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: 0 0 8px currentColor;
  }
  .collabo-legend-dot.author {
    background: linear-gradient(135deg, #00bfff, #2979ff);
  }
  .collabo-legend-dot.keyword {
    background: #f1f0ec;
    border-radius: 4px;
  }
  .node-label {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    text-shadow: 0 0 4px rgba(0,0,0,0.8), 0 0 8px rgba(0,0,0,0.6);
  }
  .collabo-back-button {
    position: absolute;
    top: 19px;
    right: 19px;
    z-index: 1001;
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 28px;
    padding: 0 0.7rem;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px;
    background: rgba(2, 6, 17, 0.9);
    color: #ffffff;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 160ms ease, transform 160ms ease, background 160ms ease;
  }
  .collabo-back-button:hover {
    background: rgba(18, 36, 70, 0.95);
    transform: translateY(-1px);
  }
  .collabo-back-button.is-visible {
    display: inline-flex;
  }
  @media (max-width: 575.98px) {
    #coauthor-graph-wrapper {
      padding: 5px;
      border-radius: 18px;
    }
    #coauthor-graph {
      border-radius: 14px;
    }
    .collabo-back-button {
      top: 15px;
      right: 15px;
      min-width: 46px;
      padding-inline: 0.55rem;
    }
  }
</style>
<div class="collabo-section" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: stretch;">
  <div id="coauthor-graph-wrapper" style="position: relative;">
    <div id="coauthor-graph" style="height: 520px; min-height: 360px; border: 1px solid #222; box-shadow: 0 0 24px #000a; background: #020611; position: relative; overflow: hidden;">
      <div id="coauthor-graph-loader" style="position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;color:#ffffff;font-size:.85rem;font-family:system-ui,Segoe UI,sans-serif;letter-spacing:.5px;">Loading Collaboration Graph…</div>
    </div>
    <button id="collabo-back-button" class="collabo-back-button" type="button" aria-label="Clear focused collaboration nodes">Back</button>
  </div>
  <div style="margin-top: .25rem;">
    {% include pub_stats.liquid %}
  </div>
  <div id="coauthor-table" style="width: 100%;"></div>
</div>
<script src="//cdn.jsdelivr.net/npm/force-graph"></script>
<script>
{% assign firstPhoto = true %}
const COLLABO_PHOTOS = {
{% for person in site.people %}
  {% if person.img %}
    {% unless firstPhoto %},{% endunless %}
    "{{ person.title | split:'(' | first | strip | replace:'"','\\"' }}": "{{ person.img | strip }}"
    {% assign firstPhoto = false %}
  {% endif %}
{% endfor %}
};
const COLLABO_DEFAULT_PHOTO = '/assets/img/BAELAB_LOGO.png';
const COLLABO_FEATURED_AUTHOR_ID = 'Bae, Hyerim';
const COLLABO_FEATURED_AUTHOR_COLOR = 'rgb(255, 255, 255)';
const COLLABO_FEATURED_AUTHOR_RGB = [255, 255, 255];

(() => {
  const container = document.getElementById('coauthor-graph');
  const backButton = document.getElementById('collabo-back-button');
  if (!container) return;

  function initGalaxyBackground(target) {
    const galaxyCanvas = document.createElement('canvas');
    const ctx = galaxyCanvas.getContext('2d', { alpha: true });
    if (!ctx) return null;

    galaxyCanvas.setAttribute('aria-hidden', 'true');
    galaxyCanvas.style.position = 'absolute';
    galaxyCanvas.style.inset = '0';
    galaxyCanvas.style.width = '100%';
    galaxyCanvas.style.height = '100%';
    galaxyCanvas.style.zIndex = '0';
    galaxyCanvas.style.pointerEvents = 'none';
    target.prepend(galaxyCanvas);

    const dpr = () => Math.min(window.devicePixelRatio || 1, 2);
    let width = 1;
    let height = 1;
    let mouseX = 0.5;
    let mouseY = 0.5;
    let smoothMouseX = 0.5;
    let smoothMouseY = 0.5;

    const stars = [];
    function createStars(count) {
      stars.length = 0;
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random(),
          y: Math.random(),
          z: 0.3 + Math.random() * 0.7,
          size: 0.3 + Math.random() * 1.6,
          twinkle: Math.random() * Math.PI * 2,
          twinkleSpeed: 0.2 + Math.random() * 1.2,
          hue: 190 + Math.random() * 70
        });
      }
    }

    const onMouseMove = (e) => {
      const rect = target.getBoundingClientRect();
      mouseX = (e.clientX - rect.left) / Math.max(1, rect.width);
      mouseY = (e.clientY - rect.top) / Math.max(1, rect.height);
    };

    const updateResolution = () => {
      width = Math.max(1, target.clientWidth || 1);
      height = Math.max(1, target.clientHeight || 1);
      const ratio = dpr();
      galaxyCanvas.width = Math.max(1, Math.floor(width * ratio));
      galaxyCanvas.height = Math.max(1, Math.floor(height * ratio));
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      const density = Math.max(140, Math.min(420, Math.round((width * height) / 2200)));
      createStars(density);
    };

    const drawNebula = (t) => {
      const cx = width * (0.5 + (smoothMouseX - 0.5) * 0.06);
      const cy = height * (0.5 + (smoothMouseY - 0.5) * 0.06);

      const g1 = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(width, height) * 0.65);
      g1.addColorStop(0, 'rgba(40,95,180,0.23)');
      g1.addColorStop(0.5, 'rgba(86,42,145,0.16)');
      g1.addColorStop(1, 'rgba(2,6,17,0)');
      ctx.fillStyle = g1;
      ctx.fillRect(0, 0, width, height);

      const angle = t * 0.00006;
      const rx = Math.cos(angle) * width * 0.12;
      const ry = Math.sin(angle * 1.2) * height * 0.1;
      const g2 = ctx.createRadialGradient(
        cx + rx,
        cy + ry,
        0,
        cx + rx,
        cy + ry,
        Math.max(width, height) * 0.45
      );
      g2.addColorStop(0, 'rgba(129,93,255,0.15)');
      g2.addColorStop(1, 'rgba(2,6,17,0)');
      ctx.fillStyle = g2;
      ctx.fillRect(0, 0, width, height);
    };

    const drawStars = (t) => {
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        const tw = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(s.twinkle + t * 0.001 * s.twinkleSpeed));
        const px = s.x * width + (smoothMouseX - 0.5) * 30 * s.z;
        const py = s.y * height + (smoothMouseY - 0.5) * 24 * s.z;
        const r = s.size * s.z * (0.6 + tw * 0.9);
        const alpha = 0.18 + tw * 0.55;

        const starGrad = ctx.createRadialGradient(px, py, 0, px, py, Math.max(0.8, r * 3.8));
        starGrad.addColorStop(0, `hsla(${s.hue}, 85%, 78%, ${alpha})`);
        starGrad.addColorStop(1, `hsla(${s.hue}, 90%, 65%, 0)`);
        ctx.fillStyle = starGrad;
        ctx.beginPath();
        ctx.arc(px, py, Math.max(0.8, r * 3.8), 0, Math.PI * 2);
        ctx.fill();
      }
    };

    target.addEventListener('mousemove', onMouseMove);
    const resizeObserver = new ResizeObserver(updateResolution);
    resizeObserver.observe(target);
    updateResolution();

    let rafId = 0;
    const render = (t) => {
      rafId = requestAnimationFrame(render);
      smoothMouseX += (mouseX - smoothMouseX) * 0.05;
      smoothMouseY += (mouseY - smoothMouseY) * 0.05;

      ctx.clearRect(0, 0, width, height);
      drawNebula(t);
      drawStars(t);
    };
    rafId = requestAnimationFrame(render);

    const cleanup = () => {
      cancelAnimationFrame(rafId);
      resizeObserver.disconnect();
      target.removeEventListener('mousemove', onMouseMove);
      if (galaxyCanvas.parentNode === target) target.removeChild(galaxyCanvas);
    };

    window.addEventListener('pagehide', cleanup, { once: true });
    return cleanup;
  }

  function initGalaxyFramePainter(target) {
    let mouseX = 0.5;
    let mouseY = 0.5;
    let smoothMouseX = 0.5;
    let smoothMouseY = 0.5;
    let mouseActive = 0;
    let smoothMouseActive = 0;
    let width = 0;
    let height = 0;
    const stars = [];

    const createStars = (count) => {
      stars.length = 0;
      for (let i = 0; i < count; i++) {
        stars.push({
          angle: Math.random() * Math.PI * 2,
          radius: Math.pow(Math.random(), 0.62),
          z: 0.3 + Math.random() * 0.7,
          size: 0.24 + Math.random() * 1.05,
          twinkle: Math.random() * Math.PI * 2,
          twinkleSpeed: 0.2 + Math.random() * 1.1,
          spin: (Math.random() * 2 - 1) * 0.24,
          phase: Math.random(),
          speed: 0.12 + Math.random() * 0.24
        });
      }
    };

    const ensureStars = (w, h) => {
      if (w === width && h === height && stars.length) return;
      width = w;
      height = h;
      const density = Math.max(160, Math.min(500, Math.round((w * h) / 2800)));
      createStars(density);
    };

    const onMouseMove = (e) => {
      const rect = target.getBoundingClientRect();
      mouseX = (e.clientX - rect.left) / Math.max(1, rect.width);
      mouseY = (e.clientY - rect.top) / Math.max(1, rect.height);
      mouseActive = 1;
    };
    const onMouseLeave = () => {
      mouseX = 0.5;
      mouseY = 0.5;
      mouseActive = 0;
    };
    target.addEventListener('mousemove', onMouseMove);
    target.addEventListener('mouseleave', onMouseLeave);

    return {
      draw(ctx, t) {
        const w = ctx.canvas.width;
        const h = ctx.canvas.height;
        if (!w || !h) return;
        ensureStars(w, h);

        const time = t * 0.001;

        smoothMouseX += (mouseX - smoothMouseX) * 0.05;
        smoothMouseY += (mouseY - smoothMouseY) * 0.05;
        smoothMouseActive += (mouseActive - smoothMouseActive) * 0.06;

        const centerX = w * 0.5;
        const centerY = h * 0.5;
        const focusX = w * smoothMouseX;
        const focusY = h * smoothMouseY;

        const cx = focusX;
        const cy = focusY;
        const globalRot = time * 0.08;

        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);

        ctx.fillStyle = 'rgba(1, 3, 10, 0.94)';
        ctx.fillRect(0, 0, w, h);

        const nebulaA = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(w, h) * 0.62);
        nebulaA.addColorStop(0, 'rgba(20,45,90,0.2)');
        nebulaA.addColorStop(0.55, 'rgba(35,20,70,0.12)');
        nebulaA.addColorStop(1, 'rgba(2,6,17,0)');
        ctx.fillStyle = nebulaA;
        ctx.fillRect(0, 0, w, h);

        const angle = t * 0.00006;
        const rx = Math.cos(angle) * w * 0.12;
        const ry = Math.sin(angle * 1.2) * h * 0.1;
        const nebulaB = ctx.createRadialGradient(cx + rx, cy + ry, 0, cx + rx, cy + ry, Math.max(w, h) * 0.46);
        nebulaB.addColorStop(0, 'rgba(55,70,130,0.1)');
        nebulaB.addColorStop(1, 'rgba(2,6,17,0)');
        ctx.fillStyle = nebulaB;
        ctx.fillRect(0, 0, w, h);

        const core = ctx.createRadialGradient(focusX, focusY, 0, focusX, focusY, Math.max(w, h) * 0.18);
        core.addColorStop(0, `rgba(165, 215, 255, ${0.12 + smoothMouseActive * 0.1})`);
        core.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = core;
        ctx.fillRect(0, 0, w, h);

        const lensRadius = Math.max(w, h) * (0.18 + 0.14 * smoothMouseActive);
        const lensReach = lensRadius * 2.2;
        const clamp01 = (v) => Math.max(0, Math.min(1, v));
        const distortPoint = (x, y, strength = 1) => {
          const dx = x - focusX;
          const dy = y - focusY;
          const dist = Math.hypot(dx, dy);
          if (dist >= lensReach || dist < 0.0001) return { x, y };

          const nx = dx / dist;
          const ny = dy / dist;
          const falloff = 1 - clamp01(dist / lensReach);
          const pinch = (0.1 + 0.22 * smoothMouseActive) * falloff * falloff * strength;
          const twist = (0.08 + 0.2 * smoothMouseActive) * falloff * falloff * strength;

          const warpedX = x - nx * dist * pinch + (-ny) * dist * twist;
          const warpedY = y - ny * dist * pinch + (nx) * dist * twist;
          return { x: warpedX, y: warpedY };
        };

        if (smoothMouseActive > 0.02) {
          const ring = ctx.createRadialGradient(focusX, focusY, lensRadius * 0.45, focusX, focusY, lensRadius * 1.05);
          ring.addColorStop(0, `rgba(255,255,255,${0.02 + smoothMouseActive * 0.02})`);
          ring.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.fillStyle = ring;
          ctx.beginPath();
          ctx.arc(focusX, focusY, lensRadius * 1.05, 0, Math.PI * 2);
          ctx.fill();
        }

        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];
          const tw = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(s.twinkle + time * s.twinkleSpeed));
          const depth = (s.phase + time * s.speed) % 1;
          const zoom = 2.0 - 1.86 * depth;
          const driftAngle = s.angle + time * s.spin + globalRot;
          const orbitX = Math.cos(driftAngle) * s.radius * w * 0.92;
          const orbitY = Math.sin(driftAngle) * s.radius * h * 0.92;

          let px = cx + orbitX * zoom;
          let py = cy + orbitY * zoom;

          const dx = px - focusX;
          const dy = py - focusY;
          const dist = Math.hypot(dx, dy) + 0.0001;
          const nx = dx / dist;
          const ny = dy / dist;
          const influence = Math.exp(-dist / (Math.max(w, h) * 0.6));
          const inv = 1 / (dist + 28);
          const active = 0.08 + 0.92 * smoothMouseActive;
          const pullBase = (3120 * inv) * (0.4 + 0.9 * s.z) * active;
          const swirlBase = (1900 * inv) * (0.35 + 0.65 * s.z) * active;
          const depthFlow = 0.45 + 1.4 * (1 - depth);
          const suction = pullBase * depthFlow * influence;
          const swirl = swirlBase * (0.4 + 0.8 * (1 - depth)) * influence;

          const vx = -nx * suction + -ny * swirl;
          const vy = -ny * suction + nx * swirl;
          px += vx;
          py += vy;

          const warped = distortPoint(px, py, 0.65 + 0.55 * s.z);
          px = warped.x;
          py = warped.y;

          const r = s.size * s.z * (0.6 + tw * 1.05);
          const alpha = 0.22 + tw * 0.5;

          const starGrad = ctx.createRadialGradient(px, py, 0, px, py, Math.max(0.9, r * 2.9));
          starGrad.addColorStop(0, `rgba(255,255,255,${alpha})`);
          starGrad.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.fillStyle = starGrad;
          ctx.beginPath();
          ctx.arc(px, py, Math.max(0.9, r * 2.9), 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.restore();
      },
      destroy() {
        target.removeEventListener('mousemove', onMouseMove);
        target.removeEventListener('mouseleave', onMouseLeave);
      }
    };
  }

  const galaxyPainter = initGalaxyFramePainter(container);

  const htmlEscape = (str = '') => str.replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);

  function buildNameVariants(rawName = '') {
    const variants = new Set();
    const base = rawName.trim();
    if (!base) return [];
    variants.add(base);
    variants.add(base.replace(/\s+/g, ' '));

    if (base.includes(',')) {
      const [lastPart, ...rest] = base.split(',');
      const last = lastPart.trim();
      const first = rest.join(',').trim();
      if (first && last) {
        variants.add(`${first} ${last}`.trim());
        variants.add(`${last} ${first}`.trim());
      }
    } else {
      const tokens = base.split(/\s+/);
      if (tokens.length >= 2) {
        const last = tokens[tokens.length - 1];
        const first = tokens.slice(0, -1).join(' ');
        variants.add(`${last}, ${first}`.trim());
        variants.add(`${first} ${last}`.trim());
      }
    }

    variants.add(base.replace(/[.,]/g, '').trim());
    return [...variants].filter(Boolean);
  }

  function getNodePhoto(name) {
    const variants = buildNameVariants(name);
    for (const candidate of variants) {
      if (COLLABO_PHOTOS[candidate]) return COLLABO_PHOTOS[candidate];
    }
    return null;
  }

  function extractFirstName(name) {
    if (name.includes(',')) {
      const parts = name.split(',');
      return parts[1] ? parts[1].trim() : '';
    }
    if (/^[가-힣]{2,}$/.test(name)) return name.slice(-2);
    if (/^[A-Za-z ]+$/.test(name.trim())) return name.trim().split(/\s+/)[0];
    return name;
  }
  function setBibSearchValue(value, retries = 6) {
    const searchBox = document.getElementById('bibsearch');
    if (searchBox) {
      searchBox.value = value;
      searchBox.dispatchEvent(new Event('input', { bubbles: true }));
      searchBox.focus();
    } else if (retries > 0) {
      setTimeout(() => setBibSearchValue(value, retries - 1), 250);
    }
  }

  // Responsive height logic for 2D graph
  function computeHeight() {
    const w = container.clientWidth || 800;
    if (w < 576) return Math.max(Math.round(w), 400);
    return Math.max(Math.round(w * 9/16), 420);
  }
  function resizeCanvas(graphInstance) {
    const h = computeHeight();
    container.style.height = h + 'px';
    graphInstance && graphInstance.height(h).width(container.clientWidth || 800);
    const canvases = container.querySelectorAll('canvas');
    canvases.forEach((canvas, idx) => {
      if (idx === 0) return;
      canvas.style.position = 'absolute';
      canvas.style.inset = '0';
      canvas.style.zIndex = '1';
      canvas.style.background = 'transparent';
    });
  }

  // Project complete author topic profiles onto three continuous PCA color axes.
  // Rare topics hidden from the graph remain part of the color representation.
  function createPcaAuthorColors(authorNodes, keywordNodes, links, keywordSimData = null) {
    const similarityPayload = keywordSimData && (keywordSimData.similarities || keywordSimData);
    const configuredSimilarityAlpha = Number(keywordSimData?.alpha);
    const similarityAlpha = Number.isFinite(configuredSimilarityAlpha)
      ? Math.max(0, Math.min(0.75, configuredSimilarityAlpha))
      : 0.3;
    const configuredNeighborAlpha = Number(keywordSimData?.neighbor_alpha);
    const neighborSimilarityAlpha = Number.isFinite(configuredNeighborAlpha)
      ? Math.max(0, Math.min(0.5, configuredNeighborAlpha))
      : Math.min(0.3, similarityAlpha);
    const decodeLatentTopicSpace = payload => {
      if (
        payload?.encoding !== 'int8-base64'
        || !Array.isArray(payload.ids)
        || !Array.isArray(payload.scales)
        || typeof payload.data !== 'string'
      ) {
        return null;
      }
      const dimensions = Math.max(0, Math.floor(Number(payload.dimensions) || 0));
      const uniqueIds = new Set(payload.ids);
      const validScales = payload.scales.every(scale => (
        Number.isFinite(Number(scale)) && Number(scale) > 0
      ));
      if (
        !dimensions
        || dimensions > 1024
        || payload.scales.length !== dimensions
        || uniqueIds.size !== payload.ids.length
        || payload.ids.some(id => typeof id !== 'string')
        || !validScales
      ) {
        return null;
      }

      let binary;
      try {
        binary = atob(payload.data);
      } catch (error) {
        console.warn('Collaboration PCA ignored invalid latent topic data.', error);
        return null;
      }
      if (binary.length !== payload.ids.length * dimensions) return null;

      const vectorsById = new Map();
      payload.ids.forEach((id, rowIndex) => {
        const vector = new Float64Array(dimensions);
        for (let axis = 0; axis < dimensions; axis++) {
          const byte = binary.charCodeAt(rowIndex * dimensions + axis);
          const signedValue = byte > 127 ? byte - 256 : byte;
          const scale = Number(payload.scales[axis]);
          vector[axis] = signedValue * scale;
        }
        vectorsById.set(id, vector);
      });
      return { dimensions, vectorsById };
    };
    const latentTopicSpace = decodeLatentTopicSpace(keywordSimData?.topic_vectors);

    const featureNames = new Set(
      keywordNodes.map(node => node.name || node.id.replace(/^kw:/, ''))
    );
    authorNodes.forEach(author => {
      Object.keys(author.topic_profile || {}).forEach(topic => featureNames.add(topic));
    });

    const topicNames = [...featureNames].sort((a, b) => {
      const aKey = a.toLowerCase();
      const bKey = b.toLowerCase();
      if (aKey !== bKey) return aKey < bKey ? -1 : 1;
      return a < b ? -1 : a > b ? 1 : 0;
    });
    const topicIds = topicNames.map(topic => 'kw:' + topic);
    const topicIndex = new Map(topicIds.map((id, index) => [id, index]));
    const authorFeatures = new Map();
    const authorsWithFullProfiles = new Set();
    const orderedAuthors = [...authorNodes].sort(
      (a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0
    );

    orderedAuthors.forEach(author => {
      const vector = new Array(topicNames.length).fill(0);
      const profile = author.topic_profile;
      if (profile && typeof profile === 'object' && !Array.isArray(profile)) {
        authorsWithFullProfiles.add(author.id);
        Object.entries(profile).forEach(([topic, rawWeight]) => {
          const index = topicIndex.get('kw:' + topic);
          if (index !== undefined) vector[index] = Math.max(0, Number(rawWeight) || 0);
        });
      }
      authorFeatures.set(author.id, vector);
    });

    // Compatibility path for older JSON that only has author-keyword links.
    links.forEach(link => {
      const sourceId = typeof link.source === 'object' ? link.source.id : link.source;
      const targetId = typeof link.target === 'object' ? link.target.id : link.target;
      let authorId;
      let keywordId;
      if (String(sourceId).startsWith('kw:')) {
        authorId = targetId;
        keywordId = sourceId;
      } else if (String(targetId).startsWith('kw:')) {
        authorId = sourceId;
        keywordId = targetId;
      } else {
        return;
      }
      if (!authorFeatures.has(authorId) || authorsWithFullProfiles.has(authorId)) return;
      const index = topicIndex.get(keywordId);
      if (index !== undefined) {
        authorFeatures.get(authorId)[index] = Math.max(0, Number(link.value) || 1);
      }
    });

    // Every author participates, including zero-topic rows.
    const authorIds = [...authorFeatures.keys()];
    const rawVectors = authorIds.map(authorId => authorFeatures.get(authorId));

    // Sublinear TF and author-level IDF preserve the existing topic weighting.
    const idfWeights = new Array(topicNames.length).fill(1);
    for (let featureIndex = 0; featureIndex < topicNames.length; featureIndex++) {
      let documentFrequency = 0;
      for (let authorIndex = 0; authorIndex < rawVectors.length; authorIndex++) {
        if (rawVectors[authorIndex][featureIndex] > 0) documentFrequency++;
      }
      idfWeights[featureIndex] = Math.min(
        3.5,
        Math.log((rawVectors.length + 1) / (documentFrequency + 0.5)) + 1
      );
    }

    const directVectors = rawVectors.map(rawVector =>
      rawVector.map((value, featureIndex) =>
        value > 0 ? Math.log1p(value) * idfWeights[featureIndex] : 0
      )
    );
    // Within each semantic centroid, down-weight low-support phrases relative
    // to repeatedly observed topics. Visible topics have exact paper counts;
    // hidden topics use the maximum per-author count as a conservative estimate.
    const visibleTopicPaperFrequencies = new Map(keywordNodes.map(node => [
      node.id,
      Math.max(0, Number(node.paper_count ?? node.value) || 0)
    ]));
    const topicPaperFrequencies = new Array(topicNames.length).fill(0);
    topicIds.forEach((topicId, featureIndex) => {
      const visiblePaperFrequency = visibleTopicPaperFrequencies.get(topicId);
      if (visiblePaperFrequency > 0) {
        topicPaperFrequencies[featureIndex] = visiblePaperFrequency;
        return;
      }
      rawVectors.forEach(rawVector => {
        topicPaperFrequencies[featureIndex] = Math.max(
          topicPaperFrequencies[featureIndex],
          rawVector[featureIndex]
        );
      });
    });
    const semanticSourceVectors = rawVectors.map(rawVector =>
      rawVector.map((value, featureIndex) => {
        if (value <= 0) return 0;
        const paperFrequency = topicPaperFrequencies[featureIndex];
        const reliability = Math.sqrt(paperFrequency / (paperFrequency + 2));
        return Math.log1p(value) * reliability;
      })
    );
    let vectors = directVectors;

    // Prefer dense latent topic coordinates; otherwise build the legacy
    // symmetric, row-normalized neighbor channel as a compatibility fallback.
    const visibleTopicIds = keywordNodes.map(node => node.id);
    const similarityFloor = keywordSimData && Number.isFinite(Number(keywordSimData.threshold))
      ? Number(keywordSimData.threshold)
      : 0.7;
    const similarityCoverage = similarityPayload && topicIds.length
      ? topicIds.filter(id => Array.isArray(similarityPayload[id])).length / topicIds.length
      : 0;
    const visibleSimilarityCoverage = similarityPayload && visibleTopicIds.length
      ? visibleTopicIds.filter(id => Array.isArray(similarityPayload[id])).length
        / visibleTopicIds.length
      : 0;
    let semanticNeighborCoverage = 0;
    let visibleSemanticNeighborCoverage = 0;
    let semanticApplied = false;
    let semanticMode = 'direct';
    const latentTopicCoverage = latentTopicSpace && topicIds.length
      ? topicIds.filter(id => latentTopicSpace.vectorsById.has(id)).length / topicIds.length
      : 0;
    const normalizeChannel = channel => {
      const magnitude = Math.sqrt(
        channel.reduce((sum, value) => sum + value * value, 0)
      );
      if (!Number.isFinite(magnitude) || magnitude <= 1e-12) {
        return new Array(channel.length).fill(0);
      }
      return Array.from(channel, value => value / magnitude);
    };

    if (latentTopicSpace && similarityAlpha > 0 && latentTopicCoverage >= 0.8) {
      const directScale = Math.sqrt(1 - similarityAlpha);
      const semanticScale = Math.sqrt(similarityAlpha);
      vectors = directVectors.map((directVector, authorIndex) => {
        const semanticVector = new Float64Array(latentTopicSpace.dimensions);
        semanticSourceVectors[authorIndex].forEach((value, featureIndex) => {
          if (!value) return;
          const topicVector = latentTopicSpace.vectorsById.get(topicIds[featureIndex]);
          if (!topicVector) return;
          for (let axis = 0; axis < latentTopicSpace.dimensions; axis++) {
            semanticVector[axis] += value * topicVector[axis];
          }
        });
        return normalizeChannel(directVector).map(value => value * directScale)
          .concat(normalizeChannel(semanticVector).map(value => value * semanticScale));
      });
      semanticApplied = true;
      semanticMode = 'latent-topic-pca';
    } else if (
      similarityPayload
      && neighborSimilarityAlpha > 0
      && visibleSimilarityCoverage >= 0.8
    ) {
      const semanticRows = Array.from({ length: topicNames.length }, () => new Map());
      Object.entries(similarityPayload).forEach(([sourceId, neighbors]) => {
        const sourceIndex = topicIndex.get(sourceId);
        if (sourceIndex === undefined || !Array.isArray(neighbors)) return;
        neighbors.forEach(pair => {
          if (!pair || pair.length < 2) return;
          const targetIndex = topicIndex.get(pair[0]);
          const similarity = Number(pair[1]);
          if (
            targetIndex === undefined
            || !Number.isFinite(similarity)
            || similarity <= 0
          ) {
            return;
          }
          const weight = Math.max(
            0,
            Math.min(1, (similarity - similarityFloor) / Math.max(1e-6, 1 - similarityFloor))
          );
          if (!weight) return;
          semanticRows[sourceIndex].set(
            targetIndex,
            Math.max(semanticRows[sourceIndex].get(targetIndex) || 0, weight)
          );
          semanticRows[targetIndex].set(
            sourceIndex,
            Math.max(semanticRows[targetIndex].get(sourceIndex) || 0, weight)
          );
        });
      });

      semanticNeighborCoverage = semanticRows.filter(row => row.size > 0).length
        / Math.max(1, semanticRows.length);
      visibleSemanticNeighborCoverage = visibleTopicIds.filter(id => {
        const index = topicIndex.get(id);
        return index !== undefined && semanticRows[index].size > 0;
      }).length / Math.max(1, visibleTopicIds.length);

      if (semanticNeighborCoverage > 0) {
        const directScale = Math.sqrt(1 - neighborSimilarityAlpha);
        const semanticScale = Math.sqrt(neighborSimilarityAlpha);
        vectors = directVectors.map(directVector => {
          const semanticVector = directVector.slice();
          directVector.forEach((value, sourceIndex) => {
            if (!value || !semanticRows[sourceIndex].size) return;
            const rowTotal = [...semanticRows[sourceIndex].values()]
              .reduce((sum, weight) => sum + weight, 0) || 1;
            semanticRows[sourceIndex].forEach((weight, targetIndex) => {
              semanticVector[targetIndex] += value * weight / rowTotal;
            });
          });
          return normalizeChannel(directVector).map(value => value * directScale)
            .concat(normalizeChannel(semanticVector).map(value => value * semanticScale));
        });
        semanticApplied = true;
        semanticMode = 'neighbor-diffusion';
      }
    }

    const normalize = vector => {
      const magnitude = Math.sqrt(
        vector.reduce((sum, value) => sum + value * value, 0)
      ) || 1;
      return vector.map(value => value / magnitude);
    };
    vectors = vectors.map(normalize);

    // Center every feature before extracting the three principal axes.
    const semanticDimension = semanticMode === 'latent-topic-pca'
      ? latentTopicSpace.dimensions
      : semanticApplied ? topicNames.length : 0;
    const vectorDimension = vectors[0]?.length
      ?? topicNames.length + semanticDimension;
    const featureMeans = new Float64Array(vectorDimension);
    vectors.forEach(vector => {
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        featureMeans[featureIndex] += vector[featureIndex];
      }
    });
    if (vectors.length) {
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        featureMeans[featureIndex] /= vectors.length;
      }
    }

    const centeredRows = vectors.map(vector => {
      const centered = new Float64Array(vectorDimension);
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        centered[featureIndex] = vector[featureIndex] - featureMeans[featureIndex];
      }
      return centered;
    });

    // Work in author space (X X^T). This is the deterministic dual form of the
    // NIPALS power step and avoids constructing a much larger feature covariance.
    const sampleCount = centeredRows.length;
    const gram = Array.from(
      { length: sampleCount },
      () => new Float64Array(sampleCount)
    );
    let totalCenteredSumSquares = 0;
    for (let rowIndex = 0; rowIndex < sampleCount; rowIndex++) {
      for (let otherIndex = 0; otherIndex <= rowIndex; otherIndex++) {
        let value = 0;
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          value += centeredRows[rowIndex][featureIndex]
            * centeredRows[otherIndex][featureIndex];
        }
        gram[rowIndex][otherIndex] = value;
        gram[otherIndex][rowIndex] = value;
      }
      totalCenteredSumSquares += gram[rowIndex][rowIndex];
    }

    const rawScores = Array.from({ length: sampleCount }, () => [0, 0, 0]);
    const explainedVariance = [0, 0, 0];
    const componentVectors = [];
    const varianceDenominator = Math.max(1, sampleCount - 1);
    const varianceFloor = Math.max(
      Number.EPSILON,
      totalCenteredSumSquares * 1e-12
    );
    const componentLimit = Math.min(
      3,
      vectorDimension,
      Math.max(0, sampleCount - 1)
    );

    const removePreviousComponents = vector => {
      componentVectors.forEach(previous => {
        let projection = 0;
        for (let index = 0; index < sampleCount; index++) {
          projection += vector[index] * previous[index];
        }
        for (let index = 0; index < sampleCount; index++) {
          vector[index] -= projection * previous[index];
        }
      });
    };

    const normalizeInPlace = vector => {
      let normSquared = 0;
      for (let index = 0; index < vector.length; index++) {
        normSquared += vector[index] * vector[index];
      }
      if (normSquared <= varianceFloor || !Number.isFinite(normSquared)) return false;
      const inverseNorm = 1 / Math.sqrt(normSquared);
      for (let index = 0; index < vector.length; index++) {
        vector[index] *= inverseNorm;
      }
      return true;
    };

    for (let componentIndex = 0; componentIndex < componentLimit; componentIndex++) {
      // Use the highest-energy residual feature as a stable, data-derived seed.
      let eigenvector = null;
      let seedEnergy = 0;
      const candidate = new Float64Array(sampleCount);
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          candidate[authorIndex] = centeredRows[authorIndex][featureIndex];
        }
        removePreviousComponents(candidate);
        let energy = 0;
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          energy += candidate[authorIndex] * candidate[authorIndex];
        }
        if (energy > seedEnergy) {
          seedEnergy = energy;
          eigenvector = Float64Array.from(candidate);
        }
      }
      if (!eigenvector || seedEnergy <= varianceFloor || !normalizeInPlace(eigenvector)) {
        break;
      }

      for (let iteration = 0; iteration < 300; iteration++) {
        const next = new Float64Array(sampleCount);
        for (let rowIndex = 0; rowIndex < sampleCount; rowIndex++) {
          let value = 0;
          for (let columnIndex = 0; columnIndex < sampleCount; columnIndex++) {
            value += gram[rowIndex][columnIndex] * eigenvector[columnIndex];
          }
          next[rowIndex] = value;
        }
        removePreviousComponents(next);
        if (!normalizeInPlace(next)) break;

        let alignment = 0;
        for (let index = 0; index < sampleCount; index++) {
          alignment += eigenvector[index] * next[index];
        }
        if (alignment < 0) {
          for (let index = 0; index < sampleCount; index++) next[index] *= -1;
        }

        let deltaSquared = 0;
        for (let index = 0; index < sampleCount; index++) {
          const delta = next[index] - eigenvector[index];
          deltaSquared += delta * delta;
        }
        eigenvector = next;
        if (deltaSquared <= 1e-18) break;
      }

      const gramTimesVector = new Float64Array(sampleCount);
      for (let rowIndex = 0; rowIndex < sampleCount; rowIndex++) {
        let value = 0;
        for (let columnIndex = 0; columnIndex < sampleCount; columnIndex++) {
          value += gram[rowIndex][columnIndex] * eigenvector[columnIndex];
        }
        gramTimesVector[rowIndex] = value;
      }
      let eigenvalue = 0;
      for (let index = 0; index < sampleCount; index++) {
        eigenvalue += eigenvector[index] * gramTimesVector[index];
      }
      if (eigenvalue <= varianceFloor || !Number.isFinite(eigenvalue)) break;

      const singularValue = Math.sqrt(eigenvalue);
      const loading = new Float64Array(vectorDimension);
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        let value = 0;
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          value += centeredRows[authorIndex][featureIndex] * eigenvector[authorIndex];
        }
        loading[featureIndex] = value / singularValue;
      }
      if (!normalizeInPlace(loading)) break;

      // Eigenvector signs are arbitrary. Anchor each sign to its strongest loading.
      let signAnchorIndex = 0;
      for (let featureIndex = 1; featureIndex < vectorDimension; featureIndex++) {
        if (
          Math.abs(loading[featureIndex])
          > Math.abs(loading[signAnchorIndex])
        ) {
          signAnchorIndex = featureIndex;
        }
      }
      if (loading[signAnchorIndex] < 0) {
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          loading[featureIndex] *= -1;
        }
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          eigenvector[authorIndex] *= -1;
        }
      }

      let scoreEnergy = 0;
      for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
        let score = 0;
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          score += centeredRows[authorIndex][featureIndex] * loading[featureIndex];
        }
        rawScores[authorIndex][componentIndex] = score;
        scoreEnergy += score * score;
      }
      if (scoreEnergy <= varianceFloor || !Number.isFinite(scoreEnergy)) break;

      componentVectors.push(eigenvector);
      explainedVariance[componentIndex] = scoreEnergy / varianceDenominator;
    }

    // Stretch each PCA axis into an 8-bit channel. A soft percentile blend
    // expands dense score regions without discarding the original PCA distance
    // or assigning different colors to identical research profiles.
    const rgbRows = Array.from({ length: sampleCount }, () => [128, 128, 128]);
    const scoreRanges = [];
    const colorPercentileWeight = 0.65;
    for (let axis = 0; axis < 3; axis++) {
      let minimum = Infinity;
      let maximum = -Infinity;
      rawScores.forEach(scores => {
        minimum = Math.min(minimum, scores[axis]);
        maximum = Math.max(maximum, scores[axis]);
      });
      if (!sampleCount) {
        minimum = 0;
        maximum = 0;
      }
      scoreRanges.push([minimum, maximum]);
      const range = maximum - minimum;
      const degenerate = !Number.isFinite(range)
        || range <= Math.max(1, Math.abs(minimum), Math.abs(maximum)) * 1e-12;

      const rankedScores = rawScores
        .map((scores, authorIndex) => ({
          authorIndex,
          value: scores[axis]
        }))
        .sort((a, b) => a.value - b.value || a.authorIndex - b.authorIndex);
      const percentileByAuthor = new Float64Array(sampleCount);
      for (let rankStart = 0; rankStart < rankedScores.length;) {
        let rankEnd = rankStart + 1;
        while (
          rankEnd < rankedScores.length
          && rankedScores[rankEnd].value === rankedScores[rankStart].value
        ) {
          rankEnd++;
        }
        const midRank = (rankStart + rankEnd - 1) / 2;
        const percentile = sampleCount > 1 ? midRank / (sampleCount - 1) : 0.5;
        for (let rankIndex = rankStart; rankIndex < rankEnd; rankIndex++) {
          percentileByAuthor[rankedScores[rankIndex].authorIndex] = percentile;
        }
        rankStart = rankEnd;
      }

      rawScores.forEach((scores, authorIndex) => {
        if (degenerate) {
          rgbRows[authorIndex][axis] = 128;
          return;
        }
        const linearPosition = Math.max(
          0,
          Math.min(1, (scores[axis] - minimum) / range)
        );
        const colorPosition = linearPosition * (1 - colorPercentileWeight)
          + percentileByAuthor[authorIndex] * colorPercentileWeight;
        rgbRows[authorIndex][axis] = Math.max(
          0,
          Math.min(255, Math.round(colorPosition * 255))
        );
      });
    }

    const result = new Map();
    const rgbById = new Map();
    const scoresById = new Map();
    const authorNodeById = new Map(orderedAuthors.map(author => [author.id, author]));
    authorIds.forEach((authorId, authorIndex) => {
      const rgb = rgbRows[authorIndex].slice();
      const scores = rawScores[authorIndex].slice();
      const color = 'rgb(' + rgb.join(', ') + ')';
      result.set(authorId, color);
      rgbById.set(authorId, rgb);
      scoresById.set(authorId, scores);

      const authorNode = authorNodeById.get(authorId);
      if (authorNode) {
        authorNode.pcaRgb = rgb.slice();
        authorNode.pcaScores = scores.slice();
        authorNode.pcaColor = color;
      }
    });

    const totalVariance = totalCenteredSumSquares / varianceDenominator;
    const explainedVarianceRatio = explainedVariance.map(variance =>
      totalVariance > varianceFloor
        ? Math.max(0, Math.min(1, variance / totalVariance))
        : 0
    );
    const coverage = {
      similarity: similarityCoverage,
      visibleSimilarity: visibleSimilarityCoverage,
      semanticNeighbors: semanticNeighborCoverage,
      visibleSemanticNeighbors: visibleSemanticNeighborCoverage
    };

    result.meta = {
      authorIds: authorIds.slice(),
      rgbById,
      scoresById,
      rawScores: rawScores.map(scores => scores.slice()),
      explainedVariance,
      explainedVarianceRatio,
      totalVariance,
      activeComponents: componentVectors.length,
      scoreRanges,
      colorMapping: 'minmax-percentile-blend',
      colorPercentileWeight,
      topicCount: topicNames.length,
      vectorDimension,
      semanticApplied,
      semanticMode,
      similarityAlpha,
      neighborSimilarityAlpha,
      latentTopicCoverage,
      latentDimensions: latentTopicSpace?.dimensions || 0,
      latentRetainedVariance: Number(
        keywordSimData?.topic_vectors?.retained_variance
      ) || 0,
      coverage,
      similarityCoverage,
      visibleSimilarityCoverage,
      semanticNeighborCoverage,
      visibleSemanticNeighborCoverage
    };
    return result;
  }

  function buildGraph(data, keywordSimData = null) {
    // Backwards compatibility if file still has old keys
    data.nodes.forEach(n => {
      if (n.value != null && n.val == null) n.val = n.value;
      if (!n.name) n.name = n.id;
      // Ensure type field exists for older data
      if (!n.type) n.type = 'author';
      if (n.type === 'author') {
        if (n.paper_count == null) n.paper_count = n.val || 1;
        if (n.first_author_count == null) n.first_author_count = 0;
        if (!Array.isArray(n.top_keywords)) n.top_keywords = [];
      }
    });

    // Hover highlight: build adjacency once (id -> Set(neighborIds))
    const adjacency = new Map();
    const addAdj = (a, b) => {
      if (!a || !b) return;
      if (!adjacency.has(a)) adjacency.set(a, new Set());
      adjacency.get(a).add(b);
    };
    (data.links || []).forEach(l => {
      const s = typeof l.source === 'object' ? l.source.id : l.source;
      const t = typeof l.target === 'object' ? l.target.id : l.target;
      addAdj(s, t);
      addAdj(t, s);
    });
    let hoveredNodeId = null;
    let pinnedNodeId = null; // keep focus during click/drag
    let lockedNodeId = null;

    // Shared dimming strength for both node fill + labels
    const DIM_ALPHA = 0.05;

    // Hover grow animation (nice, subtle)
    let hoverAnimT = 0;
    let hoverAnimTarget = 0;
    let hoverAnimRaf = 0;
    let hoverAnimLastTs = 0;

    const fadeColor = (color, alpha) => {
      if (!color) return color;
      const c = String(color).trim();

      // #rgb or #rrggbb
      if (c[0] === '#') {
        const hex = c.length === 4
          ? `${c[1]}${c[1]}${c[2]}${c[2]}${c[3]}${c[3]}`
          : c.slice(1);
        if (hex.length === 6) {
          const r = parseInt(hex.slice(0, 2), 16);
          const g = parseInt(hex.slice(2, 4), 16);
          const b = parseInt(hex.slice(4, 6), 16);
          return `rgba(${r},${g},${b},${alpha})`;
        }
      }

      // rgb(r,g,b)
      if (c.startsWith('rgb(')) {
        const inside = c.slice(4, -1);
        return `rgba(${inside},${alpha})`;
      }

      // rgba(r,g,b,a)
      if (c.startsWith('rgba(')) {
        const inside = c.slice(5, -1).split(',').slice(0, 3).join(',');
        return `rgba(${inside},${alpha})`;
      }

      return c;
    };

    const updateBackButtonVisibility = () => {
      if (!backButton) return;
      backButton.classList.toggle('is-visible', Boolean(lockedNodeId));
    };

    const getFocusNodeId = () => lockedNodeId || pinnedNodeId || hoveredNodeId;

    const requestGraphRedraw = (graphInstance) => {
      if (!graphInstance) return;
      if (typeof graphInstance.refresh === 'function') {
        graphInstance.refresh();
        return;
      }
      // Fallback: re-assign accessor to force a redraw
      graphInstance.nodeCanvasObject(graphInstance.nodeCanvasObject());
    };

    const startHoverAnimation = (graphInstance) => {
      if (hoverAnimRaf) return;
      const step = (ts) => {
        const dt = hoverAnimLastTs ? Math.min(64, ts - hoverAnimLastTs) : 16;
        hoverAnimLastTs = ts;

        // Smooth approach (critically damped-ish)
        const k = 1 - Math.exp(-dt / 110);
        hoverAnimT += (hoverAnimTarget - hoverAnimT) * k;

        requestGraphRedraw(graphInstance);

        if (Math.abs(hoverAnimTarget - hoverAnimT) < 0.002) {
          hoverAnimT = hoverAnimTarget;
          hoverAnimLastTs = 0;
          hoverAnimRaf = 0;
          requestGraphRedraw(graphInstance);
          return;
        }
        hoverAnimRaf = requestAnimationFrame(step);
      };
      hoverAnimRaf = requestAnimationFrame(step);
    };

    const getNodeBaseColor = (n) => {
      if (!n) return '#ffffff';
      if (n.type === 'keyword') {
        return '#f1f0ec';
      }
      if (n.id === COLLABO_FEATURED_AUTHOR_ID) {
        return COLLABO_FEATURED_AUTHOR_COLOR;
      }
      return authorColors.get(n.id) || 'rgb(128, 128, 128)';
    };

    const getLinkEndpointId = (endpoint) => (typeof endpoint === 'object' ? endpoint.id : endpoint);
    const isLinkConnectedToFocus = (link) => {
      const focusId = getFocusNodeId();
      if (!focusId || !link) return false;
      const s = getLinkEndpointId(link.source);
      const t = getLinkEndpointId(link.target);
      return s === focusId || t === focusId;
    };

    const isConnectedToHovered = (node) => {
      const focusId = getFocusNodeId();
      if (!focusId) return true;
      if (!node) return false;
      const id = node.id;
      if (id === focusId) return true;
      return adjacency.get(focusId)?.has(id) || false;
    };

    const applyLockedFocus = (nodeId) => {
      lockedNodeId = nodeId || null;
      updateBackButtonVisibility();
      g.nodeColor(g.nodeColor());
      g.linkColor(g.linkColor());
      requestGraphRedraw(g);
    };

    // Separate author and keyword nodes for sizing
    const authorNodes = data.nodes.filter(n => n.type === 'author');
    const keywordNodes = data.nodes.filter(n => n.type === 'keyword');
    
    const getPaperCount = node => Math.max(1, Number(node.paper_count ?? node.val) || 1);
    const maxAuthorPapers = Math.max(...authorNodes.map(getPaperCount), 1);
    
    // Top authors (limit 6 like before)
    const topSet = new Set([...authorNodes].sort((a,b)=> getPaperCount(b)-getPaperCount(a)).slice(0,6).map(n=>n.id));

    // The most prolific author keeps the larger star treatment.
    const largestAuthor = authorNodes.find(n => getPaperCount(n) === maxAuthorPapers);

    const graphVocabularyHash = data.meta?.topic_vocabulary_hash;
    const similarityVocabularyHash = keywordSimData?.vocabulary_hash;
    const similarityVocabularyMatches = !graphVocabularyHash
      || !similarityVocabularyHash
      || graphVocabularyHash === similarityVocabularyHash;
    if (!similarityVocabularyMatches) {
      console.warn('Collaboration PCA skipped stale keyword similarities.');
    }

    const authorColors = createPcaAuthorColors(
      authorNodes,
      keywordNodes,
      data.links,
      similarityVocabularyMatches ? keywordSimData : null
    );
    const pcaRgbById = authorColors.meta?.rgbById || new Map();
    // Preserve the analytical PCA colors for links. If the featured white
    // presentation color participates in screen blending, every hub spoke
    // becomes white and washes out the surrounding colors.
    const additiveLinkRgbById = new Map(
      [...pcaRgbById].map(([id, rgb]) => [id, Array.from(rgb)])
    );
    const featuredAuthor = authorNodes.find(node => node.id === COLLABO_FEATURED_AUTHOR_ID);
    if (featuredAuthor) {
      const featuredRgb = COLLABO_FEATURED_AUTHOR_RGB.slice();
      authorColors.set(COLLABO_FEATURED_AUTHOR_ID, COLLABO_FEATURED_AUTHOR_COLOR);
      pcaRgbById.set(COLLABO_FEATURED_AUTHOR_ID, featuredRgb);
      featuredAuthor.pcaRgb = featuredRgb.slice();
      featuredAuthor.pcaColor = COLLABO_FEATURED_AUTHOR_COLOR;
    }
    const getAdditiveLinkColor = link => {
      const sourceRgb = additiveLinkRgbById.get(getLinkEndpointId(link.source));
      const targetRgb = additiveLinkRgbById.get(getLinkEndpointId(link.target));
      const endpoints = [sourceRgb, targetRgb].filter(Boolean);
      if (!endpoints.length) return 'rgb(185, 214, 240)';
      // Screen blending models additive light: combined channels move toward 255.
      const mixed = [0, 1, 2].map(channel => Math.round(
        255 * (1 - endpoints.reduce(
          (remaining, rgb) => remaining * (1 - rgb[channel] / 255),
          1
        ))
      ));
      return `rgb(${mixed[0]}, ${mixed[1]}, ${mixed[2]})`;
    };
    const topicLinkDash = [2, 3];
    const getAuthorVisualValue = node => {
      const paperCount = getPaperCount(node);
      // Avoid compressing the paper-count signal through two square roots.
      // Small authors retain a visible floor while prolific authors separate
      // much more clearly in both body radius and stellar rays.
      const scaledValue = 0.2 + 0.2 * Math.pow(paperCount, 0.72);
      return node.id === largestAuthor?.id
        ? scaledValue * 1.6
        : scaledValue;
    };

    const g = ForceGraph()(container)
      .graphData(data)
      .backgroundColor('rgba(0,0,0,0)')
      // The galaxy lives in onRenderFramePre, so rendering must continue after
      // the force engine cools down or the background stars disappear.
      .autoPauseRedraw(false)
      .onRenderFramePre(ctx => {
        galaxyPainter.draw(ctx, performance.now());
      })
      .nodeId('id')
      .nodeLabel(n => {
        const displayName = n.name || n.id.replace(/^kw:/, '');
        const escapedName = htmlEscape(displayName);
        
        if (n.type === 'keyword') {
          const paperCount = Number(n.paper_count ?? n.val) || 0;
          const authorCount = Number(n.author_count) || 0;
          return `<div class="collabo-node-tooltip"><div style="color:#f1f0ec;font-size:12px;">◇ KEYWORD</div><div><strong>${escapedName}</strong></div><div class="collabo-tooltip-meta">${paperCount} papers${authorCount ? ` · ${authorCount} researchers` : ''}</div></div>`;
        }
        
        const photo = getNodePhoto(n.name);
        const photoMarkup = photo ? `<img class="collabo-node-photo-img" src="${photo}" alt="${escapedName}" loading="lazy"/>` : '';
        const authorColor = getNodeBaseColor(n);
        const pcaRgb = pcaRgbById.get(n.id) || [128, 128, 128];
        const researchColorLabel = `Research Color · RGB(${pcaRgb.join(', ')})`;
        const topicMarkup = (n.top_keywords || [])
          .slice(0, 3)
          .map(topic => `<span class="collabo-topic-chip">${htmlEscape(topic.name)}</span>`)
          .join('');
        const papers = getPaperCount(n);
        const leadPapers = Number(n.first_author_count) || 0;
        const collaborators = Number(n.coauthor_count) || 0;
        const activity = n.active_from
          ? (n.active_to && n.active_to !== n.active_from ? `${n.active_from}–${n.active_to}` : `${n.active_from}`)
          : '';
        return `<div class="collabo-node-tooltip">${photoMarkup}<div style="color:${authorColor} !important;"><strong style="color:${authorColor} !important;">${escapedName}</strong></div><div class="collabo-tooltip-theme" style="color:${authorColor} !important;">${researchColorLabel}</div>${topicMarkup ? `<div class="collabo-tooltip-topics">${topicMarkup}</div>` : ''}<div class="collabo-tooltip-meta">${papers} papers · ${leadPapers} lead · ${collaborators} coauthors${activity ? ` · ${activity}` : ''}</div></div>`;
      })
      .nodeVal(n => {
        if (n.type === 'keyword') {
          return 0.1 + Math.sqrt(n.paper_count || n.val || 1) * 0.15;
        }
        return getAuthorVisualValue(n);
      })
      .linkWidth(l => l.type === 'coauthor'
        ? 0.35 + 0.2 * Math.sqrt(l.value || 1)
        : 0.2 + 0.1 * Math.sqrt(l.paper_count || l.value || 1))
      .linkLineDash(l => l.type === 'author_keyword' ? topicLinkDash : null)
      .linkColor(l => {
        // Brighten edges connected to the focused node (hover or drag)
        if (l && l.__highlight) return 'rgba(255,255,255,0.55)';
        const focusId = getFocusNodeId();
        const isCoauthor = l.type === 'coauthor';
        if (!focusId) {
          if (!isCoauthor) return 'rgba(255,255,255,0.035)';
          return fadeColor(getAdditiveLinkColor(l), 0.1);
        }
        if (isLinkConnectedToFocus(l)) {
          if (!isCoauthor) return 'rgba(255,255,255,0.25)';
          return fadeColor(getAdditiveLinkColor(l), 0.42);
        }
        return isCoauthor
          ? 'rgba(185,214,240,0.014)'
          : 'rgba(255,255,255,0.008)';
      })
      .nodeColor(n => {
        const isConnected = isConnectedToHovered(n);
        const base = getNodeBaseColor(n);
        return isConnected ? base : fadeColor(base, DIM_ALPHA);
      })
      // Keep the PCA-colored author body, then add a lightweight stellar
      // core. Keywords remain a separate diamond-shaped visual language.
      .nodeCanvasObjectMode(node => node.type === 'keyword' ? 'replace' : 'after')
      .nodeCanvasObject((node, ctx, globalScale) => {
        // Without the old cluster layout, d3 assigns initial coordinates on its
        // first simulation tick. Skip the pre-tick paint instead of passing
        // undefined coordinates into Canvas gradients and stopping the RAF loop.
        if (!Number.isFinite(node.x) || !Number.isFinite(node.y)) return;
        const renderScale = Number.isFinite(globalScale) && globalScale > 0
          ? globalScale
          : 1;
        const isConnected = isConnectedToHovered(node);
        const baseColor = getNodeBaseColor(node);

        if (node.type === 'keyword') {
          const keywordSize = 2.2 + Math.sqrt(node.paper_count || node.val || 1) * 0.34;
          ctx.save();
          ctx.translate(node.x, node.y);
          ctx.rotate(Math.PI / 4);
          ctx.fillStyle = isConnected ? baseColor : fadeColor(baseColor, DIM_ALPHA);
          ctx.fillRect(-keywordSize / 2, -keywordSize / 2, keywordSize, keywordSize);
          ctx.restore();

          return;
        }

        const nodeRgb = pcaRgbById.get(node.id) || [128, 128, 128];
        const luminousColor = `rgb(${nodeRgb.map(channel => Math.round(
          channel + (255 - channel) * 0.22
        )).join(', ')})`;
        const visualRadius = Math.sqrt(getAuthorVisualValue(node)) * 4;
        const isTop = topSet.has(node.id);
        const isHub = node.id === largestAuthor?.id;
        const isHovered = hoveredNodeId === node.id;
        const brightness = isConnected ? 1 : DIM_ALPHA;
        const hoverBoost = isHovered ? 1 + 0.24 * hoverAnimT : 1;

        // Bloom is intentionally limited to major/hovered stars. The galaxy
        // already has hundreds of gradients, so this keeps animation smooth.
        if (isTop || isHub || isHovered) {
          const glowRadius = visualRadius * (isHub ? 2.7 : 2.15) * hoverBoost;
          const glow = ctx.createRadialGradient(
            node.x,
            node.y,
            visualRadius * 0.72,
            node.x,
            node.y,
            glowRadius
          );
          glow.addColorStop(0, fadeColor(baseColor, 0));
          glow.addColorStop(0.22, fadeColor(baseColor, 0.2 * brightness));
          glow.addColorStop(0.58, fadeColor(baseColor, 0.08 * brightness));
          glow.addColorStop(1, fadeColor(baseColor, 0));
          ctx.save();
          ctx.globalCompositeOperation = 'lighter';
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(node.x, node.y, glowRadius, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        // Keep every researcher visibly star-shaped even after zoom-to-fit.
        // Major authors retain longer rays, while ordinary authors get a
        // screen-space minimum so their star does not collapse into a dark dot.
        const isMajorStar = isTop || isHub || isHovered;
        const flarePixels = isHub ? 10 : isTop ? 5.5 : isHovered ? 3 : 1.4;
        const flareLength = (visualRadius + flarePixels / renderScale) * hoverBoost;
        const horizontalFlareLength = flareLength * (isMajorStar ? 0.72 : 0.58);
        ctx.save();
        ctx.globalCompositeOperation = 'lighter';
        ctx.strokeStyle = fadeColor(
          luminousColor,
          (isHub ? 0.58 : isMajorStar ? 0.4 : 0.28) * brightness
        );
        ctx.lineWidth = (isMajorStar ? 0.62 : 0.5) / renderScale;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(node.x, node.y - flareLength);
        ctx.lineTo(node.x, node.y + flareLength);
        ctx.moveTo(node.x - horizontalFlareLength, node.y);
        ctx.lineTo(node.x + horizontalFlareLength, node.y);
        ctx.stroke();
        ctx.restore();

        // A crisp PCA-colored pinpoint keeps the stellar shape without laying
        // a white center over darker purple/blue author colors.
        const coreRadius = Math.max(
          0.72 / renderScale,
          Math.min(visualRadius * 0.28, 1.15 / renderScale)
        );
        ctx.save();
        ctx.beginPath();
        ctx.arc(node.x, node.y, coreRadius, 0, Math.PI * 2);
        ctx.fillStyle = fadeColor(luminousColor, 0.92 * brightness);
        ctx.fill();
        ctx.restore();

      })
      .onNodeClick(node => {
        // Center on clicked node
        g.centerAt(node.x, node.y, 1000);
        g.zoom(2, 1000);
        
        // For keywords, search by the keyword name; for authors, search by first name
        if (node.type === 'keyword') {
          const keywordName = node.name || node.id.replace(/^kw:/, '');
          setBibSearchValue(keywordName);
        } else {
          setBibSearchValue(extractFirstName(node.id));
        }
        flashLinks(node, g);
      })
      .onNodeHover(node => {
        const prevId = hoveredNodeId;
        const nextId = node ? node.id : null;
        if (hoveredNodeId !== nextId) {
          hoveredNodeId = nextId;
          // Restart hover grow when switching nodes
          if (nextId && nextId !== prevId) hoverAnimT = 0;
          hoverAnimTarget = nextId ? 1 : 0;
          startHoverAnimation(g);
          // Re-evaluate colors
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
        container.style.cursor = node ? 'pointer':'default';
      })
      .onNodeDrag(node => {
        // While dragging, keep focus pinned so non-neighbors stay dim
        const nextId = node ? node.id : null;
        if (pinnedNodeId !== nextId) {
          pinnedNodeId = nextId;
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
      })
      .onNodeDragEnd(node => {
        // Clear pin after drag so dimming doesn't stick
        if (pinnedNodeId !== null) {
          pinnedNodeId = null;
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
      })
      .enableZoomInteraction(true)
      .enablePanInteraction(true)
      .minZoom(0.3)
      .maxZoom(8);

    if (typeof g.d3Force === 'function') {
      const graphLinkForce = g.d3Force('link');
      if (graphLinkForce?.distance && graphLinkForce?.strength) {
        graphLinkForce
          .distance(link => link.type === 'author_keyword' ? 27 : 48)
          .strength(link => link.type === 'author_keyword' ? 0.026 : 0.035);
      }
      if (typeof g.d3ReheatSimulation === 'function') g.d3ReheatSimulation();
    }

    const onDoubleClick = () => {
      if (!hoveredNodeId) return;
      applyLockedFocus(hoveredNodeId);
    };

    container.addEventListener('dblclick', onDoubleClick);
    if (backButton) {
      backButton.addEventListener('click', () => {
        hoveredNodeId = null;
        pinnedNodeId = null;
        hoverAnimTarget = 0;
        applyLockedFocus(null);
        startHoverAnimation(g);
        container.style.cursor = 'default';
      });
    }

    function flashLinks(node, gInstance) {
      const related = new Set();
      gInstance.graphData().links.forEach(l => {
        if (l.source.id === node.id || l.target.id === node.id) related.add(l);
      });
      related.forEach(l => { l.__highlight = true; });
      gInstance.linkColor(gInstance.linkColor());
      setTimeout(() => {
        related.forEach(l => { l.__highlight = false; });
        gInstance.linkColor(gInstance.linkColor());
      }, 1300);
    }

    // Initial sizing
    resizeCanvas(g);
    window.addEventListener('resize', () => resizeCanvas(g));

    // Remove loader
    const loader = document.getElementById('coauthor-graph-loader');
    if (loader) loader.remove();

    // Fit once during warmup and again after the force layout settles.
    // Once the visitor pans, zooms or selects a node, never override their view.
    let viewportInteracted = false;
    const markViewportInteraction = () => {
      viewportInteracted = true;
    };
    container.addEventListener('pointerdown', markViewportInteraction, { passive: true });
    container.addEventListener('wheel', markViewportInteraction, { passive: true });
    const autoFitView = () => {
      if (!viewportInteracted) {
        // Fit to people so rare shared keywords do not make the researcher map
        // too small in the viewport.
        g.zoomToFit(800, 72, node => node.type === 'author');
      }
    };
    const warmupFitTimerId = window.setTimeout(autoFitView, 1400);
    const settledFitTimerId = window.setTimeout(autoFitView, 4200);
    if (typeof g.onEngineStop === 'function') g.onEngineStop(autoFitView);

    window.addEventListener('pagehide', () => {
      window.clearTimeout(warmupFitTimerId);
      window.clearTimeout(settledFitTimerId);
      container.removeEventListener('dblclick', onDoubleClick);
      container.removeEventListener('pointerdown', markViewportInteraction);
      container.removeEventListener('wheel', markViewportInteraction);
      galaxyPainter.destroy();
    }, { once: true });

  }

  Promise.all([
    fetch('/assets/json/collabo_graph.json').then(r => r.json()),
    fetch('/assets/json/keyword_similarity.json')
      .then(r => r.ok ? r.json() : null)
      .catch(() => null)
  ])
    .then(([data, keywordSimData]) => buildGraph(data, keywordSimData))
    .catch(err => {
      const loader = document.getElementById('coauthor-graph-loader');
      if (loader) loader.textContent = 'Failed to load graph data.';
      console.error('Graph load error', err);
    });
})();
</script>
