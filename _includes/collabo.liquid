<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600&display=swap">
<style>
  .collabo-section,
  .collabo-section * {
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.02em;
  }
  .collabo-legend,
  .collabo-node-tooltip,
  .collabo-node-tooltip *,
  #coauthor-graph-loader {
    color: #ffffff !important;
  }
  .collabo-node-tooltip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    font-size: 15px;
    line-height: 1.3;
    min-width: 180px;
    max-width: 280px;
  }
  .collabo-tooltip-theme {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .collabo-tooltip-topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    max-width: 260px;
  }
  .collabo-topic-chip {
    display: inline-block;
    max-width: 150px;
    padding: 0.14rem 0.38rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: #ffffff !important;
    font-size: 0.62rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .collabo-tooltip-meta {
    color: rgba(255, 255, 255, 0.72) !important;
    font-size: 0.68rem;
  }
  .collabo-node-photo-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.75);
    background: #0b0f1c;
  }
  #coauthor-graph-loader {
    font-weight: 400;
    text-transform: uppercase;
  }
  #coauthor-graph-wrapper {
    box-sizing: border-box;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  #coauthor-graph {
    border-radius: clamp(14px, 2vw, 20px);
  }
  .collabo-overflow-glass,
  .collabo-overflow-frost {
    display: none;
  }
  .publications-page {
    position: relative;
    isolation: isolate;
    --publication-glass: color-mix(in srgb, var(--global-bg-color) 62%, transparent);
    --publication-glass-border: rgba(255, 255, 255, 0.6);
    --publication-glass-shadow: rgba(34, 45, 64, 0.08);
    --collabo-clear-top: 0px;
    --collabo-clear-bottom: 100vh;
    --collabo-clear-left: 0px;
    --collabo-clear-right: 100vw;
  }
  html[data-theme="dark"] .publications-page {
    --publication-glass-border: rgba(202, 218, 240, 0.14);
    --publication-glass-shadow: rgba(0, 0, 0, 0.16);
  }
  .publications-page .collabo-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }
  .publications-page #coauthor-graph {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 0;
    background: transparent;
    /* Fade the canvas itself so the sibling frost can still sample its pixels. */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 96px, #000 calc(100% - 96px), transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 96px, #000 calc(100% - 96px), transparent);
  }
  .publications-page .collabo-viewport {
    height: 520px;
  }
  /* One feathered layer avoids visible seams between the clear map and its
     blurred overflow. Its transparent backdrop keeps the page color intact. */
  .publications-page .collabo-overflow-frost {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    /* Keep arithmetic out of this custom property: the production CSS
       minifier strips required whitespace around calc() additions. */
    --collabo-frost-mask:
      linear-gradient(to bottom, #000 var(--collabo-frost-top), transparent var(--collabo-clear-top), transparent var(--collabo-clear-bottom), #000 var(--collabo-frost-bottom)),
      linear-gradient(to right, #000 var(--collabo-frost-left), transparent var(--collabo-clear-left), transparent var(--collabo-clear-right), #000 var(--collabo-frost-right));
    -webkit-mask-image: var(--collabo-frost-mask);
    mask-image: var(--collabo-frost-mask);
    -webkit-mask-composite: source-over;
    mask-composite: add;
  }
  /* Invisible hit areas let the page scroll outside the interactive map. */
  .publications-page .collabo-overflow-glass {
    display: block;
    position: absolute;
    z-index: 2;
    pointer-events: auto;
  }
  .collabo-overflow-glass.top {
    inset: 0 0 auto;
    height: var(--collabo-clear-top);
  }
  .collabo-overflow-glass.bottom {
    inset: var(--collabo-clear-bottom) 0 0;
  }
  .collabo-overflow-glass.left {
    top: var(--collabo-clear-top);
    bottom: calc(100% - var(--collabo-clear-bottom));
    left: 0;
    width: var(--collabo-clear-left);
  }
  .collabo-overflow-glass.right {
    top: var(--collabo-clear-top);
    bottom: calc(100% - var(--collabo-clear-bottom));
    right: 0;
    width: calc(100% - var(--collabo-clear-right));
  }
  .publications-page > .post-header,
  .publications-page .collabo-toolbar,
  .publications-page .collabo-footer,
  .publications-page .collabo-stats,
  .publications-page .publications-reading-pane {
    position: relative;
    z-index: 2;
    padding: 1.2rem 1.5rem;
    border: 1px solid var(--publication-glass-border);
    border-radius: 18px;
    background: var(--publication-glass);
    box-shadow: 0 10px 32px var(--publication-glass-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }
  .publications-page > .post-header {
    margin-bottom: 1.4rem;
  }
  .publications-page .post-description {
    margin-bottom: 0;
  }
  .publications-page .collabo-toolbar,
  .publications-page .collabo-footer {
    padding: 0.75rem 1rem;
    border-radius: 12px;
  }
  .publications-page .collabo-stats {
    margin-bottom: 1.5rem;
  }
  .publications-page .pub-stats-container,
  .publications-page .pub-stats-row {
    margin-block: 0;
  }
  .publications-page .pub-legend {
    max-width: 100%;
    min-width: 0;
  }
  .publications-page .publications-reading-pane {
    margin-bottom: 2rem;
    background: var(--global-bg-color, #f4f3f2);
    border-color: var(--global-divider-color);
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .publications-page .publications {
    margin-top: 1.5rem;
  }
  .publications-page .collabo-search,
  .publications-page .bibsearch-form-input {
    box-sizing: border-box;
    background: transparent;
    color: var(--global-text-color);
  }
  @media (max-width: 575.98px) {
    .publications-page > .post-header,
    .publications-page .collabo-stats,
    .publications-page .publications-reading-pane {
      padding: 1rem;
      border-radius: 14px;
    }
    .publications-page .collabo-viewport {
      height: 400px;
    }
    .publications-page .pub-legend {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
    .publications-page .pub-total-display {
      display: grid;
      grid-template-columns: max-content 1fr;
      align-items: baseline;
    }
  }
  .collabo-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding: 0.5rem 0;
  }
  .collabo-title {
    margin: 0;
    color: var(--global-text-color, #d5dce5);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .collabo-search {
    width: min(100%, 320px);
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(140, 157, 180, 0.3);
    border-radius: 8px;
    background: transparent;
    color: var(--global-text-color, #d5dce5);
    font-size: 0.78rem;
  }
  .collabo-search:focus-visible,
  .collabo-legend-item:focus-visible,
  .collabo-back-button:focus-visible {
    outline: 2px solid #86cfd4;
    outline-offset: 3px;
  }
  .collabo-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
  }
  .collabo-hint {
    color: var(--global-text-color-light, #8794a5);
    font-size: 0.68rem;
    margin: 0;
  }
  .collabo-legend {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0;
    background: transparent;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }
  .collabo-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--global-text-color-light, #a6b1bf);
    background: transparent;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
  }
  .collabo-legend-item[aria-pressed="false"] {
    opacity: 0.4;
    text-decoration: line-through;
  }
  .collabo-legend-dot {
    width: 9px;
    height: 9px;
    display: inline-block;
    border-radius: 50%;
  }
  .collabo-legend-dot.author {
    width: 15px;
    height: 15px;
    background: #8bc9ee;

  }
  .collabo-legend-dot.paper {
    background: #a3abb5;
  }
  .collabo-legend-dot.keyword {
    width: 14px;
    height: 9px;
    border: 1px solid #b0a0e8;
    background: radial-gradient(circle, #85dfd0 0 25%, transparent 35%);
    transform: rotate(-30deg);
  }
  .node-label {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    text-shadow: 0 0 4px rgba(0,0,0,0.8), 0 0 8px rgba(0,0,0,0.6);
  }
  .collabo-back-button {
    position: absolute;
    top: 19px;
    right: 19px;
    z-index: 1001;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 28px;
    padding: 0 0.7rem;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px;
    background: rgba(2, 6, 17, 0.9);
    color: #ffffff;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 160ms ease, transform 160ms ease, background 160ms ease;
  }
  .collabo-back-button:hover {
    background: rgba(18, 36, 70, 0.95);
    transform: translateY(-1px);
  }
  .collabo-back-button.is-visible {
    display: inline-flex;
  }
  @media (max-width: 575.98px) {
    #coauthor-graph-wrapper {
      padding: 0;
      border-radius: 18px;
    }
    #coauthor-graph {
      border-radius: 14px;
    }
    .collabo-back-button {
      top: 15px;
      right: 15px;
      min-width: 46px;
      padding-inline: 0.55rem;
    }
  }
</style>
<div class="collabo-section" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: stretch;">
  <div id="coauthor-graph-wrapper" style="position: relative;">
    <div class="collabo-toolbar">
      <h3 class="collabo-title">Research Constellation</h3>
      <input id="collabo-search" class="collabo-search" type="search" placeholder="Find a paper, author or topic…" aria-label="Find a paper, author or topic" autocomplete="off">
    </div>
    <div class="collabo-viewport" style="position: relative;">
      <div class="collabo-backdrop">
        <div id="coauthor-graph" aria-label="Slowly rotating 3D research map: papers are dim white dots; author circles and topic crystals are sized by their related paper counts.">
          <div id="coauthor-graph-loader" style="position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;color:#ffffff;font-size:.85rem;font-family:system-ui,Segoe UI,sans-serif;letter-spacing:.5px;">Loading Collaboration Graph…</div>
        </div>
        <div class="collabo-overflow-frost" aria-hidden="true"></div>
        <div class="collabo-overflow-glass top" aria-hidden="true"></div>
        <div class="collabo-overflow-glass bottom" aria-hidden="true"></div>
        <div class="collabo-overflow-glass left" aria-hidden="true"></div>
        <div class="collabo-overflow-glass right" aria-hidden="true"></div>
      </div>
      <button id="collabo-back-button" class="collabo-back-button" type="button" aria-label="Reset research map and filters">Reset view</button>
    </div>
    <div class="collabo-footer">
      <div class="collabo-legend" role="group" aria-label="Visible node types">
        <button class="collabo-legend-item" type="button" data-collabo-layer="paper" aria-pressed="true"><span class="collabo-legend-dot paper" aria-hidden="true"></span>Papers <span data-collabo-count="paper"></span></button>
        <button class="collabo-legend-item" type="button" data-collabo-layer="author" aria-pressed="true"><span class="collabo-legend-dot author" aria-hidden="true"></span>Authors <span data-collabo-count="author"></span></button>
        <button class="collabo-legend-item" type="button" data-collabo-layer="keyword" aria-pressed="true"><span class="collabo-legend-dot keyword" aria-hidden="true"></span>Topics <span data-collabo-count="keyword"></span></button>
      </div>
      <p id="collabo-status" class="collabo-hint" role="status" aria-live="polite">Size = related papers · Drag to rotate · Scroll to zoom</p>
    </div>
  </div>
  <div class="collabo-stats" style="margin-top: .25rem;">
    {% include pub_stats.liquid %}
  </div>
  <div id="coauthor-table" style="width: 100%;"></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/3d-force-graph@1.80.0/dist/3d-force-graph.min.js"></script>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.179.1/build/three.module.js';

{% assign firstPhoto = true %}
const COLLABO_PHOTOS = {
{% for person in site.people %}
  {% if person.img %}
    {% unless firstPhoto %},{% endunless %}
    "{{ person.title | split:'(' | first | strip | replace:'"','\\"' }}": "{{ person.img | strip }}"
    {% assign firstPhoto = false %}
  {% endif %}
{% endfor %}
};
const COLLABO_DEFAULT_PHOTO = '/assets/img/BAELAB_LOGO.png';
const COLLABO_RESEARCH_REFERENCE_AUTHOR_ID = 'Bae, Hyerim';

(() => {
  const container = document.getElementById('coauthor-graph');
  const backButton = document.getElementById('collabo-back-button');
  if (!container) return;
  const pageRoot = container.closest('.publications-page');
  const viewport = container.closest('.collabo-viewport');
  const backdrop = container.closest('.collabo-backdrop');

  const updateSceneLayout = () => {
    if (!pageRoot || !viewport) return;
    const clearHeight = computeMapHeight(viewport.clientWidth || 800);
    viewport.style.height = `${clearHeight}px`;
    const rect = viewport.getBoundingClientRect();
    const width = document.documentElement.clientWidth;
    const bleed = Math.max(260, Math.round(window.innerHeight * 0.45));
    // Anchor the scene to the document. Extra canvas above and below the map
    // keeps zoomed nodes visible outside the original clear opening.
    backdrop.style.left = `${-rect.left}px`;
    backdrop.style.top = `${-bleed}px`;
    backdrop.style.width = `${width}px`;
    backdrop.style.height = `${clearHeight + bleed * 2}px`;
    backdrop.style.setProperty('--collabo-clear-top', `${bleed}px`);
    backdrop.style.setProperty('--collabo-clear-bottom', `${bleed + clearHeight}px`);
    backdrop.style.setProperty('--collabo-clear-left', `${rect.left}px`);
    backdrop.style.setProperty('--collabo-clear-right', `${rect.right}px`);
    const featherX = Math.max(1, Math.min(48, rect.left, width - rect.right));
    backdrop.style.setProperty('--collabo-frost-top', `${bleed - 64}px`);
    backdrop.style.setProperty('--collabo-frost-bottom', `${bleed + clearHeight + 64}px`);
    backdrop.style.setProperty('--collabo-frost-left', `${rect.left - featherX}px`);
    backdrop.style.setProperty('--collabo-frost-right', `${rect.right + featherX}px`);
  };
  updateSceneLayout();

  const htmlEscape = (str = '') => str.replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);

  function buildNameVariants(rawName = '') {
    const variants = new Set();
    const base = rawName.trim();
    if (!base) return [];
    variants.add(base);
    variants.add(base.replace(/\s+/g, ' '));

    if (base.includes(',')) {
      const [lastPart, ...rest] = base.split(',');
      const last = lastPart.trim();
      const first = rest.join(',').trim();
      if (first && last) {
        variants.add(`${first} ${last}`.trim());
        variants.add(`${last} ${first}`.trim());
      }
    } else {
      const tokens = base.split(/\s+/);
      if (tokens.length >= 2) {
        const last = tokens[tokens.length - 1];
        const first = tokens.slice(0, -1).join(' ');
        variants.add(`${last}, ${first}`.trim());
        variants.add(`${first} ${last}`.trim());
      }
    }

    variants.add(base.replace(/[.,]/g, '').trim());
    return [...variants].filter(Boolean);
  }

  function getNodePhoto(name) {
    const variants = buildNameVariants(name);
    for (const candidate of variants) {
      if (COLLABO_PHOTOS[candidate]) return COLLABO_PHOTOS[candidate];
    }
    return null;
  }

  function extractFirstName(name) {
    if (name.includes(',')) {
      const parts = name.split(',');
      return parts[1] ? parts[1].trim() : '';
    }
    if (/^[가-힣]{2,}$/.test(name)) return name.slice(-2);
    if (/^[A-Za-z ]+$/.test(name.trim())) return name.trim().split(/\s+/)[0];
    return name;
  }
  function setBibSearchValue(value, retries = 6) {
    const searchBox = document.getElementById('bibsearch');
    if (searchBox) {
      searchBox.value = value;
      searchBox.dispatchEvent(new Event('input', { bubbles: true }));
      searchBox.focus({ preventScroll: true });
    } else if (retries > 0) {
      setTimeout(() => setBibSearchValue(value, retries - 1), 250);
    }
  }

  function computeMapHeight(width) {
    if (width < 576) return Math.max(Math.round(width), 400);
    return Math.max(Math.round(width * 9 / 16), 420);
  }
  // Extend the renderer beyond the clear map without attaching it to scrolling.
  function computeHeight() {
    return pageRoot ? backdrop.clientHeight : computeMapHeight(container.clientWidth || 800);
  }
  function resizeCanvas(graphInstance) {
    const h = computeHeight();
    container.style.height = h + 'px';
    graphInstance && graphInstance.height(h).width(container.clientWidth || 800);
  }

  // Project complete author topic profiles relative to one reference researcher.
  // Rare topics hidden from the graph remain part of the color representation.
  function createPcaAuthorColors(
    authorNodes,
    keywordNodes,
    links,
    keywordSimData = null,
    referenceAuthorId = null
  ) {
    const similarityPayload = keywordSimData && (keywordSimData.similarities || keywordSimData);
    const vectorizerConfig = keywordSimData?.vectorizer || {};
    const finiteConfig = (value, fallback, minimum, maximum) => {
      const numericValue = Number(value);
      return Number.isFinite(numericValue)
        ? Math.max(minimum, Math.min(maximum, numericValue))
        : fallback;
    };
    const finiteNonnegative = (value, fallback = 0) => {
      const numericValue = Number(value);
      return Number.isFinite(numericValue)
        ? Math.max(0, numericValue)
        : fallback;
    };
    const configuredSimilarityAlpha = Number(keywordSimData?.alpha);
    const similarityAlpha = Number.isFinite(configuredSimilarityAlpha)
      ? Math.max(0, Math.min(0.75, configuredSimilarityAlpha))
      : 0.35;
    const configuredNeighborAlpha = Number(keywordSimData?.neighbor_alpha);
    const neighborSimilarityAlpha = Number.isFinite(configuredNeighborAlpha)
      ? Math.max(0, Math.min(0.5, configuredNeighborAlpha))
      : Math.min(0.25, similarityAlpha);
    const bm25K1 = finiteConfig(vectorizerConfig.bm25_k1, 1.35, 0.1, 3);
    const bm25B = finiteConfig(vectorizerConfig.bm25_b, 0.35, 0, 1);
    const repeatEvidenceScale = finiteConfig(
      vectorizerConfig.repeat_evidence_scale,
      1.5,
      0.25,
      10
    );
    const configuredLeadAlpha = finiteConfig(
      vectorizerConfig.lead_alpha,
      0.3,
      0,
      0.3
    );
    const configuredRecencyAlpha = finiteConfig(
      vectorizerConfig.recency_alpha,
      0.1,
      0,
      0.25
    );
    const pcaMinimumPapers = Math.max(
      1,
      Math.floor(finiteConfig(vectorizerConfig.pca_min_papers, 1, 1, 20))
    );
    const decodeLatentTopicSpace = payload => {
      if (
        payload?.encoding !== 'int8-base64'
        || !Array.isArray(payload.ids)
        || !Array.isArray(payload.scales)
        || typeof payload.data !== 'string'
      ) {
        return null;
      }
      const dimensions = Math.max(0, Math.floor(Number(payload.dimensions) || 0));
      const uniqueIds = new Set(payload.ids);
      const validScales = payload.scales.every(scale => (
        Number.isFinite(Number(scale)) && Number(scale) > 0
      ));
      if (
        !dimensions
        || dimensions > 1024
        || payload.scales.length !== dimensions
        || uniqueIds.size !== payload.ids.length
        || payload.ids.some(id => typeof id !== 'string')
        || !validScales
      ) {
        return null;
      }

      let binary;
      try {
        binary = atob(payload.data);
      } catch (error) {
        console.warn('Collaboration PCA ignored invalid latent topic data.', error);
        return null;
      }
      if (binary.length !== payload.ids.length * dimensions) return null;

      const vectorsById = new Map();
      payload.ids.forEach((id, rowIndex) => {
        const vector = new Float64Array(dimensions);
        for (let axis = 0; axis < dimensions; axis++) {
          const byte = binary.charCodeAt(rowIndex * dimensions + axis);
          const signedValue = byte > 127 ? byte - 256 : byte;
          const scale = Number(payload.scales[axis]);
          vector[axis] = signedValue * scale;
        }
        vectorsById.set(id, vector);
      });
      return { dimensions, vectorsById };
    };
    const latentTopicSpace = decodeLatentTopicSpace(keywordSimData?.topic_vectors);

    const featureNames = new Set(
      keywordNodes.map(node => node.name || node.id.replace(/^kw:/, ''))
    );
    authorNodes.forEach(author => {
      Object.keys(author.topic_profile || {}).forEach(topic => featureNames.add(topic));
    });

    const topicNames = [...featureNames].sort((a, b) => {
      const aKey = a.toLowerCase();
      const bKey = b.toLowerCase();
      if (aKey !== bKey) return aKey < bKey ? -1 : 1;
      return a < b ? -1 : a > b ? 1 : 0;
    });
    const topicIds = topicNames.map(topic => 'kw:' + topic);
    const topicIndex = new Map(topicIds.map((id, index) => [id, index]));
    const authorFeatures = new Map();
    const authorLeadFeatures = new Map();
    const authorRecentFeatures = new Map();
    const authorsWithFullProfiles = new Set();
    const authorsWithLeadProfiles = new Set();
    const authorsWithRecentProfiles = new Set();
    const orderedAuthors = [...authorNodes].sort(
      (a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0
    );

    orderedAuthors.forEach(author => {
      const readProfile = (profile, profileSet) => {
        const vector = new Array(topicNames.length).fill(0);
        if (profile && typeof profile === 'object' && !Array.isArray(profile)) {
          profileSet.add(author.id);
          Object.entries(profile).forEach(([topic, rawWeight]) => {
            const index = topicIndex.get('kw:' + topic);
            if (index !== undefined) {
              vector[index] = finiteNonnegative(rawWeight);
            }
          });
        }
        return vector;
      };
      authorFeatures.set(
        author.id,
        readProfile(author.topic_profile, authorsWithFullProfiles)
      );
      authorLeadFeatures.set(
        author.id,
        readProfile(author.lead_topic_profile, authorsWithLeadProfiles)
      );
      authorRecentFeatures.set(
        author.id,
        readProfile(author.recent_topic_profile, authorsWithRecentProfiles)
      );
    });

    // Compatibility path for older JSON that only has author-keyword links.
    links.forEach(link => {
      const sourceId = typeof link.source === 'object' ? link.source.id : link.source;
      const targetId = typeof link.target === 'object' ? link.target.id : link.target;
      let authorId;
      let keywordId;
      if (String(sourceId).startsWith('kw:')) {
        authorId = targetId;
        keywordId = sourceId;
      } else if (String(targetId).startsWith('kw:')) {
        authorId = sourceId;
        keywordId = targetId;
      } else {
        return;
      }
      if (!authorFeatures.has(authorId) || authorsWithFullProfiles.has(authorId)) return;
      const index = topicIndex.get(keywordId);
      if (index !== undefined) {
        const fallbackLinkWeight = link.value == null ? 1 : 0;
        authorFeatures.get(authorId)[index] += finiteNonnegative(
          link.value,
          fallbackLinkWeight
        );
      }
    });

    // Every author participates, including zero-topic rows.
    const authorIds = [...authorFeatures.keys()];
    const rawVectors = authorIds.map(authorId => authorFeatures.get(authorId));
    const rawLeadVectors = authorIds.map(authorId => authorLeadFeatures.get(authorId));
    const rawRecentVectors = authorIds.map(authorId => authorRecentFeatures.get(authorId));

    // Positive BM25 IDF gives genuinely rare topics more influence without the
    // old hard cap. Empty profiles are not research documents and cannot change
    // the corpus statistics, while each researcher with evidence counts once.
    const idfProfiles = rawVectors.filter(profile => (
      profile.some(value => value > 0)
    ));
    const idfDocumentCount = idfProfiles.length;
    const idfWeights = new Array(topicNames.length).fill(1);
    for (let featureIndex = 0; featureIndex < topicNames.length; featureIndex++) {
      let documentFrequency = 0;
      for (let profileIndex = 0; profileIndex < idfProfiles.length; profileIndex++) {
        if (idfProfiles[profileIndex][featureIndex] > 0) documentFrequency++;
      }
      idfWeights[featureIndex] = Math.log1p(
        (idfDocumentCount - documentFrequency + 0.5)
          / (documentFrequency + 0.5)
      );
    }

    const bm25WeightProfiles = profiles => {
      const profileLengths = profiles.map(profile => (
        profile.reduce((sum, value) => sum + value, 0)
      ));
      const nonEmptyLengths = profileLengths.filter(length => length > 0);
      const averageLength = nonEmptyLengths.length
        ? nonEmptyLengths.reduce((sum, length) => sum + length, 0)
          / nonEmptyLengths.length
        : 1;

      return profiles.map((profile, authorIndex) => {
        // A single very prolific author should not erase their low-frequency
        // topics. Cap only the length-normalization ratio, not the topic IDF.
        const lengthRatio = Math.min(4, profileLengths[authorIndex] / averageLength);
        const lengthPenalty = bm25K1 * (1 - bm25B + bm25B * lengthRatio);
        return profile.map((value, featureIndex) => {
          if (value <= 0) return 0;
          const saturatedFrequency = value * (bm25K1 + 1) / (value + lengthPenalty);
          return saturatedFrequency * idfWeights[featureIndex];
        });
      });
    };

    const directVectors = bm25WeightProfiles(rawVectors);
    const leadVectors = bm25WeightProfiles(rawLeadVectors);
    const recentVectors = bm25WeightProfiles(rawRecentVectors);

    // The semantic centroid uses the same author-specific evidence, but only a
    // square-root IDF. This removes generic lab vocabulary without letting a
    // one-off phrase or typo dominate an entire semantic direction.
    const semanticSourceVectors = rawVectors.map((rawVector, authorIndex) =>
      rawVector.map((value, featureIndex) => {
        if (value <= 0) return 0;
        const lengthWeightedValue = directVectors[authorIndex][featureIndex];
        const temperedIdf = Math.sqrt(Math.max(idfWeights[featureIndex], 1e-12));
        const repeatEvidence = Math.sqrt(
          1 - Math.exp(-value / repeatEvidenceScale)
        );
        return lengthWeightedValue * repeatEvidence / temperedIdf;
      })
    );
    let vectors = directVectors;

    // Prefer dense latent topic coordinates; otherwise build the legacy
    // symmetric, row-normalized neighbor channel as a compatibility fallback.
    const visibleTopicIds = keywordNodes.map(node => node.id);
    const similarityFloor = keywordSimData && Number.isFinite(Number(keywordSimData.threshold))
      ? Number(keywordSimData.threshold)
      : 0.7;
    const similarityCoverage = similarityPayload && topicIds.length
      ? topicIds.filter(id => Array.isArray(similarityPayload[id])).length / topicIds.length
      : 0;
    const visibleSimilarityCoverage = similarityPayload && visibleTopicIds.length
      ? visibleTopicIds.filter(id => Array.isArray(similarityPayload[id])).length
        / visibleTopicIds.length
      : 0;
    let semanticNeighborCoverage = 0;
    let visibleSemanticNeighborCoverage = 0;
    let semanticApplied = false;
    let semanticMode = 'direct';
    const latentTopicCoverage = latentTopicSpace && topicIds.length
      ? topicIds.filter(id => latentTopicSpace.vectorsById.has(id)).length / topicIds.length
      : 0;
    const hasUsableLatentTopicSpace = Boolean(
      latentTopicSpace && latentTopicCoverage >= 0.8
    );
    const normalizeChannel = channel => {
      const magnitude = Math.sqrt(
        channel.reduce((sum, value) => sum + value * value, 0)
      );
      if (!Number.isFinite(magnitude) || magnitude <= 1e-12) {
        return new Array(channel.length).fill(0);
      }
      return Array.from(channel, value => value / magnitude);
    };

    const leadProfileCoverage = authorsWithLeadProfiles.size / Math.max(1, authorIds.length);
    const recentProfileCoverage = authorsWithRecentProfiles.size
      / Math.max(1, authorIds.length);
    const leadChannelAvailable = leadProfileCoverage >= 0.8
      && rawLeadVectors.some(vector => vector.some(value => value > 0));
    const recentChannelAvailable = recentProfileCoverage >= 0.8
      && rawRecentVectors.some(vector => vector.some(value => value > 0));
    const requestedLeadAlpha = leadChannelAvailable ? configuredLeadAlpha : 0;
    const requestedRecencyAlpha = recentChannelAvailable ? configuredRecencyAlpha : 0;
    const requestedContextAlpha = requestedLeadAlpha + requestedRecencyAlpha;
    const contextAlphaScale = requestedContextAlpha > 0.4
      ? 0.4 / requestedContextAlpha
      : 1;
    const leadAlpha = requestedLeadAlpha * contextAlphaScale;
    const recencyAlpha = requestedRecencyAlpha * contextAlphaScale;
    const coreTopicAlpha = 1 - leadAlpha - recencyAlpha;

    const combineResearchChannels = (
      directVector,
      semanticVector,
      authorIndex,
      semanticWeight
    ) => {
      // Scaling normalized, non-empty blocks by sqrt(weight) makes their
      // squared energy match the configured 60/30/10 cosine contribution.
      const boundedSemanticWeight = semanticVector
        ? Math.max(0, Math.min(0.75, semanticWeight))
        : 0;
      const combined = normalizeChannel(directVector).map(
        value => value * Math.sqrt(coreTopicAlpha * (1 - boundedSemanticWeight))
      );
      if (semanticVector) {
        combined.push(...normalizeChannel(semanticVector).map(
          value => value * Math.sqrt(coreTopicAlpha * boundedSemanticWeight)
        ));
      }
      if (leadAlpha > 0) {
        combined.push(...normalizeChannel(leadVectors[authorIndex]).map(
          value => value * Math.sqrt(leadAlpha)
        ));
      }
      if (recencyAlpha > 0) {
        combined.push(...normalizeChannel(recentVectors[authorIndex]).map(
          value => value * Math.sqrt(recencyAlpha)
        ));
      }
      return combined;
    };

    // Topic-vector magnitudes are an SVD artifact. Normalize each row so a
    // phrase contributes according to author evidence, not projection length.
    const normalizedLatentVectorsById = new Map();
    latentTopicSpace?.vectorsById.forEach((topicVector, topicId) => {
      normalizedLatentVectorsById.set(topicId, normalizeChannel(topicVector));
    });
    vectors = directVectors.map((directVector, authorIndex) => (
      combineResearchChannels(directVector, null, authorIndex, 0)
    ));

    if (hasUsableLatentTopicSpace && similarityAlpha > 0) {
      vectors = directVectors.map((directVector, authorIndex) => {
        const semanticVector = new Float64Array(latentTopicSpace.dimensions);
        semanticSourceVectors[authorIndex].forEach((value, featureIndex) => {
          if (!value) return;
          const topicVector = normalizedLatentVectorsById.get(topicIds[featureIndex]);
          if (!topicVector) return;
          for (let axis = 0; axis < latentTopicSpace.dimensions; axis++) {
            semanticVector[axis] += value * topicVector[axis];
          }
        });
        return combineResearchChannels(
          directVector,
          semanticVector,
          authorIndex,
          similarityAlpha
        );
      });
      semanticApplied = true;
      semanticMode = 'latent-topic-pca';
    } else if (
      !hasUsableLatentTopicSpace
      && similarityPayload
      && neighborSimilarityAlpha > 0
      && visibleSimilarityCoverage >= 0.8
    ) {
      const semanticRows = Array.from({ length: topicNames.length }, () => new Map());
      Object.entries(similarityPayload).forEach(([sourceId, neighbors]) => {
        const sourceIndex = topicIndex.get(sourceId);
        if (sourceIndex === undefined || !Array.isArray(neighbors)) return;
        neighbors.forEach(pair => {
          if (!pair || pair.length < 2) return;
          const targetIndex = topicIndex.get(pair[0]);
          const similarity = Number(pair[1]);
          if (
            targetIndex === undefined
            || !Number.isFinite(similarity)
            || similarity <= 0
          ) {
            return;
          }
          const weight = Math.max(
            0,
            Math.min(1, (similarity - similarityFloor) / Math.max(1e-6, 1 - similarityFloor))
          );
          if (!weight) return;
          semanticRows[sourceIndex].set(
            targetIndex,
            Math.max(semanticRows[sourceIndex].get(targetIndex) || 0, weight)
          );
          semanticRows[targetIndex].set(
            sourceIndex,
            Math.max(semanticRows[targetIndex].get(sourceIndex) || 0, weight)
          );
        });
      });

      semanticNeighborCoverage = semanticRows.filter(row => row.size > 0).length
        / Math.max(1, semanticRows.length);
      visibleSemanticNeighborCoverage = visibleTopicIds.filter(id => {
        const index = topicIndex.get(id);
        return index !== undefined && semanticRows[index].size > 0;
      }).length / Math.max(1, visibleTopicIds.length);

      if (semanticNeighborCoverage > 0) {
        vectors = directVectors.map((directVector, authorIndex) => {
          const semanticVector = directVector.slice();
          directVector.forEach((value, sourceIndex) => {
            if (!value || !semanticRows[sourceIndex].size) return;
            const rowTotal = [...semanticRows[sourceIndex].values()]
              .reduce((sum, weight) => sum + weight, 0) || 1;
            semanticRows[sourceIndex].forEach((weight, targetIndex) => {
              semanticVector[targetIndex] += value * weight / rowTotal;
            });
          });
          return combineResearchChannels(
            directVector,
            semanticVector,
            authorIndex,
            neighborSimilarityAlpha
          );
        });
        semanticApplied = true;
        semanticMode = 'neighbor-diffusion';
      }
    }

    const normalize = vector => {
      const magnitude = Math.sqrt(
        vector.reduce((sum, value) => sum + value * value, 0)
      );
      if (!Number.isFinite(magnitude) || magnitude <= 1e-12) {
        return vector.map(() => 0);
      }
      return vector.map(value => value / magnitude);
    };
    vectors = vectors.map(normalize);

    // Fit the shared axes once per distinct, non-empty research profile. This
    // prevents a large coauthor list on one paper from counting the same topic
    // vector many times while retaining unique single-paper research signals.
    const vectorDimension = vectors[0]?.length || 0;
    const vectorEnergy = vector => vector.reduce(
      (sum, value) => sum + value * value,
      0
    );
    const selectUniqueFitIndices = minimumPapers => {
      const seenProfiles = new Set();
      const indices = [];
      vectors.forEach((vector, authorIndex) => {
        const paperCount = finiteNonnegative(
          orderedAuthors[authorIndex]?.paper_count
        );
        const energy = vectorEnergy(vector);
        if (
          paperCount < minimumPapers
          || !Number.isFinite(energy)
          || energy <= 1e-12
        ) return;
        const signature = JSON.stringify(vector);
        if (seenProfiles.has(signature)) return;
        seenProfiles.add(signature);
        indices.push(authorIndex);
      });
      return indices;
    };
    let fitAuthorIndices = selectUniqueFitIndices(pcaMinimumPapers);
    if (fitAuthorIndices.length < 4 && pcaMinimumPapers > 1) {
      fitAuthorIndices = selectUniqueFitIndices(1);
    }
    const fitVectors = fitAuthorIndices.map(authorIndex => vectors[authorIndex]);
    const requestedReferenceIndex = referenceAuthorId
      ? authorIds.indexOf(referenceAuthorId)
      : -1;
    const requestedReferenceEnergy = requestedReferenceIndex >= 0
      ? vectorEnergy(vectors[requestedReferenceIndex])
      : 0;
    const referenceApplied = requestedReferenceIndex >= 0
      && Number.isFinite(requestedReferenceEnergy)
      && requestedReferenceEnergy > 1e-12;
    const activeReferenceIndex = referenceApplied ? requestedReferenceIndex : -1;
    const activeReferenceAuthorId = referenceApplied ? referenceAuthorId : null;

    // Keep the globally fitted PCA axes so pairwise projected differences remain
    // intact. The reference is applied after projection as a coordinate shift
    // and as a whiteness anchor; using it as an uncentered PCA origin would spend
    // the leading component on professor-vs-cohort separation.
    const featureMeans = new Float64Array(vectorDimension);
    fitVectors.forEach(vector => {
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        featureMeans[featureIndex] += vector[featureIndex];
      }
    });
    if (fitVectors.length) {
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        featureMeans[featureIndex] /= fitVectors.length;
      }
    }

    const centeredRows = vectors.map(vector => {
      const centered = new Float64Array(vectorDimension);
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        centered[featureIndex] = vector[featureIndex] - featureMeans[featureIndex];
      }
      return centered;
    });
    const fitCenteredRows = fitAuthorIndices.map(authorIndex => (
      centeredRows[authorIndex]
    ));

    // Work in author space (X X^T). This is the deterministic dual form of the
    // NIPALS power step and avoids constructing a much larger feature covariance.
    const sampleCount = fitCenteredRows.length;
    const gram = Array.from(
      { length: sampleCount },
      () => new Float64Array(sampleCount)
    );
    let totalCenteredSumSquares = 0;
    for (let rowIndex = 0; rowIndex < sampleCount; rowIndex++) {
      for (let otherIndex = 0; otherIndex <= rowIndex; otherIndex++) {
        let value = 0;
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          value += fitCenteredRows[rowIndex][featureIndex]
            * fitCenteredRows[otherIndex][featureIndex];
        }
        gram[rowIndex][otherIndex] = value;
        gram[otherIndex][rowIndex] = value;
      }
      totalCenteredSumSquares += gram[rowIndex][rowIndex];
    }

    const rawScores = Array.from({ length: vectors.length }, () => [0, 0, 0]);
    const explainedVariance = [0, 0, 0];
    const componentVectors = [];
    const varianceDenominator = Math.max(1, sampleCount - 1);
    const varianceFloor = Math.max(
      Number.EPSILON,
      totalCenteredSumSquares * 1e-12
    );
    const componentLimit = Math.min(
      3,
      vectorDimension,
      Math.max(0, sampleCount - 1)
    );

    const removePreviousComponents = vector => {
      componentVectors.forEach(previous => {
        let projection = 0;
        for (let index = 0; index < sampleCount; index++) {
          projection += vector[index] * previous[index];
        }
        for (let index = 0; index < sampleCount; index++) {
          vector[index] -= projection * previous[index];
        }
      });
    };

    const normalizeInPlace = vector => {
      let normSquared = 0;
      for (let index = 0; index < vector.length; index++) {
        normSquared += vector[index] * vector[index];
      }
      if (normSquared <= varianceFloor || !Number.isFinite(normSquared)) return false;
      const inverseNorm = 1 / Math.sqrt(normSquared);
      for (let index = 0; index < vector.length; index++) {
        vector[index] *= inverseNorm;
      }
      return true;
    };

    for (let componentIndex = 0; componentIndex < componentLimit; componentIndex++) {
      // Use the highest-energy residual feature as a stable, data-derived seed.
      let eigenvector = null;
      let seedEnergy = 0;
      const candidate = new Float64Array(sampleCount);
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          candidate[authorIndex] = fitCenteredRows[authorIndex][featureIndex];
        }
        removePreviousComponents(candidate);
        let energy = 0;
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          energy += candidate[authorIndex] * candidate[authorIndex];
        }
        if (energy > seedEnergy) {
          seedEnergy = energy;
          eigenvector = Float64Array.from(candidate);
        }
      }
      if (!eigenvector || seedEnergy <= varianceFloor || !normalizeInPlace(eigenvector)) {
        break;
      }

      for (let iteration = 0; iteration < 300; iteration++) {
        const next = new Float64Array(sampleCount);
        for (let rowIndex = 0; rowIndex < sampleCount; rowIndex++) {
          let value = 0;
          for (let columnIndex = 0; columnIndex < sampleCount; columnIndex++) {
            value += gram[rowIndex][columnIndex] * eigenvector[columnIndex];
          }
          next[rowIndex] = value;
        }
        removePreviousComponents(next);
        if (!normalizeInPlace(next)) break;

        let alignment = 0;
        for (let index = 0; index < sampleCount; index++) {
          alignment += eigenvector[index] * next[index];
        }
        if (alignment < 0) {
          for (let index = 0; index < sampleCount; index++) next[index] *= -1;
        }

        let deltaSquared = 0;
        for (let index = 0; index < sampleCount; index++) {
          const delta = next[index] - eigenvector[index];
          deltaSquared += delta * delta;
        }
        eigenvector = next;
        if (deltaSquared <= 1e-18) break;
      }

      const gramTimesVector = new Float64Array(sampleCount);
      for (let rowIndex = 0; rowIndex < sampleCount; rowIndex++) {
        let value = 0;
        for (let columnIndex = 0; columnIndex < sampleCount; columnIndex++) {
          value += gram[rowIndex][columnIndex] * eigenvector[columnIndex];
        }
        gramTimesVector[rowIndex] = value;
      }
      let eigenvalue = 0;
      for (let index = 0; index < sampleCount; index++) {
        eigenvalue += eigenvector[index] * gramTimesVector[index];
      }
      if (eigenvalue <= varianceFloor || !Number.isFinite(eigenvalue)) break;

      const singularValue = Math.sqrt(eigenvalue);
      const loading = new Float64Array(vectorDimension);
      for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
        let value = 0;
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          value += fitCenteredRows[authorIndex][featureIndex]
            * eigenvector[authorIndex];
        }
        loading[featureIndex] = value / singularValue;
      }
      if (!normalizeInPlace(loading)) break;

      // Eigenvector signs are arbitrary. Anchor each sign to its strongest loading.
      let signAnchorIndex = 0;
      for (let featureIndex = 1; featureIndex < vectorDimension; featureIndex++) {
        if (
          Math.abs(loading[featureIndex])
          > Math.abs(loading[signAnchorIndex])
        ) {
          signAnchorIndex = featureIndex;
        }
      }
      if (loading[signAnchorIndex] < 0) {
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          loading[featureIndex] *= -1;
        }
        for (let authorIndex = 0; authorIndex < sampleCount; authorIndex++) {
          eigenvector[authorIndex] *= -1;
        }
      }

      for (let authorIndex = 0; authorIndex < vectors.length; authorIndex++) {
        let score = 0;
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          score += centeredRows[authorIndex][featureIndex] * loading[featureIndex];
        }
        rawScores[authorIndex][componentIndex] = score;
      }
      const scoreEnergy = fitAuthorIndices.reduce((sum, authorIndex) => (
        sum + rawScores[authorIndex][componentIndex]
          * rawScores[authorIndex][componentIndex]
      ), 0);
      if (scoreEnergy <= varianceFloor || !Number.isFinite(scoreEnergy)) break;

      componentVectors.push(eigenvector);
      explainedVariance[componentIndex] = scoreEnergy / varianceDenominator;
    }

    // Stretch each PCA axis into an 8-bit channel. A soft percentile blend
    // expands dense score regions without discarding the original PCA distance
    // or assigning different colors to identical research profiles.
    const baseRgbRows = Array.from(
      { length: vectors.length },
      () => [128, 128, 128]
    );
    const scoreRanges = [];
    const colorPercentileWeight = 0.65;
    const hasResearchEvidence = vectors.map(vector => {
      const energy = vectorEnergy(vector);
      return Number.isFinite(energy) && energy > 1e-12;
    });
    const colorReferenceIndices = fitAuthorIndices.length
      ? fitAuthorIndices
      : hasResearchEvidence.flatMap((hasEvidence, index) => hasEvidence ? [index] : []);
    const percentileOfSortedValues = (sortedValues, value) => {
      let lower = 0;
      let upper = sortedValues.length;
      while (lower < upper) {
        const middle = Math.floor((lower + upper) / 2);
        if (sortedValues[middle] < value) lower = middle + 1;
        else upper = middle;
      }
      const first = lower;
      upper = sortedValues.length;
      while (lower < upper) {
        const middle = Math.floor((lower + upper) / 2);
        if (sortedValues[middle] <= value) lower = middle + 1;
        else upper = middle;
      }
      const lastExclusive = lower;
      const rank = lastExclusive > first
        ? (first + lastExclusive - 1) / 2
        : first - 0.5;
      return sortedValues.length > 1
        ? Math.max(0, Math.min(1, rank / (sortedValues.length - 1)))
        : 0.5;
    };
    for (let axis = 0; axis < 3; axis++) {
      const referenceValues = colorReferenceIndices
        .map(authorIndex => rawScores[authorIndex][axis])
        .sort((a, b) => a - b);
      const minimum = referenceValues[0] ?? 0;
      const maximum = referenceValues[referenceValues.length - 1] ?? 0;
      scoreRanges.push([minimum, maximum]);
      const range = maximum - minimum;
      const degenerate = !Number.isFinite(range)
        || range <= Math.max(1, Math.abs(minimum), Math.abs(maximum)) * 1e-12;

      rawScores.forEach((scores, authorIndex) => {
        if (degenerate || !hasResearchEvidence[authorIndex]) {
          baseRgbRows[authorIndex][axis] = 128;
          return;
        }
        const linearPosition = Math.max(
          0,
          Math.min(1, (scores[axis] - minimum) / range)
        );
        const colorPosition = linearPosition * (1 - colorPercentileWeight)
          + percentileOfSortedValues(referenceValues, scores[axis])
            * colorPercentileWeight;
        baseRgbRows[authorIndex][axis] = Math.max(
          0,
          Math.min(255, Math.round(colorPosition * 255))
        );
      });
    }

    // Turn the reference-relative research vector into a perceptual color.
    // Full-space cosine distance controls the radius away from white. The first
    // two relative PCA axes control hue, while the third changes chroma. This
    // keeps the professor structurally at white without folding PCA signs or
    // letting an unrelated base-color brightness fake reference proximity.
    const referenceVector = referenceApplied
      ? vectors[activeReferenceIndex]
      : null;
    const referencePcaScores = referenceApplied
      ? rawScores[activeReferenceIndex].slice()
      : [0, 0, 0];
    const relativeScores = rawScores.map(scores => scores.map(
      (score, axis) => score - referencePcaScores[axis]
    ));
    const referenceSimilarities = new Array(vectors.length).fill(null);
    const referenceDistances = new Array(vectors.length).fill(null);
    if (referenceVector) {
      vectors.forEach((vector, authorIndex) => {
        if (!hasResearchEvidence[authorIndex]) return;
        let dotProduct = 0;
        for (let featureIndex = 0; featureIndex < vectorDimension; featureIndex++) {
          dotProduct += vector[featureIndex] * referenceVector[featureIndex];
        }
        const similarity = authorIndex === activeReferenceIndex
          ? 1
          : Math.max(-1, Math.min(1, dotProduct));
        referenceSimilarities[authorIndex] = similarity;
        referenceDistances[authorIndex] = Math.sqrt(
          Math.max(0, (1 - similarity) / 2)
        );
      });
    }

    const referenceDistanceValues = referenceVector
      ? colorReferenceIndices
        .map(authorIndex => referenceDistances[authorIndex])
        .filter(distance => Number.isFinite(distance))
        .sort((a, b) => a - b)
      : [];
    const maximumReferenceDistance = referenceDistanceValues[
      referenceDistanceValues.length - 1
    ] || 0;
    const referenceDistancePercentileWeight = 0.65;
    const referenceRadialPositions = referenceDistances.map(distance => {
      if (!Number.isFinite(distance)) return null;
      if (distance <= 1e-12 || maximumReferenceDistance <= 1e-12) return 0;
      const linearPosition = Math.max(
        0,
        Math.min(1, distance / maximumReferenceDistance)
      );
      return linearPosition * (1 - referenceDistancePercentileWeight)
        + percentileOfSortedValues(referenceDistanceValues, distance)
          * referenceDistancePercentileWeight;
    });
    const relativeScoreScales = [0, 1, 2].map(axis => {
      const meanSquare = colorReferenceIndices.length
        ? colorReferenceIndices.reduce((sum, authorIndex) => (
          sum + relativeScores[authorIndex][axis]
            * relativeScores[authorIndex][axis]
        ), 0) / colorReferenceIndices.length
        : 0;
      const scale = Math.sqrt(meanSquare);
      return Number.isFinite(scale) && scale > 1e-12 ? scale : 1;
    });

    const oklabToLinearSrgb = (lightness, channelA, channelB) => {
      const longL = lightness
        + 0.3963377774 * channelA
        + 0.2158037573 * channelB;
      const longM = lightness
        - 0.1055613458 * channelA
        - 0.0638541728 * channelB;
      const longS = lightness
        - 0.0894841775 * channelA
        - 1.291485548 * channelB;
      const linearL = longL * longL * longL;
      const linearM = longM * longM * longM;
      const linearS = longS * longS * longS;
      return [
        4.0767416621 * linearL
          - 3.3077115913 * linearM
          + 0.2309699292 * linearS,
        -1.2684380046 * linearL
          + 2.6097574011 * linearM
          - 0.3413193965 * linearS,
        -0.0041960863 * linearL
          - 0.7034186147 * linearM
          + 1.707614701 * linearS
      ];
    };
    const encodeSrgbChannel = channel => {
      const bounded = Math.max(0, Math.min(1, channel));
      const encoded = bounded <= 0.0031308
        ? 12.92 * bounded
        : 1.055 * bounded ** (1 / 2.4) - 0.055;
      return Math.round(encoded * 255);
    };
    const oklabToRgb = (lightness, channelA, channelB) => {
      const inGamut = channels => channels.every(
        channel => Number.isFinite(channel) && channel >= 0 && channel <= 1
      );
      let linearRgb = oklabToLinearSrgb(lightness, channelA, channelB);
      if (!inGamut(linearRgb)) {
        // Reduce only chroma, retaining the distance-derived lightness.
        let lowerScale = 0;
        let upperScale = 1;
        for (let iteration = 0; iteration < 16; iteration++) {
          const middleScale = (lowerScale + upperScale) / 2;
          const candidate = oklabToLinearSrgb(
            lightness,
            channelA * middleScale,
            channelB * middleScale
          );
          if (inGamut(candidate)) lowerScale = middleScale;
          else upperScale = middleScale;
        }
        linearRgb = oklabToLinearSrgb(
          lightness,
          channelA * lowerScale,
          channelB * lowerScale
        );
      }
      return linearRgb.map(encodeSrgbChannel);
    };

    const referenceLightnessDrop = 0.5;
    const referenceMinimumChroma = 0.12;
    const referenceElevationChroma = 0.16;
    // PCA axis signs are stable but their absolute hue has no semantic label.
    // Rotate the whole palette together into a broad, low-clipping gamut region.
    const referenceHueRotation = 11 * Math.PI / 12;
    const rgbRows = baseRgbRows.map((baseRgb, authorIndex) => {
      if (!referenceVector || !hasResearchEvidence[authorIndex]) {
        return baseRgb.slice();
      }
      const radialPosition = referenceRadialPositions[authorIndex];
      if (!Number.isFinite(radialPosition) || radialPosition <= 1e-12) {
        return [255, 255, 255];
      }
      const scaledScores = relativeScores[authorIndex].map(
        (score, axis) => score / relativeScoreScales[axis]
      );
      const directionMagnitude = Math.sqrt(
        scaledScores.reduce((sum, score) => sum + score * score, 0)
      );
      const hasProjectedDirection = Number.isFinite(directionMagnitude)
        && directionMagnitude > 1e-12;
      const unitScores = hasProjectedDirection
        ? scaledScores.map(score => score / directionMagnitude)
        : [0, 0, 0];
      const hue = hasProjectedDirection
        ? Math.atan2(unitScores[1], unitScores[0]) + referenceHueRotation
        : 0;
      const chroma = hasProjectedDirection
        ? radialPosition * (
          referenceMinimumChroma
            + referenceElevationChroma * (unitScores[2] + 1) / 2
        )
        : 0;
      const lightness = 1 - referenceLightnessDrop * radialPosition;
      return oklabToRgb(
        lightness,
        chroma * Math.cos(hue),
        chroma * Math.sin(hue)
      );
    });

    const result = new Map();
    const rgbById = new Map();
    const baseRgbById = new Map();
    const scoresById = new Map();
    const referenceSimilarityById = new Map();
    const referenceDistanceById = new Map();
    const referenceRadialPositionById = new Map();
    const authorNodeById = new Map(orderedAuthors.map(author => [author.id, author]));
    authorIds.forEach((authorId, authorIndex) => {
      const rgb = rgbRows[authorIndex].slice();
      const baseRgb = baseRgbRows[authorIndex].slice();
      const scores = relativeScores[authorIndex].slice();
      const color = 'rgb(' + rgb.join(', ') + ')';
      result.set(authorId, color);
      rgbById.set(authorId, rgb);
      baseRgbById.set(authorId, baseRgb);
      scoresById.set(authorId, scores);
      referenceSimilarityById.set(
        authorId,
        referenceSimilarities[authorIndex]
      );
      referenceDistanceById.set(
        authorId,
        referenceDistances[authorIndex]
      );
      referenceRadialPositionById.set(
        authorId,
        referenceRadialPositions[authorIndex]
      );

      const authorNode = authorNodeById.get(authorId);
      if (authorNode) {
        const paperCount = finiteNonnegative(authorNode.paper_count);
        authorNode.researchEvidence = hasResearchEvidence[authorIndex];
        authorNode.researchConfidence = hasResearchEvidence[authorIndex]
          ? paperCount / (paperCount + 1)
          : 0;
        authorNode.pcaRgb = rgb.slice();
        authorNode.pcaScores = scores.slice();
        authorNode.pcaColor = color;
      }
    });

    const totalVariance = totalCenteredSumSquares / varianceDenominator;
    const explainedVarianceRatio = explainedVariance.map(variance =>
      totalVariance > varianceFloor
        ? Math.max(0, Math.min(1, variance / totalVariance))
        : 0
    );
    const coverage = {
      similarity: similarityCoverage,
      visibleSimilarity: visibleSimilarityCoverage,
      semanticNeighbors: semanticNeighborCoverage,
      visibleSemanticNeighbors: visibleSemanticNeighborCoverage
    };

    result.meta = {
      authorIds: authorIds.slice(),
      rgbById,
      baseRgbById,
      scoresById,
      relativeScores: relativeScores.map(scores => scores.slice()),
      rawScores: rawScores.map(scores => scores.slice()),
      explainedVariance,
      explainedVarianceRatio,
      totalVariance,
      activeComponents: componentVectors.length,
      scoreRanges,
      colorMapping: referenceApplied
        ? 'reference-polar-oklab-v1'
        : 'unique-profile-minmax-percentile-blend',
      colorPercentileWeight,
      referenceAuthorId: activeReferenceAuthorId,
      referenceApplied,
      referencePcaScores,
      referenceRgb: referenceApplied ? [255, 255, 255] : null,
      referenceSimilarityById,
      referenceDistanceById,
      referenceRadialPositionById,
      referenceDistancePercentileWeight,
      referenceLightnessDrop,
      referenceMinimumChroma,
      referenceElevationChroma,
      referenceHueRotation,
      relativeScoreScales,
      topicCount: topicNames.length,
      vectorDimension,
      vectorizerScheme: 'bm25-multiview-v1',
      bm25K1,
      bm25B,
      repeatEvidenceScale,
      leadAlpha,
      recencyAlpha,
      coreTopicAlpha,
      leadProfileCoverage,
      recentProfileCoverage,
      pcaMinimumPapers,
      pcaFitProfileCount: fitAuthorIndices.length,
      evidenceAuthorCount: hasResearchEvidence.filter(Boolean).length,
      unknownResearchIds: authorIds.filter((id, index) => !hasResearchEvidence[index]),
      semanticApplied,
      semanticMode,
      similarityAlpha,
      neighborSimilarityAlpha,
      latentTopicCoverage,
      latentDimensions: latentTopicSpace?.dimensions || 0,
      latentRetainedVariance: Number(
        keywordSimData?.topic_vectors?.retained_variance
      ) || 0,
      coverage,
      similarityCoverage,
      visibleSimilarityCoverage,
      semanticNeighborCoverage,
      visibleSemanticNeighborCoverage
    };
    return result;
  }

  function buildGraph(data, keywordSimData = null) {
    data.nodes.forEach(node => {
      node.type ||= 'author';
      node.name ||= node.id;
      node.val ??= node.value || 1;
    });
    const authorNodes = data.nodes.filter(node => node.type === 'author');
    const keywordNodes = data.nodes.filter(node => node.type === 'keyword');
    const nodesById = new Map(data.nodes.map(node => [node.id, node]));
    const endpointId = endpoint => typeof endpoint === 'object' ? endpoint.id : endpoint;
    const paperCount = node => Math.max(1, Number(node.paper_count ?? node.val) || 1);
    const maxAuthorPapers = Math.max(1, ...authorNodes.map(paperCount));
    const maxTopicPapers = Math.max(1, ...keywordNodes.map(paperCount));
    const relatedPaperRadius = (node, minimum, maximum, peak) => {
      const weight = Math.min(1, (paperCount(node) - 1) / Math.max(1, peak - 1));
      return minimum + (maximum - minimum) * Math.pow(weight, 0.7);
    };
    const topAuthors = new Set([...authorNodes].sort((a, b) => paperCount(b) - paperCount(a)).slice(0, 6).map(node => node.id));
    const topTopics = new Set([...keywordNodes].sort((a, b) => paperCount(b) - paperCount(a)).slice(0, 4).map(node => node.id));
    const authorColors = createPcaAuthorColors(
      authorNodes, keywordNodes, data.links, keywordSimData, COLLABO_RESEARCH_REFERENCE_AUTHOR_ID
    );
    const palette = ['#93daca', '#abafea', '#e1acd5', '#8dc5e8', '#c6c69a', '#bba0e1'];
    const hashId = id => [...id].reduce((hash, char) => (Math.imul(hash, 31) + char.codePointAt(0)) >>> 0, 0);
    // Seed a broad map from research profiles. Weak anchors preserve its shape
    // while the paper links relax in 3D, so a prolific author cannot pull every
    // paper into one dense ball at the center.
    const axes = ['x', 'y', 'z'];
    const spans = [500, 310, 180];
    const orderedScores = axes.map((_, axis) => authorNodes.map(node => node.pcaScores?.[axis] || 0).sort((a, b) => a - b));
    const anchors = new Map();
    const jitter = (id, axis, spread) => ((hashId(`${axis}:${id}`) % 1009) / 1008 - 0.5) * spread;
    authorNodes.forEach(node => {
      const anchor = {};
      axes.forEach((axis, index) => {
        const score = node.pcaScores?.[index] || 0;
        const rank = orderedScores[index].filter(value => value < score).length / Math.max(1, authorNodes.length - 1);
        anchor[axis] = (rank * 2 - 1) * spans[index] + jitter(node.id, axis, 70);
      });
      anchors.set(node.id, anchor);
    });
    const placeAmongAuthors = (node, contributors) => {
      const totalWeight = contributors.reduce((sum, author) => sum + 1 / Math.sqrt(paperCount(author)), 0) || 1;
      const anchor = {};
      axes.forEach(axis => {
        anchor[axis] = contributors.reduce((sum, author) => sum + anchors.get(author.id)[axis] / Math.sqrt(paperCount(author)), 0) / totalWeight + jitter(node.id, axis, 125);
      });
      anchors.set(node.id, anchor);
    };
    data.nodes.filter(node => node.type === 'paper').forEach(node => placeAmongAuthors(node, node.authors.map(id => nodesById.get(id)).filter(Boolean)));
    keywordNodes.forEach(node => placeAmongAuthors(node, authorNodes.filter(author => author.topic_profile?.[node.name])));
    data.nodes.forEach(node => Object.assign(node, anchors.get(node.id)));
    const nodeColor = node => {
      if (node.type === 'paper') return '#a3abb5';
      if (node.type === 'keyword') return palette[hashId(node.id) % palette.length];
      const color = new THREE.Color(authorColors.get(node.id) || '#8fbbe8');
      const hsl = color.getHSL({});
      // Keep research-derived hues legible; the white reference author also
      // receives a tint so white dots remain exclusive to papers.
      return color.setHSL(hsl.s < 0.08 ? 0.58 : hsl.h, Math.max(0.48, hsl.s), Math.max(0.5, Math.min(0.72, hsl.l))).getStyle();
    };

    // Retain aggregate relationships for focus, while drawing only real
    // paper authorship and paper-topic edges in the constellation.
    const adjacency = new Map(data.nodes.map(node => [node.id, new Set()]));
    data.links.forEach(link => {
      const source = endpointId(link.source);
      const target = endpointId(link.target);
      adjacency.get(source)?.add(target);
      adjacency.get(target)?.add(source);
    });
    const graphData = {
      nodes: data.nodes,
      links: data.links.filter(link => ['paper_author', 'paper_keyword'].includes(link.type))
    };
    const searchInput = document.getElementById('collabo-search');
    const status = document.getElementById('collabo-status');
    const layerButtons = [...document.querySelectorAll('[data-collabo-layer]')];
    const visibleTypes = new Set(['paper', 'author', 'keyword']);
    const nodeObjects = new Map();
    const textureCache = new Set();
    let hoveredId = null;
    let selectedId = null;
    let draggedId = null;
    let searchMatches = null;
    let focusIds = null;
    let viewportInteracted = false;
    let destroyed = false;
    let fitTimer = 0;
    let cameraMoving = false;
    let rotationResumeTimer = 0;
    const focusId = () => draggedId || hoveredId || selectedId;
    const isActive = node => !focusIds || focusIds.has(node.id);
    const isVisible = node => visibleTypes.has(node.type);
    const isLinkVisible = link => isVisible(nodesById.get(endpointId(link.source))) && isVisible(nodesById.get(endpointId(link.target)));
    const linkColor = link => {
      const source = nodesById.get(endpointId(link.source));
      const target = nodesById.get(endpointId(link.target));
      const color = new THREE.Color(nodeColor(target));
      const highlighted = focusIds && isActive(source) && isActive(target);
      const alpha = highlighted ? 0.12 : focusIds ? 0.008 : link.type === 'paper_author' ? 0.018 : 0.009;
      return `rgba(${Math.round(color.r * 255)},${Math.round(color.g * 255)},${Math.round(color.b * 255)},${alpha})`;
    };

    const glowCanvas = document.createElement('canvas');
    glowCanvas.width = glowCanvas.height = 64;
    const glowContext = glowCanvas.getContext('2d');
    const glow = glowContext.createRadialGradient(32, 32, 0, 32, 32, 32);
    glow.addColorStop(0, 'rgba(255,255,255,0.55)');
    glow.addColorStop(0.3, 'rgba(255,255,255,0.15)');
    glow.addColorStop(1, 'rgba(255,255,255,0)');
    glowContext.fillStyle = glow;
    glowContext.fillRect(0, 0, 64, 64);
    const glowTexture = new THREE.CanvasTexture(glowCanvas);
    textureCache.add(glowTexture);

    const dotGeometry = new THREE.SphereGeometry(1, 28, 20);
    const crystalGeometry = new THREE.OctahedronGeometry(1);
    const orbitGeometry = new THREE.TorusGeometry(1, 0.035, 5, 40);
    const addPart = (object, part, opacity = 1) => {
      part.userData.baseOpacity = opacity;
      part.material.opacity = opacity;
      object.add(part);
      return part;
    };
    const sizeLabel = label => {
      const { width, height } = label.material.map.image;
      const fit = Math.min(1, Math.max(80, g.width() - 32) / (width / 2));
      const fontScale = g.width() < 576 ? 0.7 : 1;
      const screenHeight = height / 2 * fit * fontScale;
      const scale = screenHeight * 2 * Math.tan(g.camera().fov * Math.PI / 360) / g.height();
      const parentScale = label.parent?.scale.x || 1;
      label.scale.set(scale * width / height / parentScale, scale / parentScale, 1);
    };
    const addLabel = (object, node, radius) => {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const font = '500 40px Oswald, sans-serif';
      ctx.font = font;
      const maxWidth = Math.max(220, Math.min(1100, (container.clientWidth - 48) * 2));
      const text = node.name.length > 68 ? `${node.name.slice(0, 65)}…` : node.name;
      const lines = [''];
      for (const word of text.split(/\s+/)) {
        const index = lines.length - 1;
        const candidate = lines[index] ? `${lines[index]} ${word}` : word;
        if (lines[index] && ctx.measureText(candidate).width > maxWidth) lines.push(word);
        else lines[index] = candidate;
      }
      canvas.width = Math.ceil(Math.min(maxWidth, Math.max(...lines.map(line => ctx.measureText(line).width)))) + 24;
      canvas.height = lines.length * 50 + 14;
      ctx.font = font;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.strokeStyle = 'rgba(8,12,20,0.9)';
      ctx.lineWidth = 4;
      ctx.fillStyle = node.type === 'paper' ? '#c5ccd4' : nodeColor(node);
      lines.forEach((line, index) => {
        ctx.strokeText(line, canvas.width / 2, 32 + index * 50, maxWidth);
        ctx.fillText(line, canvas.width / 2, 32 + index * 50, maxWidth);
      });
      const texture = new THREE.CanvasTexture(canvas);
      textureCache.add(texture);
      const label = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture, transparent: true, depthWrite: false, depthTest: false, sizeAttenuation: false }));
      label.renderOrder = 2;
      sizeLabel(label);
      label.position.y = radius + 14;
      label.userData.isLabel = true;
      // Labels do not intercept pointer picking intended for nearby dots.
      label.raycast = () => {};
      addPart(object, label, 0.9);
      object.userData.label = label;
      return label;
    };
    const defaultLabel = node => topAuthors.has(node.id) || topTopics.has(node.id);
    // Reveal more author/topic names as their estimated screen size grows.
    // Using the camera-to-orbit distance keeps the threshold stable while the
    // constellation auto-rotates, so labels do not flicker.
    const zoomLabelMinimumRadius = { author: 8, keyword: 6 };
    const zoomLabel = (node, object) => {
      if (node.type === 'paper' || !isVisible(node)) return false;
      const camera = g.camera();
      const cameraDistance = Math.max(1, camera.position.distanceTo(controls.target));
      const projectedRadius = object.userData.radius * g.height()
        / (2 * Math.tan(camera.fov * Math.PI / 360) * cameraDistance);
      return projectedRadius >= zoomLabelMinimumRadius[node.type];
    };
    const makeNode = node => {
      const object = new THREE.Group();
      const color = nodeColor(node);
      let radius;
      if (node.type === 'paper') {
        // Each dot represents one paper; connected authors and topics carry
        // the paper-count signal through their larger, varying sizes.
        radius = 2.4;
        const dot = new THREE.Mesh(dotGeometry, new THREE.MeshBasicMaterial({ color, transparent: true }));
        dot.scale.setScalar(radius);
        addPart(object, dot, 0.78);
      } else if (node.type === 'author') {
        radius = relatedPaperRadius(node, 4, 26, maxAuthorPapers);
        const halo = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTexture, color, transparent: true, depthWrite: false }));
        halo.scale.setScalar(radius * 3.8);
        halo.raycast = () => {};
        addPart(object, halo, 0.28);
        const circle = new THREE.Mesh(dotGeometry, new THREE.MeshBasicMaterial({ color, transparent: true }));
        circle.scale.setScalar(radius);
        addPart(object, circle, 0.95);
      } else {
        radius = relatedPaperRadius(node, 2.5, 7.5, maxTopicPapers);
        const crystal = new THREE.Mesh(crystalGeometry, new THREE.MeshPhongMaterial({ color, emissive: color, emissiveIntensity: 0.18, shininess: 80, transparent: true, flatShading: true }));
        crystal.scale.set(radius * 0.7, radius * 1.25, radius * 0.7);
        addPart(object, crystal, 0.88);
        const orbit = new THREE.Mesh(orbitGeometry, new THREE.MeshBasicMaterial({ color, transparent: true, depthWrite: false }));
        orbit.scale.setScalar(radius * 1.7);
        orbit.rotation.set(0.9, 0.35, (hashId(node.id) % 180) * Math.PI / 180);
        addPart(object, orbit, 0.65);
      }
      object.userData.radius = radius;
      if (defaultLabel(node)) addLabel(object, node, radius);
      nodeObjects.set(node.id, object);
      return object;
    };
    const tooltip = node => {
      const name = htmlEscape(node.name);
      const color = nodeColor(node);
      const kind = node.type === 'paper' ? '● PAPER' : node.type === 'author' ? '● AUTHOR' : '◇ TOPIC';
      let detail = '';
      let photo = '';
      if (node.type === 'paper') {
        detail = `<div class="collabo-tooltip-meta">${htmlEscape([node.year, node.venue].filter(Boolean).join(' · '))}</div><div class="collabo-tooltip-meta">${node.authors.map(htmlEscape).join(' · ')}</div>`;
      } else if (node.type === 'author') {
        const src = getNodePhoto(node.name);
        if (src) photo = `<img class="collabo-node-photo-img" src="${htmlEscape(src)}" alt="${name}" loading="lazy">`;
        detail = `<div class="collabo-tooltip-meta">${paperCount(node)} papers · ${node.first_author_count || 0} lead · ${node.coauthor_count || 0} coauthors</div>`;
      } else {
        detail = `<div class="collabo-tooltip-meta">${paperCount(node)} papers · ${node.author_count || 0} researchers</div>`;
      }
      const topics = node.type === 'paper' ? node.keywords : (node.top_keywords || []).map(topic => topic.name);
      const chips = (topics || []).slice(0, 4).map(topic => `<span class="collabo-topic-chip">${htmlEscape(topic)}</span>`).join('');
      return `<div class="collabo-node-tooltip">${photo}<div class="collabo-tooltip-theme" style="color:${color} !important">${kind}</div><strong>${name}</strong>${detail}${chips ? `<div class="collabo-tooltip-topics">${chips}</div>` : ''}</div>`;
    };

    const g = new ForceGraph3D(container, {
      controlType: 'orbit', rendererConfig: { antialias: true, alpha: true }
    })
      .width(container.clientWidth || 800)
      .height(computeHeight())
      .numDimensions(3)
      .backgroundColor('rgba(0,0,0,0)')
      .showNavInfo(false)
      .nodeId('id')
      .nodeLabel(tooltip)
      .nodeThreeObject(makeNode)
      .nodeVisibility(isVisible)
      .linkVisibility(isLinkVisible)
      .linkWidth(0)
      .linkOpacity(1)
      .linkColor(linkColor)
      .warmupTicks(100)
      .cooldownTicks(160)
      .d3AlphaDecay(0.025)
      .onNodeHover(node => {
        hoveredId = node?.id || null;
        refreshFocus();
        container.style.cursor = node ? 'pointer' : 'grab';
      })
      .onNodeClick(node => {
        viewportInteracted = true;
        selectedId = node.id;
        refreshFocus();
        const target = { x: node.x || 0, y: node.y || 0, z: node.z || 0 };
        const direction = new THREE.Vector3().copy(g.cameraPosition()).sub(new THREE.Vector3(target.x, target.y, target.z));
        if (direction.lengthSq() < 0.01) direction.set(0, 0, 1);
        direction.normalize().multiplyScalar(180);
        pauseRotationForCamera(800);
        g.cameraPosition({ x: target.x + direction.x, y: target.y + direction.y, z: target.z + direction.z }, target, 800);
        setBibSearchValue(node.type === 'author' ? extractFirstName(node.id) : node.name);
      })
      .onBackgroundClick(() => {
        selectedId = null;
        hoveredId = null;
        refreshFocus();
      })
      .onNodeDrag(node => { draggedId = node.id; refreshFocus(); })
      .onNodeDragEnd(() => { draggedId = null; refreshFocus(); })
      .enableNavigationControls(true);

    g.d3Force('charge').strength(-18);
    g.d3Force('link')
      .distance(link => link.type === 'paper_author' ? 80 : 110)
      .strength(link => link.type === 'paper_author' ? 0.012 : 0.007);
    g.d3Force('research-position', alpha => {
      data.nodes.forEach(node => axes.forEach(axis => {
        node[`v${axis}`] += (anchors.get(node.id)[axis] - node[axis]) * alpha * 0.055;
      }));
    });
    // Configure forces before providing data; reheating before layout creation
    // causes an undefined simulation error in 3d-force-graph.
    g.graphData(graphData);
    const controls = g.controls();
    controls.minDistance = 30;
    controls.maxDistance = 3000;
    controls.autoRotateSpeed = 0.25;
    let labelRefreshFrame = 0;
    let lastLabelCameraDistance = g.camera().position.distanceTo(controls.target);
    let pendingLabelCameraDistance = lastLabelCameraDistance;
    const scheduleZoomLabelRefresh = () => {
      const cameraDistance = g.camera().position.distanceTo(controls.target);
      const minimumChange = Math.max(1, lastLabelCameraDistance * 0.015);
      if (Math.abs(cameraDistance - lastLabelCameraDistance) < minimumChange) return;
      pendingLabelCameraDistance = cameraDistance;
      if (labelRefreshFrame) return;
      labelRefreshFrame = requestAnimationFrame(() => {
        labelRefreshFrame = 0;
        lastLabelCameraDistance = pendingLabelCameraDistance;
        refreshLabels();
      });
    };
    controls.addEventListener('change', scheduleZoomLabelRefresh);
    const syncAutoRotation = () => {
      controls.autoRotate = !destroyed && !document.hidden && !cameraMoving && !hoveredId && !draggedId;
    };
    function pauseRotationForCamera(duration) {
      cameraMoving = true;
      clearTimeout(rotationResumeTimer);
      syncAutoRotation();
      rotationResumeTimer = window.setTimeout(() => {
        cameraMoving = false;
        syncAutoRotation();
      }, duration);
    }
    syncAutoRotation();
    document.addEventListener('visibilitychange', syncAutoRotation);

    function refreshLabels() {
      if (destroyed) return;
      const id = focusId();
      nodeObjects.forEach((object, nodeId) => {
        const node = nodesById.get(nodeId);
        const active = isActive(node);
        const showLabel = nodeId === id
          || (!focusIds && (defaultLabel(node) || zoomLabel(node, object)))
          || (!id && searchMatches?.size <= 8 && searchMatches.has(nodeId));
        if (showLabel && !object.userData.label) addLabel(object, node, object.userData.radius);
        const label = object.userData.label;
        if (!label) return;
        label.material.opacity = label.userData.baseOpacity * (active ? 1 : 0.09);
        label.visible = Boolean(showLabel);
        sizeLabel(label);
      });
    }

    function refreshFocus() {
      if (destroyed) return;
      syncAutoRotation();
      const id = focusId();
      focusIds = id ? new Set([id, ...(adjacency.get(id) || [])]) : searchMatches;
      nodeObjects.forEach((object, nodeId) => {
        const node = nodesById.get(nodeId);
        const active = isActive(node);
        const emphasized = nodeId === id || (!id && searchMatches?.has(nodeId));
        object.children.forEach(child => {
          if (!child.userData.isLabel) {
            child.material.opacity = child.userData.baseOpacity * (active ? 1 : 0.09);
          }
        });
        object.scale.setScalar(emphasized ? 1.25 : 1);
      });
      refreshLabels();
      g.linkColor(linkColor);
      if (id) {
        const node = nodesById.get(id);
        status.textContent = `${node.name} · ${node.type === 'paper' ? [node.year, 'Click to find publication'].filter(Boolean).join(' · ') : `${paperCount(node)} papers`}`;
      } else if (searchMatches) {
        status.textContent = `${searchMatches.size} matching nodes · Click a node to explore`;
      } else {
        status.textContent = 'Size = related papers · Drag to rotate · Scroll to zoom';
      }
    }

    function fitView(duration = 800) {
      const nodes = data.nodes.filter(node => isVisible(node) && (!searchMatches || searchMatches.has(node.id)));
      if (!nodes.length) return;
      const center = {};
      axes.forEach(axis => {
        center[axis] = (Math.min(...nodes.map(node => node[axis])) + Math.max(...nodes.map(node => node[axis]))) / 2;
      });
      const halfFov = Math.tan(g.camera().fov * Math.PI / 360);
      const aspect = g.width() / g.height();
      const clearWidth = pageRoot ? viewport.clientWidth : g.width();
      const clearHeight = pageRoot ? viewport.clientHeight : g.height();
      const widthFraction = Math.max(0.2, (clearWidth - 80) / g.width());
      const heightFraction = Math.max(0.2, (clearHeight - 80) / g.height());
      // Fit actual node positions; billboard label bounds otherwise leave
      // excessive empty space around the map in the built-in sphere fit.
      const distance = Math.max(180, ...nodes.map(node => Math.max(
        (Math.abs(node.x - center.x) + 22) / (halfFov * aspect * widthFraction),
        (Math.abs(node.y - center.y) + 22) / (halfFov * heightFraction)
      ) + node.z - center.z));
      pauseRotationForCamera(duration);
      g.cameraPosition({ x: center.x, y: center.y, z: center.z + distance }, center, duration);
    }
    const onSearch = () => {
      viewportInteracted = true;
      selectedId = hoveredId = null;
      const query = searchInput.value.trim().toLocaleLowerCase();
      searchMatches = query ? new Set(data.nodes.filter(node => [node.name, ...(node.authors || []), ...(node.keywords || [])].join(' ').toLocaleLowerCase().includes(query)).map(node => node.id)) : null;
      refreshFocus();
    };
    searchInput.addEventListener('input', onSearch);
    const onSearchKey = event => { if (event.key === 'Enter') fitView(); };
    searchInput.addEventListener('keydown', onSearchKey);
    const layerHandlers = new Map();
    layerButtons.forEach(button => {
      const type = button.dataset.collaboLayer;
      document.querySelector(`[data-collabo-count="${type}"]`).textContent = data.nodes.filter(node => node.type === type).length;
      const handler = () => {
        if (visibleTypes.has(type)) visibleTypes.delete(type);
        else visibleTypes.add(type);
        button.setAttribute('aria-pressed', String(visibleTypes.has(type)));
        if (focusId() && !isVisible(nodesById.get(focusId()))) selectedId = hoveredId = draggedId = null;
        g.nodeVisibility(isVisible).linkVisibility(isLinkVisible);
        refreshFocus();
      };
      layerHandlers.set(button, handler);
      button.addEventListener('click', handler);
    });
    const resetView = () => {
      viewportInteracted = true;
      selectedId = hoveredId = draggedId = null;
      searchMatches = null;
      searchInput.value = '';
      layerButtons.forEach(button => {
        visibleTypes.add(button.dataset.collaboLayer);
        button.setAttribute('aria-pressed', 'true');
      });
      g.nodeVisibility(isVisible).linkVisibility(isLinkVisible);
      refreshFocus();
      fitView();
      setBibSearchValue('');
    };
    backButton.addEventListener('click', resetView);

    const syncProjection = () => {
      if (!pageRoot) return;
      const rect = viewport.getBoundingClientRect();
      const sceneRect = backdrop.getBoundingClientRect();
      const width = g.width();
      const height = g.height();
      const centerX = rect.left - sceneRect.left + rect.width / 2;
      const centerY = rect.top - sceneRect.top + rect.height / 2;
      g.camera().setViewOffset(width, height, width / 2 - centerX, height / 2 - centerY, width, height);
    };
    resizeCanvas(g);
    syncProjection();
    let resizeFrame = 0;
    const scheduleViewportUpdate = () => {
      if (resizeFrame) return;
      resizeFrame = requestAnimationFrame(() => {
        resizeFrame = 0;
        updateSceneLayout();
        if (g.width() !== container.clientWidth || g.height() !== computeHeight()) {
          resizeCanvas(g);
          refreshLabels();
        }
        syncProjection();
      });
    };
    const resizeObserver = new ResizeObserver(scheduleViewportUpdate);
    resizeObserver.observe(container);
    if (pageRoot) {
      resizeObserver.observe(pageRoot);
      resizeObserver.observe(viewport);
      resizeObserver.observe(document.body, { box: 'border-box' });
    }
    document.fonts?.ready.then(() => { if (!destroyed) scheduleViewportUpdate(); });
    window.addEventListener('resize', scheduleViewportUpdate, { passive: true });
    window.visualViewport?.addEventListener('resize', scheduleViewportUpdate, { passive: true });
    const markInteraction = () => { viewportInteracted = true; };
    container.addEventListener('pointerdown', markInteraction, { passive: true });
    container.addEventListener('wheel', markInteraction, { passive: true });
    const autoFit = () => { if (!viewportInteracted && !destroyed) fitView(); };
    fitTimer = window.setTimeout(autoFit, 600);
    g.onEngineStop(autoFit);
    document.getElementById('coauthor-graph-loader')?.remove();

    window.addEventListener('pagehide', event => {
      // Browsers may restore this same page and WebGL context from history.
      if (event.persisted) { g.pauseAnimation(); return; }
      destroyed = true;
      clearTimeout(fitTimer);
      clearTimeout(rotationResumeTimer);
      document.removeEventListener('visibilitychange', syncAutoRotation);
      controls.removeEventListener('change', scheduleZoomLabelRefresh);
      resizeObserver.disconnect();
      cancelAnimationFrame(resizeFrame);
      cancelAnimationFrame(labelRefreshFrame);
      window.removeEventListener('resize', scheduleViewportUpdate);
      window.visualViewport?.removeEventListener('resize', scheduleViewportUpdate);
      searchInput.removeEventListener('input', onSearch);
      searchInput.removeEventListener('keydown', onSearchKey);
      backButton.removeEventListener('click', resetView);
      layerHandlers.forEach((handler, button) => button.removeEventListener('click', handler));
      container.removeEventListener('pointerdown', markInteraction);
      container.removeEventListener('wheel', markInteraction);
      g.pauseAnimation();
      nodeObjects.forEach(object => object.children.forEach(child => child.material.dispose()));
      [dotGeometry, crystalGeometry, orbitGeometry].forEach(geometry => geometry.dispose());
      textureCache.forEach(texture => texture.dispose());
      g.renderer().dispose();
    });
    window.addEventListener('pageshow', event => {
      if (event.persisted && !destroyed) {
        syncAutoRotation();
        g.resumeAnimation();
      }
    });
  }

  Promise.all([
    fetch('/assets/json/collabo_graph.json').then(r => r.json()),
    fetch('/assets/json/keyword_similarity.json')
      .then(r => r.ok ? r.json() : null)
      .catch(() => null)
  ])
    .then(([data, keywordSimData]) => buildGraph(data, keywordSimData))
    .catch(err => {
      const loader = document.getElementById('coauthor-graph-loader');
      if (loader) loader.textContent = 'Unable to display the collaboration graph. Please reload the page.';
      console.error('Graph load error', err);
    });
})();
</script>
