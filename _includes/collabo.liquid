<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600&display=swap">
<style>
  .collabo-section,
  .collabo-section * {
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.02em;
  }
  .collabo-node-tooltip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    font-size: 15px;
    line-height: 1.3;
    min-width: 120px;
  }
  .collabo-node-photo-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.75);
    background: #0b0f1c;
  }
  #coauthor-graph-loader {
    font-weight: 400;
    text-transform: uppercase;
  }
  .collabo-legend {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(2, 6, 17, 0.85);
    border-radius: 8px;
    font-size: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .collabo-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #cfd8dc;
  }
  .collabo-legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: 0 0 8px currentColor;
  }
  .collabo-legend-dot.author {
    background: linear-gradient(135deg, #00bfff, #2979ff);
  }
  .collabo-legend-dot.keyword {
    background: linear-gradient(135deg, #ffffff, #e0e0e0);
    border-radius: 4px;
  }
</style>
<div class="collabo-section" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: stretch;">
  <div id="coauthor-graph" style="height: 520px; min-height: 360px; border: 1px solid #222; box-shadow: 0 0 24px #000a; background: #020611; position: relative; overflow: hidden;">
    <div id="coauthor-graph-loader" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#cfd8dc;font-size:.85rem;font-family:system-ui,Segoe UI,sans-serif;letter-spacing:.5px;">Loading 3D Collaboration Graph…</div>
  </div>
  <div style="margin-top: .25rem;">
    {% include pub_count_legend.liquid %}
  </div>
  <div id="coauthor-table" style="width: 100%;"></div>
</div>
<script src="//cdn.jsdelivr.net/npm/3d-force-graph"></script>
<script type="importmap">
{
  "imports": {
    "three-spritetext": "https://esm.sh/three-spritetext@1"
  }
}
</script>
<script type="module">
{% assign firstPhoto = true %}
const COLLABO_PHOTOS = {
{% for person in site.people %}
  {% if person.img %}
    {% unless firstPhoto %},{% endunless %}
    "{{ person.title | split:'(' | first | strip | replace:'"','\\"' }}": "{{ person.img | strip }}"
    {% assign firstPhoto = false %}
  {% endif %}
{% endfor %}
};
const COLLABO_DEFAULT_PHOTO = '/assets/img/BAELAB_LOGO.png';

import SpriteText from 'three-spritetext';

(() => {
  const container = document.getElementById('coauthor-graph');
  if (!container) return;

  const htmlEscape = (str = '') => str.replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);

  function buildNameVariants(rawName = '') {
    const variants = new Set();
    const base = rawName.trim();
    if (!base) return [];
    variants.add(base);
    variants.add(base.replace(/\s+/g, ' '));

    if (base.includes(',')) {
      const [lastPart, ...rest] = base.split(',');
      const last = lastPart.trim();
      const first = rest.join(',').trim();
      if (first && last) {
        variants.add(`${first} ${last}`.trim());
        variants.add(`${last} ${first}`.trim());
      }
    } else {
      const tokens = base.split(/\s+/);
      if (tokens.length >= 2) {
        const last = tokens[tokens.length - 1];
        const first = tokens.slice(0, -1).join(' ');
        variants.add(`${last}, ${first}`.trim());
        variants.add(`${first} ${last}`.trim());
      }
    }

    variants.add(base.replace(/[.,]/g, '').trim());
    return [...variants].filter(Boolean);
  }

  function getNodePhoto(name) {
    const variants = buildNameVariants(name);
    for (const candidate of variants) {
      if (COLLABO_PHOTOS[candidate]) return COLLABO_PHOTOS[candidate];
    }
    return null;
  }

  function extractFirstName(name) {
    if (name.includes(',')) {
      const parts = name.split(',');
      return parts[1] ? parts[1].trim() : '';
    }
    if (/^[가-힣]{2,}$/.test(name)) return name.slice(-2);
    if (/^[A-Za-z ]+$/.test(name.trim())) return name.trim().split(/\s+/)[0];
    return name;
  }
  function setBibSearchValue(value, retries = 6) {
    const searchBox = document.getElementById('bibsearch');
    if (searchBox) {
      searchBox.value = value;
      searchBox.dispatchEvent(new Event('input', { bubbles: true }));
      searchBox.focus();
    } else if (retries > 0) {
      setTimeout(() => setBibSearchValue(value, retries - 1), 250);
    }
  }

  // Responsive height logic (preserve previous behavior with slight increase for 3D)
  function computeHeight() {
    const w = container.clientWidth || 800;
    if (w < 576) return Math.max(Math.round(w), 400);
    return Math.max(Math.round(w * 9/16), 420);
  }
  function resizeCanvas(graphInstance) {
    const h = computeHeight();
    container.style.height = h + 'px';
    graphInstance && graphInstance.height(h).width(container.clientWidth || 800);
  }

  // Create multi-layered space background with depth
  function addStarfield(graphInstance) {
    const THREE = window.THREE;
    if (!THREE) return;
    
    // Layer 1: Distant nebula-like background (furthest)
    const nebulaGeometry = new THREE.SphereGeometry(1800, 32, 32);
    const nebulaTexture = createNebulaTexture();
    const nebulaMaterial = new THREE.MeshBasicMaterial({ 
      map: nebulaTexture, 
      side: THREE.BackSide, 
      transparent: true, 
      opacity: 0.15,
      blending: THREE.AdditiveBlending
    });
    const nebula = new THREE.Mesh(nebulaGeometry, nebulaMaterial);
    nebula.name = 'collabo-nebula';
    graphInstance.scene().add(nebula);
    
    // Layer 2: Distant stars (far background)
    addStarLayer(graphInstance, 1400, 1600, 800, 1.2, 0.4, 'distant-stars');
    
    // Layer 3: Mid-distance stars (medium layer)
    addStarLayer(graphInstance, 900, 1200, 600, 1.8, 0.6, 'mid-stars');
    
    // Layer 4: Near stars (close layer)
    addStarLayer(graphInstance, 600, 800, 400, 2.5, 0.85, 'near-stars');
    
    // Layer 5: Twinkling accent stars (closest, animated)
    const twinkleStars = addStarLayer(graphInstance, 400, 600, 150, 3.5, 1.0, 'twinkle-stars', true);
    
    // Animate twinkling stars
    if (twinkleStars) {
      const positions = twinkleStars.geometry.attributes.position.array;
      const originalPositions = positions.slice();
      let time = 0;
      function animateTwinkle() {
        time += 0.01;
        const sizes = new Float32Array(positions.length / 3);
        for (let i = 0; i < positions.length / 3; i++) {
          const offset = i * 0.5;
          sizes[i] = 3.5 + Math.sin(time * 2 + offset) * 1.5;
        }
        twinkleStars.material.size = 3.5 + Math.sin(time * 2) * 0.5;
        requestAnimationFrame(animateTwinkle);
      }
      animateTwinkle();
    }
    
    // Add cosmic dust particles
    addCosmicDust(graphInstance);
  }
  
  function addStarLayer(graphInstance, minRadius, maxRadius, count, size, opacity, name, colorful = false) {
    const THREE = window.THREE;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(count * 3);
    const colors = new Float32Array(count * 3);
    
    for (let i = 0; i < count; i++) {
      const radius = minRadius + Math.random() * (maxRadius - minRadius);
      const theta = Math.acos(2 * Math.random() - 1);
      const phi = 2 * Math.PI * Math.random();
      
      positions[i * 3] = radius * Math.sin(theta) * Math.cos(phi);
      positions[i * 3 + 1] = radius * Math.sin(theta) * Math.sin(phi);
      positions[i * 3 + 2] = radius * Math.cos(theta);
      
      // Color variation for space atmosphere
      if (colorful) {
        const colorPalette = [
          [1.0, 1.0, 1.0],    // white
          [0.8, 0.9, 1.0],    // light blue
          [1.0, 0.9, 0.7],    // warm white
          [0.7, 0.8, 1.0],    // cool blue
          [1.0, 0.8, 0.9]     // pink tint
        ];
        const colorChoice = colorPalette[Math.floor(Math.random() * colorPalette.length)];
        colors[i * 3] = colorChoice[0];
        colors[i * 3 + 1] = colorChoice[1];
        colors[i * 3 + 2] = colorChoice[2];
      } else {
        const brightness = 0.7 + Math.random() * 0.3;
        colors[i * 3] = brightness;
        colors[i * 3 + 1] = brightness;
        colors[i * 3 + 2] = brightness + Math.random() * 0.1;
      }
    }
    
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    const material = new THREE.PointsMaterial({ 
      size: size, 
      sizeAttenuation: true, 
      transparent: true, 
      opacity: opacity,
      vertexColors: true,
      blending: THREE.AdditiveBlending
    });
    
    const stars = new THREE.Points(geometry, material);
    stars.name = 'collabo-' + name;
    graphInstance.scene().add(stars);
    return stars;
  }
  
  function addCosmicDust(graphInstance) {
    const THREE = window.THREE;
    const dustCount = 300;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(dustCount * 3);
    const colors = new Float32Array(dustCount * 3);
    
    for (let i = 0; i < dustCount; i++) {
      const radius = 700 + Math.random() * 600;
      const theta = Math.acos(2 * Math.random() - 1);
      const phi = 2 * Math.PI * Math.random();
      
      positions[i * 3] = radius * Math.sin(theta) * Math.cos(phi);
      positions[i * 3 + 1] = radius * Math.sin(theta) * Math.sin(phi);
      positions[i * 3 + 2] = radius * Math.cos(theta);
      
      // Colorful cosmic dust (cyan, purple, pink hues)
      const dustColors = [
        [0.0, 0.8, 1.0],    // cyan
        [0.8, 0.0, 1.0],    // purple
        [1.0, 0.4, 0.8],    // pink
        [0.4, 0.6, 1.0],    // light blue
      ];
      const colorChoice = dustColors[Math.floor(Math.random() * dustColors.length)];
      colors[i * 3] = colorChoice[0];
      colors[i * 3 + 1] = colorChoice[1];
      colors[i * 3 + 2] = colorChoice[2];
    }
    
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    
    const material = new THREE.PointsMaterial({ 
      size: 4, 
      sizeAttenuation: true, 
      transparent: true, 
      opacity: 0.3,
      vertexColors: true,
      blending: THREE.AdditiveBlending
    });
    
    const dust = new THREE.Points(geometry, material);
    dust.name = 'collabo-cosmic-dust';
    graphInstance.scene().add(dust);
  }
  
  function createNebulaTexture() {
    const THREE = window.THREE;
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    
    // Create gradient nebula effect
    const gradient = ctx.createRadialGradient(256, 256, 50, 256, 256, 256);
    gradient.addColorStop(0, 'rgba(100, 50, 150, 0.3)');
    gradient.addColorStop(0.3, 'rgba(50, 20, 100, 0.2)');
    gradient.addColorStop(0.6, 'rgba(20, 10, 60, 0.1)');
    gradient.addColorStop(1, 'rgba(5, 2, 20, 0)');
    
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 512, 512);
    
    // Add some noise for texture
    for (let i = 0; i < 2000; i++) {
      const x = Math.random() * 512;
      const y = Math.random() * 512;
      const size = Math.random() * 3;
      const alpha = Math.random() * 0.3;
      ctx.fillStyle = `rgba(150, 100, 200, ${alpha})`;
      ctx.fillRect(x, y, size, size);
    }
    
    return new THREE.CanvasTexture(canvas);
  }

  function buildGraph(data) {
    // Backwards compatibility if file still has old keys
    data.nodes.forEach(n => {
      if (n.value != null && n.val == null) n.val = n.value;
      if (!n.name) n.name = n.id;
      // Ensure type field exists for older data
      if (!n.type) n.type = 'author';
    });

    // Separate author and keyword nodes for sizing
    const authorNodes = data.nodes.filter(n => n.type === 'author');
    const keywordNodes = data.nodes.filter(n => n.type === 'keyword');
    
    const maxAuthorVal = Math.max(...authorNodes.map(n => n.val||1), 1);
    const maxKeywordVal = Math.max(...keywordNodes.map(n => n.val||1), 1);
    
    // Top authors (limit 6 like before)
    const topSet = new Set([...authorNodes].sort((a,b)=> (b.val||0)-(a.val||0)).slice(0,6).map(n=>n.id));

    const g = ForceGraph3D({ controlType: 'orbit' })(container)
      .graphData(data)
      .backgroundColor('#020611')
      .showNavInfo(false)
      .nodeId('id')
      .nodeLabel(n => {
        const displayName = n.name || n.id.replace(/^kw:/, '');
        const escapedName = htmlEscape(displayName);
        
        if (n.type === 'keyword') {
          return `<div class="collabo-node-tooltip"><div style="color:#ffffff;font-size:12px;">🏷️ KEYWORD</div><div><strong>${escapedName}</strong><br/>Papers: ${n.val}</div></div>`;
        }
        
        const photo = getNodePhoto(n.name);
        const photoMarkup = photo ? `<img class="collabo-node-photo-img" src="${photo}" alt="${escapedName}" loading="lazy"/>` : '';
        return `<div class="collabo-node-tooltip">${photoMarkup}<div><strong>${escapedName}</strong><br/>Papers: ${n.val}</div></div>`;
      })
      .nodeVal(n => {
        if (n.type === 'keyword') {
          return 0.03 + 0.1 * (n.val || 1);
        }
        return 0.05 + 0.4 * (n.val || 1);
      })
      .nodeOpacity(0.75)
      .linkOpacity(0.05)
      .linkWidth(l => 0.1 + 0.2 * (l.value||1))
      .linkDirectionalParticles(0)
      .linkColor('#ffffff')
      .nodeColor(n => {
        // Different color scheme for keywords vs authors
        if (n.type === 'keyword') {
          // White/light gray palette for keywords
          const kwPalette = ['#ffffff','#fffafa','#fffff0'];
          const h = [...n.id].reduce((a,c)=> a + c.charCodeAt(0),0);
          return kwPalette[h % kwPalette.length];
        }
        
        // Blue palette for authors
        const palette = ['#120a8f','#2979ff','#3e8ede','#1e90ff','#4169e1','#0073cf','#00356b','#0288d1','#007fff','#4d4dff'];
        const h = [...n.id].reduce((a,c)=> a + c.charCodeAt(0),0);
        let base = palette[h % palette.length];
        if (n.val === maxAuthorVal) return '#2979ff';
        return base;
      })
      .onNodeClick(node => {
        // Camera focus
        const dist = 100 + Math.sqrt(node.val||1)*22;
        const ratio = 1 + dist / Math.hypot(node.x,node.y,node.z);
        g.cameraPosition({ x: node.x*ratio, y: node.y*ratio, z: node.z*ratio }, { x: node.x, y: node.y, z: node.z }, 2000);
        
        // For keywords, search by the keyword name; for authors, search by first name
        if (node.type === 'keyword') {
          const keywordName = node.name || node.id.replace(/^kw:/, '');
          setBibSearchValue(keywordName);
        } else {
          setBibSearchValue(extractFirstName(node.id));
        }
        flashLinks(node, g);
      })
      .onNodeHover(node => {
        container.style.cursor = node ? 'pointer':'default';
      });

    // Smooth OrbitControls tuning (replaces manual camera animation)
    const controls = g.controls();
    if (controls) {
      controls.enableDamping = true;
      controls.dampingFactor = 0.12;
      controls.rotateSpeed = 0.65;
      controls.zoomSpeed = 0.9;
      controls.enablePan = true;
      controls.minPolarAngle = 0.005 * Math.PI; // virtually no upper clamp
      controls.maxPolarAngle = 0.995 * Math.PI; // virtually no lower clamp
      controls.minDistance = 140;
      controls.maxDistance = 1400;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.6;

      const stopAutoRotate = () => {
        controls.autoRotate = false;
        container.removeEventListener('pointerdown', stopAutoRotate);
        container.removeEventListener('wheel', stopAutoRotate);
        container.removeEventListener('touchstart', stopAutoRotate);
      };

      container.addEventListener('pointerdown', stopAutoRotate);
      container.addEventListener('wheel', stopAutoRotate);
      container.addEventListener('touchstart', stopAutoRotate);
    }

    // Add SpriteText labels for all nodes
    g.nodeThreeObjectExtend(true);
    g.nodeThreeObject(n => {
      const displayName = n.name || n.id.replace(/^kw:/, '');
      const sprite = new SpriteText(displayName);
      sprite.fontFace = 'Oswald,sans-serif';
      
      if (n.type === 'keyword') {
        // Keywords: white color, smaller text
        sprite.color = '#ffffff';
        sprite.textHeight = 4 + Math.sqrt(n.val||1) * 0.4;
        sprite.fontWeight = '400';
      } else if (topSet.has(n.id)) {
        // Top authors: white, larger text
        sprite.color = '#ffffff';
        sprite.textHeight = 8 + Math.sqrt(n.val||1) * 0.7;
        sprite.fontWeight = '600';
      } else {
        // Regular authors: light blue text
        sprite.color = '#ffffff';
        sprite.textHeight = 5 + Math.sqrt(n.val||1) * 0.3;
        sprite.fontWeight = '400';
      }
      
      // Position above the node
      const offset = Math.sqrt(n.val||1) * 3 + 8;
      sprite.position.set(0, offset, 0);
      
      return sprite;
    });

    function flashLinks(node, gInstance) {
      const related = new Set();
      gInstance.graphData().links.forEach(l => {
        if (l.source.id === node.id || l.target.id === node.id) related.add(l);
      });
      related.forEach(l => { l.__highlight = true; });
      gInstance.refresh();
      setTimeout(() => { related.forEach(l => { l.__highlight = false; }); gInstance.refresh(); }, 1300);
    }
    


    // Starfield + post-processing bloom (optional)
    addStarfield(g);
    try {
      const composer = g.postProcessingComposer();
      if (window.THREE && composer) {
        const UnrealBloomPass = window.THREE.UnrealBloomPass || undefined;
        // If external bloom script was not loaded, skip silently.
      }
    } catch (e) { /* ignore */ }

    // Initial sizing
    resizeCanvas(g);
    window.addEventListener('resize', () => resizeCanvas(g));

    // Remove loader
    const loader = document.getElementById('coauthor-graph-loader');
    if (loader) loader.remove();

    // Auto fit view after small warmup
    setTimeout(() => {
      g.zoomToFit(800, 40);
    }, 1200);

  }

  fetch('/assets/json/collabo_graph.json')
    .then(r => r.json())
    .then(data => buildGraph(data))
    .catch(err => {
      const loader = document.getElementById('coauthor-graph-loader');
      if (loader) loader.textContent = 'Failed to load graph data.';
      console.error('Graph load error', err);
    });
})();
</script>