<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600&display=swap">
<style>
  .collabo-section,
  .collabo-section * {
    font-family: 'Oswald', sans-serif;
    letter-spacing: 0.02em;
  }
  .cluster-legend,
  .cluster-legend *,
  .collabo-legend,
  .collabo-legend *,
  .collabo-node-tooltip,
  .collabo-node-tooltip *,
  #coauthor-graph-loader {
    color: #ffffff !important;
  }
  .collabo-node-tooltip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    font-size: 15px;
    line-height: 1.3;
    min-width: 120px;
  }
  .collabo-node-photo-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.75);
    background: #0b0f1c;
  }
  #coauthor-graph-loader {
    font-weight: 400;
    text-transform: uppercase;
  }
  .collabo-legend {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 1rem;
    background: rgba(2, 6, 17, 0.85);
    border-radius: 8px;
    font-size: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .collabo-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff !important;
  }
  .collabo-legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: 0 0 8px currentColor;
  }
  .collabo-legend-dot.author {
    background: linear-gradient(135deg, #00bfff, #2979ff);
  }
  .collabo-legend-dot.keyword {
    background: #f1f0ec;
    border-radius: 4px;
  }
  .node-label {
    font-family: 'Oswald', sans-serif;
    font-size: 12px;
    text-shadow: 0 0 4px rgba(0,0,0,0.8), 0 0 8px rgba(0,0,0,0.6);
  }
  #cluster-legend-container {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1000;
    pointer-events: none;
  }
  .cluster-legend {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.5rem 0.65rem;
    background: rgba(2, 6, 17, 0.92);
    border-radius: 6px;
    font-size: 0.7rem;
    border: 1px solid rgba(255,255,255,0.15);
    max-width: 140px;
  }
  .cluster-legend-title {
    color: #ffffff !important;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.15rem;
    text-align: left;
  }
  .cluster-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #ffffff !important;
    font-size: 0.65rem;
  }
  .cluster-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
<div class="collabo-section" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: stretch;">
  <div id="coauthor-graph-wrapper" style="position: relative;">
    <div id="coauthor-graph" style="height: 520px; min-height: 360px; border: 1px solid #222; box-shadow: 0 0 24px #000a; background: #020611; position: relative; overflow: hidden;">
      <div id="coauthor-graph-loader" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#ffffff;font-size:.85rem;font-family:system-ui,Segoe UI,sans-serif;letter-spacing:.5px;">Loading Collaboration Graph…</div>
    </div>
    <div id="cluster-legend-container"></div>
  </div>
  <div style="margin-top: .25rem;">
    {% include pub_stats.liquid %}
  </div>
  <div id="coauthor-table" style="width: 100%;"></div>
</div>
<script src="//cdn.jsdelivr.net/npm/force-graph"></script>
<script>
{% assign firstPhoto = true %}
const COLLABO_PHOTOS = {
{% for person in site.people %}
  {% if person.img %}
    {% unless firstPhoto %},{% endunless %}
    "{{ person.title | split:'(' | first | strip | replace:'"','\\"' }}": "{{ person.img | strip }}"
    {% assign firstPhoto = false %}
  {% endif %}
{% endfor %}
};
const COLLABO_DEFAULT_PHOTO = '/assets/img/BAELAB_LOGO.png';

(() => {
  const container = document.getElementById('coauthor-graph');
  if (!container) return;

  const htmlEscape = (str = '') => str.replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);

  function buildNameVariants(rawName = '') {
    const variants = new Set();
    const base = rawName.trim();
    if (!base) return [];
    variants.add(base);
    variants.add(base.replace(/\s+/g, ' '));

    if (base.includes(',')) {
      const [lastPart, ...rest] = base.split(',');
      const last = lastPart.trim();
      const first = rest.join(',').trim();
      if (first && last) {
        variants.add(`${first} ${last}`.trim());
        variants.add(`${last} ${first}`.trim());
      }
    } else {
      const tokens = base.split(/\s+/);
      if (tokens.length >= 2) {
        const last = tokens[tokens.length - 1];
        const first = tokens.slice(0, -1).join(' ');
        variants.add(`${last}, ${first}`.trim());
        variants.add(`${first} ${last}`.trim());
      }
    }

    variants.add(base.replace(/[.,]/g, '').trim());
    return [...variants].filter(Boolean);
  }

  function getNodePhoto(name) {
    const variants = buildNameVariants(name);
    for (const candidate of variants) {
      if (COLLABO_PHOTOS[candidate]) return COLLABO_PHOTOS[candidate];
    }
    return null;
  }

  function extractFirstName(name) {
    if (name.includes(',')) {
      const parts = name.split(',');
      return parts[1] ? parts[1].trim() : '';
    }
    if (/^[가-힣]{2,}$/.test(name)) return name.slice(-2);
    if (/^[A-Za-z ]+$/.test(name.trim())) return name.trim().split(/\s+/)[0];
    return name;
  }
  function setBibSearchValue(value, retries = 6) {
    const searchBox = document.getElementById('bibsearch');
    if (searchBox) {
      searchBox.value = value;
      searchBox.dispatchEvent(new Event('input', { bubbles: true }));
      searchBox.focus();
    } else if (retries > 0) {
      setTimeout(() => setBibSearchValue(value, retries - 1), 250);
    }
  }

  // Responsive height logic for 2D graph
  function computeHeight() {
    const w = container.clientWidth || 800;
    if (w < 576) return Math.max(Math.round(w), 400);
    return Math.max(Math.round(w * 9/16), 420);
  }
  function resizeCanvas(graphInstance) {
    const h = computeHeight();
    container.style.height = h + 'px';
    graphInstance && graphInstance.height(h).width(container.clientWidth || 800);
  }

  // Seeded random number generator for reproducibility
  function seededRandom(seed) {
    let s = seed;
    return function() {
      s = (s * 1103515245 + 12345) & 0x7fffffff;
      return s / 0x7fffffff;
    };
  }

  // K-means clustering based on keyword connections
  // Optionally applies keyword-keyword similarity smoothing (precomputed offline)
  function kMeansClustering(authorNodes, keywordNodes, links, k = 6, excludeIds = new Set(), keywordSimData = null) {
    // Fixed seed for reproducibility
    const random = seededRandom(2019);

    const simPayload = keywordSimData && (keywordSimData.similarities || keywordSimData);
    const simAlpha = (keywordSimData && typeof keywordSimData.alpha === 'number') ? keywordSimData.alpha : 0.35;
    
    // Build author-keyword feature vectors
    const kwIds = keywordNodes.map(n => n.id);
    const kwIndexById = new Map(kwIds.map((id, idx) => [id, idx]));
    const authorFeatures = new Map();
    
    // Initialize feature vectors for each author (excluding specified nodes)
    authorNodes.forEach(author => {
      if (!excludeIds.has(author.id)) {
        authorFeatures.set(author.id, new Array(kwIds.length).fill(0));
      }
    });
    
    // Fill feature vectors based on keyword connections
    links.forEach(link => {
      const sourceId = typeof link.source === 'object' ? link.source.id : link.source;
      const targetId = typeof link.target === 'object' ? link.target.id : link.target;
      
      let authorId, keywordId;
      if (sourceId.startsWith('kw:')) {
        keywordId = sourceId;
        authorId = targetId;
      } else if (targetId.startsWith('kw:')) {
        keywordId = targetId;
        authorId = sourceId;
      } else {
        return; // author-author link, skip
      }
      
      const kwIndex = kwIndexById.get(keywordId);
      if (kwIndex >= 0 && authorFeatures.has(authorId)) {
        const vec = authorFeatures.get(authorId);
        vec[kwIndex] = (link.value || 1);
      }
    });
    
    // Convert to array format
    const authorIds = [...authorFeatures.keys()];
    const vectors = authorIds.map(id => authorFeatures.get(id));
    
    if (vectors.length === 0 || vectors[0].length === 0) {
      // Fallback: assign clusters based on hash
      const result = new Map();
      authorNodes.forEach(n => {
        const h = [...n.id].reduce((a,c) => a + c.charCodeAt(0), 0);
        result.set(n.id, h % k);
      });
      return result;
    }
    
    // Calculate IDF weights for each keyword (emphasize rare shared keywords)
    const numAuthors = vectors.length;
    const idfWeights = new Array(kwIds.length).fill(0);
    for (let j = 0; j < kwIds.length; j++) {
      // Count how many authors have this keyword
      let docFreq = 0;
      for (let i = 0; i < numAuthors; i++) {
        if (vectors[i][j] > 0) docFreq++;
      }
      // IDF: log(N / (df + 1)) - rare keywords get higher weight
      idfWeights[j] = Math.log((numAuthors + 1) / (docFreq + 1)) + 1;
    }
    
    // Apply TF-IDF weighting to vectors
    vectors.forEach(vec => {
      for (let j = 0; j < vec.length; j++) {
        vec[j] = vec[j] * idfWeights[j];
      }
    });

    // Keyword similarity smoothing (semantic propagation across similar keywords)
    // This helps when authors use slightly different but semantically close keywords.
    if (simPayload && simAlpha > 0) {
      vectors.forEach(vec => {
        const out = vec.slice();
        for (let i = 0; i < vec.length; i++) {
          const v = vec[i];
          if (!v) continue;
          const kwId = kwIds[i];
          const sims = simPayload[kwId];
          if (!Array.isArray(sims)) continue;
          for (let s = 0; s < sims.length; s++) {
            const pair = sims[s];
            if (!pair || pair.length < 2) continue;
            const otherId = pair[0];
            const sim = Number(pair[1]);
            if (!otherId || !Number.isFinite(sim) || sim <= 0) continue;
            const j = kwIndexById.get(otherId);
            if (j === undefined) continue;
            out[j] += simAlpha * v * sim;
          }
        }
        // Replace vector in-place, prune tiny noise to keep Jaccard meaningful
        for (let i = 0; i < vec.length; i++) {
          vec[i] = out[i] < 1e-6 ? 0 : out[i];
        }
      });
    }
    
    // Normalize vectors to unit length
    vectors.forEach(vec => {
      const mag = Math.sqrt(vec.reduce((s, v) => s + v * v, 0)) || 1;
      for (let i = 0; i < vec.length; i++) vec[i] /= mag;
    });
    
    // Enhanced distance function: combines cosine distance with Jaccard bonus for common keywords
    function enhancedDistance(vec1, vec2) {
      // Cosine similarity (vectors are already normalized)
      let dotProduct = 0;
      for (let i = 0; i < vec1.length; i++) {
        dotProduct += vec1[i] * vec2[i];
      }
      const cosineSim = dotProduct;
      
      // Jaccard-style bonus for shared keywords (emphasize common keywords)
      let commonCount = 0, unionCount = 0;
      for (let i = 0; i < vec1.length; i++) {
        const has1 = vec1[i] > 0.001;
        const has2 = vec2[i] > 0.001;
        if (has1 && has2) commonCount++;
        if (has1 || has2) unionCount++;
      }
      const jaccardSim = unionCount > 0 ? commonCount / unionCount : 0;
      
      // Combined similarity (weighted average)
      // Higher weight on Jaccard to emphasize common keywords
      const combinedSim = 0.5 * cosineSim + 0.5 * jaccardSim;
      
      // Convert similarity to distance
      return 1 - combinedSim;
    }
    
    // K-means++ initialization with enhanced distance
    const centroids = [];
    const usedIndices = new Set();
    
    // First centroid: seeded random
    let idx = Math.floor(random() * vectors.length);
    centroids.push([...vectors[idx]]);
    usedIndices.add(idx);
    
    // Remaining centroids: probability proportional to distance squared
    for (let c = 1; c < k && c < vectors.length; c++) {
      const distances = vectors.map((vec, i) => {
        if (usedIndices.has(i)) return 0;
        let minDist = Infinity;
        centroids.forEach(cent => {
          const d = enhancedDistance(vec, cent);
          if (d < minDist) minDist = d;
        });
        return minDist * minDist; // squared for K-means++
      });
      const totalDist = distances.reduce((a, b) => a + b, 0);
      if (totalDist === 0) break;
      
      let r = random() * totalDist;
      for (let i = 0; i < distances.length; i++) {
        r -= distances[i];
        if (r <= 0 && !usedIndices.has(i)) {
          centroids.push([...vectors[i]]);
          usedIndices.add(i);
          break;
        }
      }
    }
    
    // K-means iterations with enhanced distance
    let assignments = new Array(vectors.length).fill(0);
    for (let iter = 0; iter < 30; iter++) {
      // Assign each point to nearest centroid
      const newAssignments = vectors.map(vec => {
        let bestCluster = 0;
        let bestDist = Infinity;
        centroids.forEach((cent, ci) => {
          const d = enhancedDistance(vec, cent);
          if (d < bestDist) {
            bestDist = d;
            bestCluster = ci;
          }
        });
        return bestCluster;
      });
      
      // Check convergence
      if (newAssignments.every((a, i) => a === assignments[i])) break;
      assignments = newAssignments;
      
      // Update centroids (mean of cluster members)
      for (let ci = 0; ci < centroids.length; ci++) {
        const memberIndices = [];
        for (let i = 0; i < vectors.length; i++) {
          if (assignments[i] === ci) memberIndices.push(i);
        }
        if (memberIndices.length > 0) {
          for (let j = 0; j < centroids[ci].length; j++) {
            let sum = 0;
            memberIndices.forEach(mi => sum += vectors[mi][j]);
            centroids[ci][j] = sum / memberIndices.length;
          }
          // Re-normalize centroid
          const mag = Math.sqrt(centroids[ci].reduce((s, v) => s + v * v, 0)) || 1;
          for (let j = 0; j < centroids[ci].length; j++) centroids[ci][j] /= mag;
        }
      }
    }
    
    // Return cluster assignments as Map
    const result = new Map();
    authorIds.forEach((id, i) => result.set(id, assignments[i]));
    return result;
  }

  function buildGraph(data, keywordSimData = null) {
    // Backwards compatibility if file still has old keys
    data.nodes.forEach(n => {
      if (n.value != null && n.val == null) n.val = n.value;
      if (!n.name) n.name = n.id;
      // Ensure type field exists for older data
      if (!n.type) n.type = 'author';
    });

    // Hover highlight: build adjacency once (id -> Set(neighborIds))
    const adjacency = new Map();
    const addAdj = (a, b) => {
      if (!a || !b) return;
      if (!adjacency.has(a)) adjacency.set(a, new Set());
      adjacency.get(a).add(b);
    };
    (data.links || []).forEach(l => {
      const s = typeof l.source === 'object' ? l.source.id : l.source;
      const t = typeof l.target === 'object' ? l.target.id : l.target;
      addAdj(s, t);
      addAdj(t, s);
    });
    let hoveredNodeId = null;
    let pinnedNodeId = null; // keep focus during click/drag

    // Shared dimming strength for both node fill + labels
    const DIM_ALPHA = 0.05;

    // Hover grow animation (nice, subtle)
    let hoverAnimT = 0;
    let hoverAnimTarget = 0;
    let hoverAnimRaf = 0;
    let hoverAnimLastTs = 0;

    const fadeColor = (color, alpha) => {
      if (!color) return color;
      const c = String(color).trim();

      // #rgb or #rrggbb
      if (c[0] === '#') {
        const hex = c.length === 4
          ? `${c[1]}${c[1]}${c[2]}${c[2]}${c[3]}${c[3]}`
          : c.slice(1);
        if (hex.length === 6) {
          const r = parseInt(hex.slice(0, 2), 16);
          const g = parseInt(hex.slice(2, 4), 16);
          const b = parseInt(hex.slice(4, 6), 16);
          return `rgba(${r},${g},${b},${alpha})`;
        }
      }

      // rgb(r,g,b)
      if (c.startsWith('rgb(')) {
        const inside = c.slice(4, -1);
        return `rgba(${inside},${alpha})`;
      }

      // rgba(r,g,b,a)
      if (c.startsWith('rgba(')) {
        const inside = c.slice(5, -1).split(',').slice(0, 3).join(',');
        return `rgba(${inside},${alpha})`;
      }

      return c;
    };

    const getFocusNodeId = () => hoveredNodeId || pinnedNodeId;

    const requestGraphRedraw = (graphInstance) => {
      if (!graphInstance) return;
      if (typeof graphInstance.refresh === 'function') {
        graphInstance.refresh();
        return;
      }
      // Fallback: re-assign accessor to force a redraw
      graphInstance.nodeCanvasObject(graphInstance.nodeCanvasObject());
    };

    const startHoverAnimation = (graphInstance) => {
      if (hoverAnimRaf) return;
      const step = (ts) => {
        const dt = hoverAnimLastTs ? Math.min(64, ts - hoverAnimLastTs) : 16;
        hoverAnimLastTs = ts;

        // Smooth approach (critically damped-ish)
        const k = 1 - Math.exp(-dt / 110);
        hoverAnimT += (hoverAnimTarget - hoverAnimT) * k;

        requestGraphRedraw(graphInstance);

        if (Math.abs(hoverAnimTarget - hoverAnimT) < 0.002) {
          hoverAnimT = hoverAnimTarget;
          hoverAnimLastTs = 0;
          hoverAnimRaf = 0;
          requestGraphRedraw(graphInstance);
          return;
        }
        hoverAnimRaf = requestAnimationFrame(step);
      };
      hoverAnimRaf = requestAnimationFrame(step);
    };

    const getNodeBaseColor = (n) => {
      if (!n) return '#ffffff';
      // Match the non-dimmed nodeColor rules
      if (n.type === 'keyword') {
        return '#f1f0ec';
      }

      if (n.val === maxAuthorVal && n.type === 'author') return '#ffffff';
      const clusterId = authorClusters.get(n.id);
      if (clusterId === -1 || clusterId === undefined) return '#ffffff';
      return clusterPalette[clusterId % clusterPalette.length];
    };

    const getLinkEndpointId = (endpoint) => (typeof endpoint === 'object' ? endpoint.id : endpoint);
    const isLinkConnectedToFocus = (link) => {
      const focusId = getFocusNodeId();
      if (!focusId || !link) return false;
      const s = getLinkEndpointId(link.source);
      const t = getLinkEndpointId(link.target);
      return s === focusId || t === focusId;
    };

    const isConnectedToHovered = (node) => {
      const focusId = getFocusNodeId();
      if (!focusId) return true;
      if (!node) return false;
      const id = node.id;
      if (id === focusId) return true;
      return adjacency.get(focusId)?.has(id) || false;
    };

    // Separate author and keyword nodes for sizing
    const authorNodes = data.nodes.filter(n => n.type === 'author');
    const keywordNodes = data.nodes.filter(n => n.type === 'keyword');
    
    const maxAuthorVal = Math.max(...authorNodes.map(n => n.val||1), 1);
    const maxKeywordVal = Math.max(...keywordNodes.map(n => n.val||1), 1);
    
    // Top authors (limit 6 like before)
    const topSet = new Set([...authorNodes].sort((a,b)=> (b.val||0)-(a.val||0)).slice(0,6).map(n=>n.id));

    // Top keywords (highlighted)
    const topKeywords = new Set([...keywordNodes].sort((a,b)=> (b.val||0)-(a.val||0)).slice(0,5).map(n=>n.id));

    // Find the largest node to exclude from clustering
    const largestAuthor = authorNodes.find(n => n.val === maxAuthorVal);
    const excludeFromClustering = new Set(largestAuthor ? [largestAuthor.id] : []);

    // Cluster authors by keyword connections using K-means (10 clusters, excluding largest node)
    const authorClusters = kMeansClustering(authorNodes, keywordNodes, data.links, 10, excludeFromClustering, keywordSimData);
    
    // Largest node gets special cluster ID (-1 means no cluster)
    if (largestAuthor) {
      authorClusters.set(largestAuthor.id, -1);
    }
    
    // Distinct color palette for clusters (rainbow + extended)
    const clusterPalette = [
        '#bf1932', // red
        '#ffbe98',
        '#e2583e', // orange
        '#f5df4d', // lime#f5df4d
        '#88b04b', // green
        '#00bcd4', // cyan
        '#7bc4c4',
        '#0f4c81', // blue
        '#b163a3', // indigo
        '#645495', // purple
    ];

    const g = ForceGraph()(container)
      .graphData(data)
      .backgroundColor('#020611')
      .nodeId('id')
      .nodeLabel(n => {
        const displayName = n.name || n.id.replace(/^kw:/, '');
        const escapedName = htmlEscape(displayName);
        
        if (n.type === 'keyword') {
          return `<div class="collabo-node-tooltip"><div style="color:#f1f0ec;font-size:12px;">🏷️ KEYWORD</div><div><strong>${escapedName}</strong><br/>Papers: ${n.val}</div></div>`;
        }
        
        const clusterId = authorClusters.get(n.id);
        const photo = getNodePhoto(n.name);
        const photoMarkup = photo ? `<img class="collabo-node-photo-img" src="${photo}" alt="${escapedName}" loading="lazy"/>` : '';
        
        // Largest node (cluster -1) shows as special
        if (clusterId === -1) {
          return `<div class="collabo-node-tooltip">${photoMarkup}<div><strong>${escapedName}</strong><br/>Papers: ${n.val}<br/><span style="color:#ffffff">★ Main Author</span></div></div>`;
        }
        
        const clusterColor = clusterPalette[(clusterId || 0) % clusterPalette.length];
        return `<div class="collabo-node-tooltip">${photoMarkup}<div><strong>${escapedName}</strong><br/>Papers: ${n.val}<br/><span style="color:${clusterColor}">● Cluster ${(clusterId || 0) + 1}</span></div></div>`;
      })
      .nodeVal(n => {
        // Reduced node sizes for better visualization
        if (n.type === 'keyword') {
          return 0.1 + Math.sqrt(n.val || 1) * 0.15;
        }
        // Make the largest node significantly bigger
        if (n.val === maxAuthorVal) {
          return 0.5 + Math.sqrt(n.val || 1) * 0.6;
        }
        return 0.25 + Math.sqrt(n.val || 1) * 0.3;
      })
      .linkWidth(l => 0.3 + 0.2 * Math.sqrt(l.value||1))
      .linkColor(l => {
        // Brighten edges connected to the focused node (hover or drag)
        if (l && l.__highlight) return 'rgba(255,255,255,0.55)';
        const focusId = getFocusNodeId();
        if (!focusId) return 'rgba(255,255,255,0.08)';
        return isLinkConnectedToFocus(l)
          ? 'rgba(255,255,255,0.35)'
          : 'rgba(255,255,255,0.02)';
      })
      .nodeColor(n => {
        const isConnected = isConnectedToHovered(n);

        // Largest node (max val) is always white
        if (n.val === maxAuthorVal && n.type === 'author') {
          return isConnected ? '#ffffff' : fadeColor('#ffffff', DIM_ALPHA);
        }
        
        // Keywords: fixed color
        if (n.type === 'keyword') {
          const kw = '#f1f0ec';
          return isConnected ? kw : fadeColor(kw, DIM_ALPHA);
        }
        
        // Authors: color by cluster (cluster -1 means largest node, already handled above)
        const clusterId = authorClusters.get(n.id);
        if (clusterId === -1 || clusterId === undefined) {
          return isConnected ? '#ffffff' : fadeColor('#ffffff', DIM_ALPHA);
        }
        const base = clusterPalette[clusterId % clusterPalette.length];
        return isConnected ? base : fadeColor(base, DIM_ALPHA);
      })
      .nodeCanvasObjectMode(() => 'after')
      .nodeCanvasObject((node, ctx, globalScale) => {
        const displayName = node.name || node.id.replace(/^kw:/, '');

        // Hover: draw a subtle growing halo behind the node
        if (hoveredNodeId && node.id === hoveredNodeId) {
          const rawVal = node.val || 1;
          const baseR = 3.4 + Math.sqrt(rawVal) * 0.85;
          const grow = 1 + 0.22 * hoverAnimT;
          const pulse = 1 + 0.04 * Math.sin((performance.now() || 0) / 140);
          const r = baseR * grow * pulse;

          const baseColor = getNodeBaseColor(node);
          // Softer, more transparent halo
          const haloAlpha = 0.08 + 0.12 * hoverAnimT;

          ctx.save();
          // Draw behind existing node even though we're in 'after'
          ctx.globalCompositeOperation = 'destination-over';
          ctx.beginPath();
          ctx.arc(node.x, node.y, r, 0, Math.PI * 2);
          ctx.fillStyle = fadeColor(baseColor, haloAlpha);
          ctx.fill();
          ctx.restore();
        }
        
        // Keywords: do not show labels
        if (node.type === 'keyword') {
          return;
        }
        
        // Authors: show labels based on zoom level and node size
        // Higher zoom (larger globalScale) = show more labels
        // Larger nodes (higher val) = show at lower zoom levels
        const nodeVal = node.val || 1;
        const visibilityThreshold = Math.sqrt(nodeVal) * globalScale;
        
        // Threshold levels:
        // - Top authors (topSet): always visible when zoom > 0.5
        // - Large nodes (val > 10): visible when zoom > 0.8
        // - Medium nodes (val > 5): visible when zoom > 1.2
        // - Small nodes: visible when zoom > 2
        let shouldShow = false;
        if (topSet.has(node.id)) {
          shouldShow = globalScale > 0.5;
        } else if (visibilityThreshold > 4) {
          shouldShow = true;
        } else if (visibilityThreshold > 2.5) {
          shouldShow = globalScale > 1;
        } else if (visibilityThreshold > 1.5) {
          shouldShow = globalScale > 1.5;
        } else {
          shouldShow = globalScale > 2.5;
        }
        
        if (!shouldShow) return;
        
        const baseFontSize = 11 / globalScale;
        // Scale label size with node size (node.val) but keep it bounded.
        const sizeBoost = Math.min(1.4, Math.max(0.5, 0.95 + 0.22 * Math.log2((nodeVal || 1) + 1)));
        const fontSize = Math.max(baseFontSize * sizeBoost, 2.5);
        const isTop = topSet.has(node.id);
        ctx.font = `${isTop ? '600' : '400'} ${fontSize}px Oswald, sans-serif`;

        const isConnected = isConnectedToHovered(node);
        
        // Largest node (cluster -1) text is white, others match cluster color
        const clusterId = authorClusters.get(node.id);
        if (clusterId === -1 || clusterId === undefined) {
          ctx.fillStyle = isConnected ? '#ffffff' : fadeColor('#ffffff', DIM_ALPHA);
        } else {
          const base = clusterPalette[clusterId % clusterPalette.length];
          ctx.fillStyle = isConnected ? base : fadeColor(base, DIM_ALPHA);
        }
        
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        // Position text above node
        const nodeRadius = Math.sqrt(nodeVal) + 1.5;
        ctx.fillText(displayName, node.x, node.y - nodeRadius - fontSize * 0.7);
      })
      .onNodeClick(node => {
        // Center on clicked node
        g.centerAt(node.x, node.y, 1000);
        g.zoom(2, 1000);
        
        // For keywords, search by the keyword name; for authors, search by first name
        if (node.type === 'keyword') {
          const keywordName = node.name || node.id.replace(/^kw:/, '');
          setBibSearchValue(keywordName);
        } else {
          setBibSearchValue(extractFirstName(node.id));
        }
        flashLinks(node, g);
      })
      .onNodeHover(node => {
        const prevId = hoveredNodeId;
        const nextId = node ? node.id : null;
        if (hoveredNodeId !== nextId) {
          hoveredNodeId = nextId;
          // Restart hover grow when switching nodes
          if (nextId && nextId !== prevId) hoverAnimT = 0;
          hoverAnimTarget = nextId ? 1 : 0;
          startHoverAnimation(g);
          // Re-evaluate colors
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
        container.style.cursor = node ? 'pointer':'default';
      })
      .onNodeDrag(node => {
        // While dragging, keep focus pinned so non-neighbors stay dim
        const nextId = node ? node.id : null;
        if (pinnedNodeId !== nextId) {
          pinnedNodeId = nextId;
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
      })
      .onNodeDragEnd(node => {
        // Clear pin after drag so dimming doesn't stick
        if (pinnedNodeId !== null) {
          pinnedNodeId = null;
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
      })
      .enableZoomInteraction(true)
      .enablePanInteraction(true)
      .minZoom(0.3)
      .maxZoom(8);

    function flashLinks(node, gInstance) {
      const related = new Set();
      gInstance.graphData().links.forEach(l => {
        if (l.source.id === node.id || l.target.id === node.id) related.add(l);
      });
      related.forEach(l => { l.__highlight = true; });
      gInstance.linkColor(gInstance.linkColor());
      setTimeout(() => {
        related.forEach(l => { l.__highlight = false; });
        gInstance.linkColor(gInstance.linkColor());
      }, 1300);
    }

    // Build cluster legend dynamically (inside graph, top-left)
    function buildClusterLegend() {
      const legendContainer = document.getElementById('cluster-legend-container');
      if (!legendContainer) return;
      
      // Count members per cluster (exclude cluster -1 which is the largest node)
      const clusterCounts = new Map();
      authorClusters.forEach((clusterId) => {
        if (clusterId >= 0) {  // Skip cluster -1 (largest node)
          clusterCounts.set(clusterId, (clusterCounts.get(clusterId) || 0) + 1);
        }
      });
      
      // Sort clusters by cluster ID for consistent ordering
      const sortedClusters = [...clusterCounts.entries()].sort((a, b) => a[0] - b[0]);
      
      let html = '<div class="cluster-legend">';
      html += '<div class="cluster-legend-title">Clusters</div>';
      
      sortedClusters.forEach(([clusterId, count]) => {
        const color = clusterPalette[clusterId % clusterPalette.length];
        html += `<div class="cluster-item"><span class="cluster-dot" style="background:${color}"></span><span>${count}</span></div>`;
      });
      
      // Add keyword indicator
      html += `<div class="cluster-item"><span class="cluster-dot" style="background:#f1f0ec;border:1px solid #555"></span><span>KW</span></div>`;
      
      html += '</div>';
      legendContainer.innerHTML = html;
    }
    
    buildClusterLegend();

    // Initial sizing
    resizeCanvas(g);
    window.addEventListener('resize', () => resizeCanvas(g));

    // Remove loader
    const loader = document.getElementById('coauthor-graph-loader');
    if (loader) loader.remove();

    // Auto fit view after small warmup
    setTimeout(() => {
      g.zoomToFit(800, 40);
    }, 1200);

  }

  Promise.all([
    fetch('/assets/json/collabo_graph.json').then(r => r.json()),
    fetch('/assets/json/keyword_similarity.json')
      .then(r => r.ok ? r.json() : null)
      .catch(() => null)
  ])
    .then(([data, keywordSimData]) => buildGraph(data, keywordSimData))
    .catch(err => {
      const loader = document.getElementById('coauthor-graph-loader');
      if (loader) loader.textContent = 'Failed to load graph data.';
      console.error('Graph load error', err);
    });
})();
</script>