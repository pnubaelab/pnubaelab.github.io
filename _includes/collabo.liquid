</style>
<div class="collabo-section" style="display: flex; flex-direction: column; gap: 1.5rem; align-items: stretch;">
  <div id="coauthor-graph-wrapper" style="position: relative;">
    <div id="coauthor-graph" style="height: 520px; min-height: 360px; border: 1px solid #222; box-shadow: 0 0 24px #000a; background: #020611; position: relative; overflow: hidden;">
      <div id="coauthor-graph-loader" style="position:absolute;inset:0;z-index:3;display:flex;align-items:center;justify-content:center;color:#ffffff;font-size:.85rem;font-family:system-ui,Segoe UI,sans-serif;letter-spacing:.5px;">Loading Collaboration Graph…</div>
    </div>
    <div id="cluster-legend-container"></div>
    <button id="collabo-back-button" class="collabo-back-button" type="button" aria-label="Clear focused collaboration nodes">Back</button>
  </div>
  <div style="margin-top: .25rem;">
    {% include pub_stats.liquid %}
  </div>
  <div id="coauthor-table" style="width: 100%;"></div>
</div>
<script src="//cdn.jsdelivr.net/npm/force-graph"></script>
<script>
{% assign firstPhoto = true %}
const COLLABO_PHOTOS = {
{% for person in site.people %}
  {% if person.img %}
    {% unless firstPhoto %},{% endunless %}
    "{{ person.title | split:'(' | first | strip | replace:'"','\\"' }}": "{{ person.img | strip }}"
    {% assign firstPhoto = false %}
  {% endif %}
{% endfor %}
};
const COLLABO_DEFAULT_PHOTO = '/assets/img/BAELAB_LOGO.png';

(() => {
  const container = document.getElementById('coauthor-graph');
  const backButton = document.getElementById('collabo-back-button');
  if (!container) return;

  function initGalaxyBackground(target) {
    const galaxyCanvas = document.createElement('canvas');
    const ctx = galaxyCanvas.getContext('2d', { alpha: true });
    if (!ctx) return null;

    galaxyCanvas.setAttribute('aria-hidden', 'true');
    galaxyCanvas.style.position = 'absolute';
    galaxyCanvas.style.inset = '0';
    galaxyCanvas.style.width = '100%';
    galaxyCanvas.style.height = '100%';
    galaxyCanvas.style.zIndex = '0';
    galaxyCanvas.style.pointerEvents = 'none';
    target.prepend(galaxyCanvas);

    const dpr = () => Math.min(window.devicePixelRatio || 1, 2);
    let width = 1;
    let height = 1;
    let mouseX = 0.5;
    let mouseY = 0.5;
    let smoothMouseX = 0.5;
    let smoothMouseY = 0.5;

    const stars = [];
    function createStars(count) {
      stars.length = 0;
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random(),
          y: Math.random(),
          z: 0.3 + Math.random() * 0.7,
          size: 0.3 + Math.random() * 1.6,
          twinkle: Math.random() * Math.PI * 2,
          twinkleSpeed: 0.2 + Math.random() * 1.2,
          hue: 190 + Math.random() * 70
        });
      }
    }

    const onMouseMove = (e) => {
      const rect = target.getBoundingClientRect();
      mouseX = (e.clientX - rect.left) / Math.max(1, rect.width);
      mouseY = (e.clientY - rect.top) / Math.max(1, rect.height);
    };

    const updateResolution = () => {
      width = Math.max(1, target.clientWidth || 1);
      height = Math.max(1, target.clientHeight || 1);
      const ratio = dpr();
      galaxyCanvas.width = Math.max(1, Math.floor(width * ratio));
      galaxyCanvas.height = Math.max(1, Math.floor(height * ratio));
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      const density = Math.max(140, Math.min(420, Math.round((width * height) / 2200)));
      createStars(density);
    };

    const drawNebula = (t) => {
      const cx = width * (0.5 + (smoothMouseX - 0.5) * 0.06);
      const cy = height * (0.5 + (smoothMouseY - 0.5) * 0.06);

      const g1 = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(width, height) * 0.65);
      g1.addColorStop(0, 'rgba(40,95,180,0.23)');
      g1.addColorStop(0.5, 'rgba(86,42,145,0.16)');
      g1.addColorStop(1, 'rgba(2,6,17,0)');
      ctx.fillStyle = g1;
      ctx.fillRect(0, 0, width, height);

      const angle = t * 0.00006;
      const rx = Math.cos(angle) * width * 0.12;
      const ry = Math.sin(angle * 1.2) * height * 0.1;
      const g2 = ctx.createRadialGradient(
        cx + rx,
        cy + ry,
        0,
        cx + rx,
        cy + ry,
        Math.max(width, height) * 0.45
      );
      g2.addColorStop(0, 'rgba(129,93,255,0.15)');
      g2.addColorStop(1, 'rgba(2,6,17,0)');
      ctx.fillStyle = g2;
      ctx.fillRect(0, 0, width, height);
    };

    const drawStars = (t) => {
      for (let i = 0; i < stars.length; i++) {
        const s = stars[i];
        const tw = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(s.twinkle + t * 0.001 * s.twinkleSpeed));
        const px = s.x * width + (smoothMouseX - 0.5) * 30 * s.z;
        const py = s.y * height + (smoothMouseY - 0.5) * 24 * s.z;
        const r = s.size * s.z * (0.6 + tw * 0.9);
        const alpha = 0.18 + tw * 0.55;

        const starGrad = ctx.createRadialGradient(px, py, 0, px, py, Math.max(0.8, r * 3.8));
        starGrad.addColorStop(0, `hsla(${s.hue}, 85%, 78%, ${alpha})`);
        starGrad.addColorStop(1, `hsla(${s.hue}, 90%, 65%, 0)`);
        ctx.fillStyle = starGrad;
        ctx.beginPath();
        ctx.arc(px, py, Math.max(0.8, r * 3.8), 0, Math.PI * 2);
        ctx.fill();
      }
    };

    target.addEventListener('mousemove', onMouseMove);
    const resizeObserver = new ResizeObserver(updateResolution);
    resizeObserver.observe(target);
    updateResolution();

    let rafId = 0;
    const render = (t) => {
      rafId = requestAnimationFrame(render);
      smoothMouseX += (mouseX - smoothMouseX) * 0.05;
      smoothMouseY += (mouseY - smoothMouseY) * 0.05;

      ctx.clearRect(0, 0, width, height);
      drawNebula(t);
      drawStars(t);
    };
    rafId = requestAnimationFrame(render);

    const cleanup = () => {
      cancelAnimationFrame(rafId);
      resizeObserver.disconnect();
      target.removeEventListener('mousemove', onMouseMove);
      if (galaxyCanvas.parentNode === target) target.removeChild(galaxyCanvas);
    };

    window.addEventListener('pagehide', cleanup, { once: true });
    return cleanup;
  }

  function initGalaxyFramePainter(target) {
    let mouseX = 0.5;
    let mouseY = 0.5;
    let smoothMouseX = 0.5;
    let smoothMouseY = 0.5;
    let mouseActive = 0;
    let smoothMouseActive = 0;
    let width = 0;
    let height = 0;
    const stars = [];

    const createStars = (count) => {
      stars.length = 0;
      for (let i = 0; i < count; i++) {
        stars.push({
          angle: Math.random() * Math.PI * 2,
          radius: Math.pow(Math.random(), 0.62),
          z: 0.3 + Math.random() * 0.7,
          size: 0.24 + Math.random() * 1.05,
          twinkle: Math.random() * Math.PI * 2,
          twinkleSpeed: 0.2 + Math.random() * 1.1,
          spin: (Math.random() * 2 - 1) * 0.24,
          phase: Math.random(),
          speed: 0.12 + Math.random() * 0.24
        });
      }
    };

    const ensureStars = (w, h) => {
      if (w === width && h === height && stars.length) return;
      width = w;
      height = h;
      const density = Math.max(160, Math.min(500, Math.round((w * h) / 2800)));
      createStars(density);
    };

    const onMouseMove = (e) => {
      const rect = target.getBoundingClientRect();
      mouseX = (e.clientX - rect.left) / Math.max(1, rect.width);
      mouseY = (e.clientY - rect.top) / Math.max(1, rect.height);
      mouseActive = 1;
    };
    const onMouseLeave = () => {
      mouseX = 0.5;
      mouseY = 0.5;
      mouseActive = 0;
    };
    target.addEventListener('mousemove', onMouseMove);
    target.addEventListener('mouseleave', onMouseLeave);

    return {
      draw(ctx, t) {
        const w = ctx.canvas.width;
        const h = ctx.canvas.height;
        if (!w || !h) return;
        ensureStars(w, h);

        const time = t * 0.001;

        smoothMouseX += (mouseX - smoothMouseX) * 0.05;
        smoothMouseY += (mouseY - smoothMouseY) * 0.05;
        smoothMouseActive += (mouseActive - smoothMouseActive) * 0.06;

        const centerX = w * 0.5;
        const centerY = h * 0.5;
        const focusX = w * smoothMouseX;
        const focusY = h * smoothMouseY;

        const cx = focusX;
        const cy = focusY;
        const globalRot = time * 0.08;

        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);

        ctx.fillStyle = 'rgba(1, 3, 10, 0.94)';
        ctx.fillRect(0, 0, w, h);

        const nebulaA = ctx.createRadialGradient(cx, cy, 0, cx, cy, Math.max(w, h) * 0.62);
        nebulaA.addColorStop(0, 'rgba(20,45,90,0.2)');
        nebulaA.addColorStop(0.55, 'rgba(35,20,70,0.12)');
        nebulaA.addColorStop(1, 'rgba(2,6,17,0)');
        ctx.fillStyle = nebulaA;
        ctx.fillRect(0, 0, w, h);

        const angle = t * 0.00006;
        const rx = Math.cos(angle) * w * 0.12;
        const ry = Math.sin(angle * 1.2) * h * 0.1;
        const nebulaB = ctx.createRadialGradient(cx + rx, cy + ry, 0, cx + rx, cy + ry, Math.max(w, h) * 0.46);
        nebulaB.addColorStop(0, 'rgba(55,70,130,0.1)');
        nebulaB.addColorStop(1, 'rgba(2,6,17,0)');
        ctx.fillStyle = nebulaB;
        ctx.fillRect(0, 0, w, h);

        const core = ctx.createRadialGradient(focusX, focusY, 0, focusX, focusY, Math.max(w, h) * 0.18);
        core.addColorStop(0, `rgba(165, 215, 255, ${0.12 + smoothMouseActive * 0.1})`);
        core.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = core;
        ctx.fillRect(0, 0, w, h);

        const lensRadius = Math.max(w, h) * (0.18 + 0.14 * smoothMouseActive);
        const lensReach = lensRadius * 2.2;
        const clamp01 = (v) => Math.max(0, Math.min(1, v));
        const distortPoint = (x, y, strength = 1) => {
          const dx = x - focusX;
          const dy = y - focusY;
          const dist = Math.hypot(dx, dy);
          if (dist >= lensReach || dist < 0.0001) return { x, y };

          const nx = dx / dist;
          const ny = dy / dist;
          const falloff = 1 - clamp01(dist / lensReach);
          const pinch = (0.1 + 0.22 * smoothMouseActive) * falloff * falloff * strength;
          const twist = (0.08 + 0.2 * smoothMouseActive) * falloff * falloff * strength;

          const warpedX = x - nx * dist * pinch + (-ny) * dist * twist;
          const warpedY = y - ny * dist * pinch + (nx) * dist * twist;
          return { x: warpedX, y: warpedY };
        };

        if (smoothMouseActive > 0.02) {
          const ring = ctx.createRadialGradient(focusX, focusY, lensRadius * 0.45, focusX, focusY, lensRadius * 1.05);
          ring.addColorStop(0, `rgba(255,255,255,${0.02 + smoothMouseActive * 0.02})`);
          ring.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.fillStyle = ring;
          ctx.beginPath();
          ctx.arc(focusX, focusY, lensRadius * 1.05, 0, Math.PI * 2);
          ctx.fill();
        }

        for (let i = 0; i < stars.length; i++) {
          const s = stars[i];
          const tw = 0.45 + 0.55 * (0.5 + 0.5 * Math.sin(s.twinkle + time * s.twinkleSpeed));
          const depth = (s.phase + time * s.speed) % 1;
          const zoom = 2.0 - 1.86 * depth;
          const driftAngle = s.angle + time * s.spin + globalRot;
          const orbitX = Math.cos(driftAngle) * s.radius * w * 0.92;
          const orbitY = Math.sin(driftAngle) * s.radius * h * 0.92;

          let px = cx + orbitX * zoom;
          let py = cy + orbitY * zoom;

          const dx = px - focusX;
          const dy = py - focusY;
          const dist = Math.hypot(dx, dy) + 0.0001;
          const nx = dx / dist;
          const ny = dy / dist;
          const influence = Math.exp(-dist / (Math.max(w, h) * 0.6));
          const inv = 1 / (dist + 28);
          const active = 0.08 + 0.92 * smoothMouseActive;
          const pullBase = (3120 * inv) * (0.4 + 0.9 * s.z) * active;
          const swirlBase = (1900 * inv) * (0.35 + 0.65 * s.z) * active;
          const depthFlow = 0.45 + 1.4 * (1 - depth);
          const suction = pullBase * depthFlow * influence;
          const swirl = swirlBase * (0.4 + 0.8 * (1 - depth)) * influence;

          const vx = -nx * suction + -ny * swirl;
          const vy = -ny * suction + nx * swirl;
          px += vx;
          py += vy;

          const warped = distortPoint(px, py, 0.65 + 0.55 * s.z);
          px = warped.x;
          py = warped.y;

          const r = s.size * s.z * (0.6 + tw * 1.05);
          const alpha = 0.22 + tw * 0.5;

          const starGrad = ctx.createRadialGradient(px, py, 0, px, py, Math.max(0.9, r * 2.9));
          starGrad.addColorStop(0, `rgba(255,255,255,${alpha})`);
          starGrad.addColorStop(1, 'rgba(255,255,255,0)');
          ctx.fillStyle = starGrad;
          ctx.beginPath();
          ctx.arc(px, py, Math.max(0.9, r * 2.9), 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.restore();
      },
      destroy() {
        target.removeEventListener('mousemove', onMouseMove);
        target.removeEventListener('mouseleave', onMouseLeave);
      }
    };
  }

  const galaxyPainter = initGalaxyFramePainter(container);

  const htmlEscape = (str = '') => str.replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);

  function buildNameVariants(rawName = '') {
    const variants = new Set();
    const base = rawName.trim();
    if (!base) return [];
    variants.add(base);
    variants.add(base.replace(/\s+/g, ' '));

    if (base.includes(',')) {
      const [lastPart, ...rest] = base.split(',');
      const last = lastPart.trim();
      const first = rest.join(',').trim();
      if (first && last) {
        variants.add(`${first} ${last}`.trim());
        variants.add(`${last} ${first}`.trim());
      }
    } else {
      const tokens = base.split(/\s+/);
      if (tokens.length >= 2) {
        const last = tokens[tokens.length - 1];
        const first = tokens.slice(0, -1).join(' ');
        variants.add(`${last}, ${first}`.trim());
        variants.add(`${first} ${last}`.trim());
      }
    }

    variants.add(base.replace(/[.,]/g, '').trim());
    return [...variants].filter(Boolean);
  }

  function getNodePhoto(name) {
    const variants = buildNameVariants(name);
    for (const candidate of variants) {
      if (COLLABO_PHOTOS[candidate]) return COLLABO_PHOTOS[candidate];
    }
    return null;
  }

  function extractFirstName(name) {
    if (name.includes(',')) {
      const parts = name.split(',');
      return parts[1] ? parts[1].trim() : '';
    }
    if (/^[가-힣]{2,}$/.test(name)) return name.slice(-2);
    if (/^[A-Za-z ]+$/.test(name.trim())) return name.trim().split(/\s+/)[0];
    return name;
  }
  function setBibSearchValue(value, retries = 6) {
    const searchBox = document.getElementById('bibsearch');
    if (searchBox) {
      searchBox.value = value;
      searchBox.dispatchEvent(new Event('input', { bubbles: true }));
      searchBox.focus();
    } else if (retries > 0) {
      setTimeout(() => setBibSearchValue(value, retries - 1), 250);
    }
  }

  // Responsive height logic for 2D graph
  function computeHeight() {
    const w = container.clientWidth || 800;
    if (w < 576) return Math.max(Math.round(w), 400);
    return Math.max(Math.round(w * 9/16), 420);
  }
  function resizeCanvas(graphInstance) {
    const h = computeHeight();
    container.style.height = h + 'px';
    graphInstance && graphInstance.height(h).width(container.clientWidth || 800);
    const canvases = container.querySelectorAll('canvas');
    canvases.forEach((canvas, idx) => {
      if (idx === 0) return;
      canvas.style.position = 'absolute';
      canvas.style.inset = '0';
      canvas.style.zIndex = '1';
      canvas.style.background = 'transparent';
    });
  }

  // Seeded random number generator for reproducibility
  function seededRandom(seed) {
    let s = seed >>> 0;
    return function() {
      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
      return s / 4294967296;
    };
  }

  // Adaptive spherical k-means over complete author topic profiles.
  // The visible graph still filters rare keyword nodes, but clustering retains them.
  function kMeansClustering(authorNodes, keywordNodes, links, preferredK = 10, excludeIds = new Set(), keywordSimData = null) {
    const similarityPayload = keywordSimData && (keywordSimData.similarities || keywordSimData);
    const configuredSimilarityAlpha = Number(keywordSimData?.alpha);
    const similarityAlpha = Number.isFinite(configuredSimilarityAlpha)
      ? Math.max(0, Math.min(0.75, configuredSimilarityAlpha))
      : 0.3;

    const featureNames = new Set(keywordNodes.map(node => node.name || node.id.replace(/^kw:/, '')));
    authorNodes.forEach(author => {
      Object.keys(author.topic_profile || {}).forEach(topic => featureNames.add(topic));
    });

    const topicNames = [...featureNames].sort((a, b) => {
      const aKey = a.toLowerCase();
      const bKey = b.toLowerCase();
      return aKey < bKey ? -1 : aKey > bKey ? 1 : 0;
    });
    const topicIds = topicNames.map(topic => 'kw:' + topic);
    const topicIndex = new Map(topicIds.map((id, index) => [id, index]));
    const authorFeatures = new Map();
    const authorsWithFullProfiles = new Set();

    [...authorNodes]
      .sort((a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0)
      .forEach(author => {
        if (excludeIds.has(author.id)) return;
        const vector = new Array(topicNames.length).fill(0);
        const profile = author.topic_profile;
        if (profile && typeof profile === 'object' && !Array.isArray(profile)) {
          authorsWithFullProfiles.add(author.id);
          Object.entries(profile).forEach(([topic, rawWeight]) => {
            const index = topicIndex.get('kw:' + topic);
            if (index !== undefined) vector[index] = Math.max(0, Number(rawWeight) || 0);
          });
        }
        authorFeatures.set(author.id, vector);
      });

    // Compatibility path for older JSON that only has author-keyword links.
    links.forEach(link => {
      const sourceId = typeof link.source === 'object' ? link.source.id : link.source;
      const targetId = typeof link.target === 'object' ? link.target.id : link.target;
      let authorId;
      let keywordId;
      if (String(sourceId).startsWith('kw:')) {
        authorId = targetId;
        keywordId = sourceId;
      } else if (String(targetId).startsWith('kw:')) {
        authorId = sourceId;
        keywordId = targetId;
      } else {
        return;
      }
      if (!authorFeatures.has(authorId) || authorsWithFullProfiles.has(authorId)) return;
      const index = topicIndex.get(keywordId);
      if (index !== undefined) {
        authorFeatures.get(authorId)[index] = Math.max(0, Number(link.value) || 1);
      }
    });

    // Avoid making a topic claim from zero or one keyword signal.
    const eligibleAuthorIds = [...authorFeatures.keys()].filter(authorId => {
      const evidenceCount = authorFeatures.get(authorId).reduce(
        (count, value) => count + (value > 0 ? 1 : 0),
        0
      );
      return evidenceCount >= 2;
    });
    const rawVectors = eligibleAuthorIds.map(authorId => authorFeatures.get(authorId));
    const result = new Map();

    if (!rawVectors.length || !topicNames.length) {
      result.meta = {
        selectedK: 0,
        silhouette: 0,
        profiles: new Map(),
        unclassifiedIds: [...authorFeatures.keys()]
      };
      return result;
    }

    // Sublinear TF prevents prolific authors from dominating. Author-level IDF
    // promotes topics that distinguish researchers instead of generic lab terms.
    const idfWeights = new Array(topicNames.length).fill(1);
    for (let featureIndex = 0; featureIndex < topicNames.length; featureIndex++) {
      let documentFrequency = 0;
      for (let authorIndex = 0; authorIndex < rawVectors.length; authorIndex++) {
        if (rawVectors[authorIndex][featureIndex] > 0) documentFrequency++;
      }
      idfWeights[featureIndex] = Math.min(
        3.5,
        Math.log((rawVectors.length + 1) / (documentFrequency + 0.5)) + 1
      );
    }

    const directVectors = rawVectors.map(rawVector =>
      rawVector.map((value, featureIndex) =>
        value > 0 ? Math.log1p(value) * idfWeights[featureIndex] : 0
      )
    );
    let vectors = directVectors;

    // Build a symmetric, row-normalized semantic graph. Direct and propagated
    // features occupy separate channels, preventing high-degree terms from
    // accumulating extra mass or erasing exact keyword evidence.
    const visibleTopicIds = keywordNodes.map(node => node.id);
    const similarityFloor = keywordSimData && Number.isFinite(Number(keywordSimData.threshold))
      ? Number(keywordSimData.threshold)
      : 0.7;
    const similarityCoverage = similarityPayload && topicIds.length
      ? topicIds.filter(id => Array.isArray(similarityPayload[id])).length / topicIds.length
      : 0;
    const visibleSimilarityCoverage = similarityPayload && visibleTopicIds.length
      ? visibleTopicIds.filter(id => Array.isArray(similarityPayload[id])).length / visibleTopicIds.length
      : 0;
    let semanticNeighborCoverage = 0;
    let visibleSemanticNeighborCoverage = 0;
    if (similarityPayload && similarityAlpha > 0 && visibleSimilarityCoverage >= 0.8) {
      const semanticRows = Array.from({ length: topicNames.length }, () => new Map());
      Object.entries(similarityPayload).forEach(([sourceId, neighbors]) => {
        const sourceIndex = topicIndex.get(sourceId);
        if (sourceIndex === undefined || !Array.isArray(neighbors)) return;
        neighbors.forEach(pair => {
          if (!pair || pair.length < 2) return;
          const targetIndex = topicIndex.get(pair[0]);
          const similarity = Number(pair[1]);
          if (targetIndex === undefined || !Number.isFinite(similarity) || similarity <= 0) return;
          const weight = Math.max(
            0,
            Math.min(1, (similarity - similarityFloor) / Math.max(1e-6, 1 - similarityFloor))
          );
          if (!weight) return;
          semanticRows[sourceIndex].set(
            targetIndex,
            Math.max(semanticRows[sourceIndex].get(targetIndex) || 0, weight)
          );
          semanticRows[targetIndex].set(
            sourceIndex,
            Math.max(semanticRows[targetIndex].get(sourceIndex) || 0, weight)
          );
        });
      });

      semanticNeighborCoverage = semanticRows.filter(row => row.size > 0).length
        / Math.max(1, semanticRows.length);
      visibleSemanticNeighborCoverage = visibleTopicIds.filter(id => {
        const index = topicIndex.get(id);
        return index !== undefined && semanticRows[index].size > 0;
      }).length / Math.max(1, visibleTopicIds.length);

      if (semanticNeighborCoverage > 0) {
        const directScale = Math.sqrt(1 - similarityAlpha);
        const semanticScale = Math.sqrt(similarityAlpha);
        const normalizeChannel = channel => {
          const magnitude = Math.sqrt(
            channel.reduce((sum, value) => sum + value * value, 0)
          ) || 1;
          return channel.map(value => value / magnitude);
        };
        vectors = directVectors.map(directVector => {
          // Anchor the semantic view with the exact profile. Authors whose rare
          // topics are missing from a legacy similarity payload therefore retain
          // comparable geometry instead of receiving an empty second channel.
          const semanticVector = directVector.slice();
          directVector.forEach((value, sourceIndex) => {
            if (!value || !semanticRows[sourceIndex].size) return;
            const rowTotal = [...semanticRows[sourceIndex].values()]
              .reduce((sum, weight) => sum + weight, 0) || 1;
            semanticRows[sourceIndex].forEach((weight, targetIndex) => {
              semanticVector[targetIndex] += value * weight / rowTotal;
            });
          });
          return normalizeChannel(directVector).map(value => value * directScale)
            .concat(normalizeChannel(semanticVector).map(value => value * semanticScale));
        });
      }
    }

    const normalize = vector => {
      const magnitude = Math.sqrt(vector.reduce((sum, value) => sum + value * value, 0)) || 1;
      return vector.map(value => value / magnitude);
    };
    for (let i = 0; i < vectors.length; i++) vectors[i] = normalize(vectors[i]);

    const dot = (a, b) => {
      let value = 0;
      for (let i = 0; i < a.length; i++) value += a[i] * b[i];
      return value;
    };
    const cosineDistance = (a, b) => 1 - Math.max(-1, Math.min(1, dot(a, b)));

    // Cache pairwise author similarities once; adaptive k scoring then stays cheap.
    const pairwiseSimilarity = Array.from(
      { length: vectors.length },
      () => new Float32Array(vectors.length)
    );
    for (let i = 0; i < vectors.length; i++) {
      pairwiseSimilarity[i][i] = 1;
      for (let j = i + 1; j < vectors.length; j++) {
        const similarity = dot(vectors[i], vectors[j]);
        pairwiseSimilarity[i][j] = similarity;
        pairwiseSimilarity[j][i] = similarity;
      }
    }

    const initializeCentroids = (clusterCount, seed) => {
      const random = seededRandom(seed);
      const centroids = [];
      const used = new Set();
      const firstIndex = Math.floor(random() * vectors.length);
      centroids.push(vectors[firstIndex].slice());
      used.add(firstIndex);

      while (centroids.length < clusterCount) {
        const distances = vectors.map((vector, vectorIndex) => {
          if (used.has(vectorIndex)) return 0;
          let nearest = Infinity;
          centroids.forEach(centroid => {
            nearest = Math.min(nearest, cosineDistance(vector, centroid));
          });
          // On the unit sphere, cosine distance is already proportional to
          // squared Euclidean distance; squaring again over-selects outliers.
          return nearest;
        });
        const total = distances.reduce((sum, distance) => sum + distance, 0);
        let nextIndex = -1;
        if (total > 0) {
          let threshold = random() * total;
          for (let i = 0; i < distances.length; i++) {
            threshold -= distances[i];
            if (threshold <= 0 && !used.has(i)) {
              nextIndex = i;
              break;
            }
          }
        }
        if (nextIndex < 0) nextIndex = vectors.findIndex((_, index) => !used.has(index));
        if (nextIndex < 0) break;
        centroids.push(vectors[nextIndex].slice());
        used.add(nextIndex);
      }
      return centroids;
    };

    const runSphericalKMeans = (clusterCount, seed) => {
      let centroids = initializeCentroids(clusterCount, seed);
      clusterCount = centroids.length;
      const assignments = new Int16Array(vectors.length);
      assignments.fill(-1);

      for (let iteration = 0; iteration < 45; iteration++) {
        let changed = false;
        for (let authorIndex = 0; authorIndex < vectors.length; authorIndex++) {
          // Preserve the existing assignment on an exact tie. This keeps
          // duplicate vectors in recovered clusters instead of collapsing them
          // back into cluster zero on every iteration.
          let bestCluster = assignments[authorIndex] >= 0 ? assignments[authorIndex] : 0;
          let bestSimilarity = dot(vectors[authorIndex], centroids[bestCluster]);
          for (let clusterIndex = 0; clusterIndex < clusterCount; clusterIndex++) {
            const similarity = dot(vectors[authorIndex], centroids[clusterIndex]);
            if (similarity > bestSimilarity + 1e-12) {
              bestSimilarity = similarity;
              bestCluster = clusterIndex;
            }
          }
          if (assignments[authorIndex] !== bestCluster) changed = true;
          assignments[authorIndex] = bestCluster;
        }

        const sums = Array.from(
          { length: clusterCount },
          () => new Array(vectors[0].length).fill(0)
        );
        const sizes = new Array(clusterCount).fill(0);
        for (let authorIndex = 0; authorIndex < vectors.length; authorIndex++) {
          const clusterIndex = assignments[authorIndex];
          sizes[clusterIndex]++;
          for (let featureIndex = 0; featureIndex < vectors[authorIndex].length; featureIndex++) {
            sums[clusterIndex][featureIndex] += vectors[authorIndex][featureIndex];
          }
        }

        // Recover empty clusters by moving a real point from a non-singleton
        // cluster. Updating assignments and sums keeps the returned model valid.
        for (let emptyCluster = 0; emptyCluster < clusterCount; emptyCluster++) {
          if (sizes[emptyCluster] > 0) continue;
          let farthestIndex = 0;
          let farthestDistance = -1;
          vectors.forEach((vector, vectorIndex) => {
            const sourceCluster = assignments[vectorIndex];
            if (sizes[sourceCluster] <= 1) return;
            const assignedCentroid = centroids[sourceCluster];
            const distance = cosineDistance(vector, assignedCentroid);
            if (distance > farthestDistance) {
              farthestDistance = distance;
              farthestIndex = vectorIndex;
            }
          });
          if (farthestDistance < 0) continue;
          const sourceCluster = assignments[farthestIndex];
          assignments[farthestIndex] = emptyCluster;
          sizes[sourceCluster]--;
          sizes[emptyCluster]++;
          for (let featureIndex = 0; featureIndex < vectors[farthestIndex].length; featureIndex++) {
            const value = vectors[farthestIndex][featureIndex];
            sums[sourceCluster][featureIndex] -= value;
            sums[emptyCluster][featureIndex] += value;
          }
          changed = true;
        }

        centroids = sums.map(sum => normalize(sum));

        if (!changed) break;
      }

      const sizes = new Array(clusterCount).fill(0);
      let objective = 0;
      for (let authorIndex = 0; authorIndex < vectors.length; authorIndex++) {
        const clusterIndex = assignments[authorIndex];
        sizes[clusterIndex]++;
        objective += cosineDistance(vectors[authorIndex], centroids[clusterIndex]);
      }
      return {
        assignments: Array.from(assignments),
        centroids,
        sizes,
        objective: objective / vectors.length
      };
    };

    const silhouetteDetails = model => {
      const pointScores = new Array(vectors.length).fill(0);
      if (model.centroids.length <= 1) return { mean: 0, pointScores };
      for (let authorIndex = 0; authorIndex < vectors.length; authorIndex++) {
        const ownCluster = model.assignments[authorIndex];
        const distanceSums = new Float64Array(model.centroids.length);
        const counts = new Uint16Array(model.centroids.length);
        for (let otherIndex = 0; otherIndex < vectors.length; otherIndex++) {
          if (authorIndex === otherIndex) continue;
          const clusterIndex = model.assignments[otherIndex];
          distanceSums[clusterIndex] += 1 - pairwiseSimilarity[authorIndex][otherIndex];
          counts[clusterIndex]++;
        }
        if (!counts[ownCluster]) continue;
        const within = distanceSums[ownCluster] / counts[ownCluster];
        let nearestOther = Infinity;
        for (let clusterIndex = 0; clusterIndex < model.centroids.length; clusterIndex++) {
          if (clusterIndex === ownCluster || !counts[clusterIndex]) continue;
          nearestOther = Math.min(
            nearestOther,
            distanceSums[clusterIndex] / counts[clusterIndex]
          );
        }
        if (Number.isFinite(nearestOther)) {
          pointScores[authorIndex] =
            (nearestOther - within) / Math.max(within, nearestOther, 1e-9);
        }
      }
      return {
        mean: pointScores.reduce((sum, score) => sum + score, 0) / vectors.length,
        pointScores
      };
    };

    const adjustedRandIndex = (assignmentsA, assignmentsB) => {
      const chooseTwo = value => value > 1 ? value * (value - 1) / 2 : 0;
      const contingency = new Map();
      const rows = new Map();
      const columns = new Map();
      for (let i = 0; i < assignmentsA.length; i++) {
        const row = assignmentsA[i];
        const column = assignmentsB[i];
        const key = row + '|' + column;
        contingency.set(key, (contingency.get(key) || 0) + 1);
        rows.set(row, (rows.get(row) || 0) + 1);
        columns.set(column, (columns.get(column) || 0) + 1);
      }
      const pairTotal = chooseTwo(assignmentsA.length);
      if (!pairTotal) return 1;
      const pairAgreement = [...contingency.values()]
        .reduce((sum, count) => sum + chooseTwo(count), 0);
      const rowPairs = [...rows.values()].reduce((sum, count) => sum + chooseTwo(count), 0);
      const columnPairs = [...columns.values()].reduce((sum, count) => sum + chooseTwo(count), 0);
      const expected = rowPairs * columnPairs / pairTotal;
      const maximum = (rowPairs + columnPairs) / 2;
      return maximum === expected ? 1 : (pairAgreement - expected) / (maximum - expected);
    };

    const candidateKs = [];
    const maxK = vectors.length < 8
      ? Math.max(1, Math.min(vectors.length, Math.round(Math.sqrt(vectors.length))))
      : Math.max(1, Math.min(preferredK, 10, Math.floor(vectors.length / 2)));
    for (let clusterCount = 1; clusterCount <= maxK; clusterCount++) {
      candidateKs.push(clusterCount);
    }

    const candidateModels = [];
    const candidateScores = [];
    candidateKs.forEach(clusterCount => {
      const restartModels = [];
      for (let restart = 0; restart < 6; restart++) {
        const model = runSphericalKMeans(
          clusterCount,
          2019 + clusterCount * 101 + restart * 1009
        );
        restartModels.push(model);
      }
      const minimumObjective = Math.min(...restartModels.map(model => model.objective));
      const nearOptimalModels = restartModels.filter(
        model => model.objective <= minimumObjective * 1.02
      );
      const consensusPool = nearOptimalModels;
      consensusPool.forEach(model => {
        const peers = consensusPool.filter(peer => peer !== model);
        model.consensus = peers.length
          ? peers.reduce(
              (sum, peer) => sum + adjustedRandIndex(model.assignments, peer.assignments),
              0
            ) / peers.length
          : 1;
      });
      // Represent this k with the medoid-like near-optimal partition, not a
      // potentially idiosyncratic lowest-loss restart.
      const bestRestart = [...consensusPool].sort(
        (a, b) => b.consensus - a.consensus || a.objective - b.objective
      )[0];
      const silhouette = silhouetteDetails(bestRestart);
      const restartStability = restartModels
        .filter(model => model !== bestRestart)
        .reduce(
          (sum, model) => sum + adjustedRandIndex(bestRestart.assignments, model.assignments),
          0
        ) / Math.max(1, restartModels.length - 1);
      // A one-cluster partition is reproducible by definition, but that says
      // nothing about meaningful separation.
      const stability = clusterCount > 1 ? restartStability : 0;
      bestRestart.restartModels = restartModels;
      const minimumHealthySize = Math.max(2, Math.floor(vectors.length * 0.015));
      const tinyClusterCount = bestRestart.sizes.filter(size => size < minimumHealthySize).length;
      // Stability only strengthens an already separated solution. Otherwise an
      // arbitrary but reproducible split of identical points would look "good".
      const stabilityContribution = clusterCount > 1
        ? Math.max(0, silhouette.mean) * Math.max(0, stability) * 0.1
        : 0;
      const selectionScore =
        silhouette.mean
        + stabilityContribution
        - tinyClusterCount * 0.02
        - clusterCount * 0.0008;
      bestRestart.silhouette = silhouette.mean;
      bestRestart.pointSilhouettes = silhouette.pointScores;
      bestRestart.stability = stability;
      bestRestart.selectionScore = selectionScore;
      candidateModels.push(bestRestart);
      candidateScores.push({
        k: clusterCount,
        silhouette: Number(silhouette.mean.toFixed(4)),
        stability: Number(stability.toFixed(4)),
        objective: Number(bestRestart.objective.toFixed(4)),
        score: Number(selectionScore.toFixed(4))
      });
    });

    // Prefer the smallest model on a near-equal quality plateau. This reduces
    // visually persuasive but unstable over-partitioning of sparse one-paper authors.
    const peakSelectionScore = Math.max(...candidateModels.map(model => model.selectionScore));
    const plateauTolerance = 0.012;
    const bestModel = candidateModels
      .filter(model => model.selectionScore >= peakSelectionScore - plateauTolerance)
      .sort((a, b) => a.centroids.length - b.centroids.length)[0];

    const buildProfiles = model => {
      const profiles = Array.from(
        { length: model.centroids.length },
        () => ({
          size: 0,
          topicWeights: new Float64Array(topicNames.length),
          topicMembers: new Uint16Array(topicNames.length),
          members: [],
          topics: []
        })
      );
      rawVectors.forEach((vector, authorIndex) => {
        const profile = profiles[model.assignments[authorIndex]];
        profile.size++;
        profile.members.push(eligibleAuthorIds[authorIndex]);
        vector.forEach((value, featureIndex) => {
          if (!value) return;
          profile.topicWeights[featureIndex] += value;
          profile.topicMembers[featureIndex]++;
        });
      });
      profiles.forEach(profile => {
        const rankedTopics = topicNames
          .map((topic, featureIndex) => {
            const coverage = profile.topicMembers[featureIndex] / Math.max(1, profile.size);
            const score =
              Math.log1p(profile.topicWeights[featureIndex])
              * idfWeights[featureIndex]
              * (0.45 + coverage);
            return { topic, score };
          })
          .filter(item => item.score > 0)
          .sort((a, b) => b.score - a.score);
        profile.topics = rankedTopics.slice(0, 4).map(item => item.topic);
      });
      return profiles;
    };

    // Canonicalize cluster IDs by dominant topics so colors remain more stable
    // when publications are added or k-means restarts change.
    const originalProfiles = buildProfiles(bestModel);
    const orderedClusterIds = originalProfiles
      .map((profile, clusterId) => ({
        clusterId,
        signature: (
          profile.topics.slice(0, 3).map(topic => topic.toLowerCase()).join('|')
          + '|' + profile.members.slice().sort().join('|')
        ) || 'zz-' + String(clusterId).padStart(3, '0')
      }))
      .sort((a, b) => a.signature < b.signature ? -1 : a.signature > b.signature ? 1 : 0)
      .map(item => item.clusterId);
    const remap = new Map(orderedClusterIds.map((oldId, newId) => [oldId, newId]));
    const remappedProfiles = new Map();

    originalProfiles.forEach((profile, oldClusterId) => {
      remappedProfiles.set(remap.get(oldClusterId), {
        topics: profile.topics,
        size: profile.size
      });
    });

    eligibleAuthorIds.forEach((authorId, authorIndex) => {
      const oldClusterId = bestModel.assignments[authorIndex];
      const newClusterId = remap.get(oldClusterId);
      result.set(authorId, newClusterId);

      const similarities = bestModel.centroids
        .map(centroid => dot(vectors[authorIndex], centroid))
        .sort((a, b) => b - a);
      const margin = similarities.length > 1 ? similarities[0] - similarities[1] : 0;
      const baselineCluster = bestModel.assignments[authorIndex];
      const baselineMembers = new Set(
        bestModel.assignments
          .map((clusterId, index) => clusterId === baselineCluster ? index : -1)
          .filter(index => index >= 0)
      );
      const pointStability = bestModel.centroids.length > 1
        ? (bestModel.restartModels || [])
          .filter(model => model !== bestModel)
          .reduce((sum, model, _, peers) => {
            const comparisonCluster = model.assignments[authorIndex];
            const comparisonMembers = new Set(
              model.assignments
                .map((clusterId, index) => clusterId === comparisonCluster ? index : -1)
                .filter(index => index >= 0)
            );
            let intersection = 0;
            baselineMembers.forEach(index => {
              if (comparisonMembers.has(index)) intersection++;
            });
            const union = baselineMembers.size + comparisonMembers.size - intersection;
            return sum + (union ? intersection / union : 1) / Math.max(1, peers.length);
          }, 0)
        : 0;
      const authorNode = authorNodes.find(node => node.id === authorId);
      if (authorNode) {
        const marginScore = Math.max(0, Math.min(1, margin / 0.25));
        const silhouetteScore = Math.max(
          0,
          Math.min(1, bestModel.pointSilhouettes[authorIndex] || 0)
        );
        const evidenceScore = Math.min(
          1,
          Math.log1p(Number(authorNode.paper_count) || 1) / Math.log(8)
        );
        const globalStabilityScore = Math.max(0, Math.min(1, bestModel.stability));
        authorNode.clusterConfidence = Number(
          (
            marginScore * 0.25
            + silhouetteScore * 0.25
            + evidenceScore * 0.15
            + pointStability * 0.25
            + globalStabilityScore * 0.1
          ).toFixed(3)
        );
        authorNode.clusterStability = Number(pointStability.toFixed(3));
      }
    });

    result.meta = {
      selectedK: bestModel.centroids.length,
      silhouette: Number(bestModel.silhouette.toFixed(4)),
      stability: Number(bestModel.stability.toFixed(4)),
      objective: Number(bestModel.objective.toFixed(4)),
      similarityCoverage: Number(similarityCoverage.toFixed(4)),
      visibleSimilarityCoverage: Number(visibleSimilarityCoverage.toFixed(4)),
      semanticNeighborCoverage: Number(semanticNeighborCoverage.toFixed(4)),
      visibleSemanticNeighborCoverage: Number(visibleSemanticNeighborCoverage.toFixed(4)),
      profiles: remappedProfiles,
      candidates: candidateScores,
      unclassifiedIds: [...authorFeatures.keys()].filter(authorId => !result.has(authorId))
    };
    return result;
  }

  // Turn the topic assignments into spatial targets so K-means communities
  // read as distinct visual neighborhoods, not only as different colors.
  function createTopicClusterLayout(nodes, links, authorClusters, clusterProfiles) {
    const clusterIds = [...new Set(
      [...authorClusters.values()].filter(clusterId => Number.isInteger(clusterId) && clusterId >= 0)
    )].sort((a, b) => a - b);
    const centers = new Map();
    const fieldRadii = new Map();
    const nodeTargets = new Map();

    if (clusterIds.length === 1) {
      centers.set(clusterIds[0], { x: 0, y: 0 });
    } else {
      const ringRadius = Math.max(118, 52 * Math.sqrt(clusterIds.length));
      clusterIds.forEach((clusterId, index) => {
        const angle = -Math.PI / 2 + index * Math.PI * 2 / clusterIds.length;
        centers.set(clusterId, {
          x: Math.cos(angle) * ringRadius * 1.12,
          y: Math.sin(angle) * ringRadius * 0.76
        });
      });
    }

    clusterIds.forEach(clusterId => {
      const memberCount = clusterProfiles.get(clusterId)?.size || 1;
      fieldRadii.set(clusterId, 34 + Math.sqrt(memberCount) * 4.2);
    });

    const endpointId = endpoint => typeof endpoint === 'object' ? endpoint.id : endpoint;
    const keywordVotes = new Map();
    links.forEach(link => {
      if (link.type !== 'author_keyword') return;
      const sourceId = endpointId(link.source);
      const targetId = endpointId(link.target);
      const sourceIsKeyword = String(sourceId).startsWith('kw:');
      const keywordId = sourceIsKeyword ? sourceId : targetId;
      const authorId = sourceIsKeyword ? targetId : sourceId;
      const clusterId = authorClusters.get(authorId);
      if (!centers.has(clusterId)) return;
      if (!keywordVotes.has(keywordId)) keywordVotes.set(keywordId, new Map());
      const votes = keywordVotes.get(keywordId);
      const weight = Math.max(1, Number(link.paper_count ?? link.value) || 1);
      votes.set(clusterId, (votes.get(clusterId) || 0) + weight);
    });

    nodes.forEach(node => {
      if (node.type === 'author') {
        const clusterId = authorClusters.get(node.id);
        const center = centers.get(clusterId);
        nodeTargets.set(node.id, center
          ? { ...center, role: 'cluster' }
          : { x: 0, y: 0, role: clusterId === -1 ? 'hub' : 'unclassified' });
        return;
      }

      const votes = keywordVotes.get(node.id);
      if (!votes?.size) {
        nodeTargets.set(node.id, { x: 0, y: 0, role: 'keyword' });
        return;
      }
      let totalWeight = 0;
      let targetX = 0;
      let targetY = 0;
      votes.forEach((weight, clusterId) => {
        const center = centers.get(clusterId);
        if (!center) return;
        totalWeight += weight;
        targetX += center.x * weight;
        targetY += center.y * weight;
      });
      nodeTargets.set(node.id, totalWeight
        ? { x: targetX / totalWeight, y: targetY / totalWeight, role: 'keyword' }
        : { x: 0, y: 0, role: 'keyword' });
    });

    // Seed nodes close to their deterministic target so the grouped structure
    // is visible immediately, before the force simulation has fully cooled.
    nodes.forEach(node => {
      if (Number.isFinite(node.x) && Number.isFinite(node.y)) return;
      const target = nodeTargets.get(node.id);
      if (!target) return;
      if (target.role === 'hub') {
        node.x = target.x;
        node.y = target.y;
        return;
      }
      let hash = 2166136261;
      for (const character of String(node.id)) {
        hash ^= character.charCodeAt(0);
        hash = Math.imul(hash, 16777619) >>> 0;
      }
      const angle = hash / 4294967296 * Math.PI * 2;
      const spread = target.role === 'cluster' ? 24 : 32;
      const radius = spread * (0.35 + ((hash >>> 8) % 1000) / 1000 * 0.65);
      node.x = target.x + Math.cos(angle) * radius;
      node.y = target.y + Math.sin(angle) * radius;
    });

    let simulationNodes = [];
    const force = alpha => {
      simulationNodes.forEach(node => {
        const target = nodeTargets.get(node.id);
        if (!target) return;
        const confidence = Math.max(0, Math.min(1, Number(node.clusterConfidence) || 0));
        const strength = node.type === 'keyword'
          ? 0.026
          : target.role === 'cluster'
            ? 0.04 + confidence * 0.07
            : target.role === 'hub'
              ? 0.11
              : 0.006;
        const pull = alpha * strength;
        if (node.fx == null) {
          node.vx = (Number(node.vx) || 0) + (target.x - (Number(node.x) || 0)) * pull;
        }
        if (node.fy == null) {
          node.vy = (Number(node.vy) || 0) + (target.y - (Number(node.y) || 0)) * pull;
        }
      });
    };
    force.initialize = incomingNodes => {
      simulationNodes = incomingNodes || [];
    };

    return { centers, fieldRadii, force };
  }

  function buildGraph(data, keywordSimData = null) {
    // Backwards compatibility if file still has old keys
    data.nodes.forEach(n => {
      if (n.value != null && n.val == null) n.val = n.value;
      if (!n.name) n.name = n.id;
      // Ensure type field exists for older data
      if (!n.type) n.type = 'author';
      if (n.type === 'author') {
        if (n.paper_count == null) n.paper_count = n.val || 1;
        if (n.first_author_count == null) n.first_author_count = 0;
        if (n.first_author_share == null) {
          n.first_author_share = n.paper_count ? n.first_author_count / n.paper_count : 0;
        }
        if (!Array.isArray(n.top_keywords)) n.top_keywords = [];
      }
    });

    // Hover highlight: build adjacency once (id -> Set(neighborIds))
    const adjacency = new Map();
    const addAdj = (a, b) => {
      if (!a || !b) return;
      if (!adjacency.has(a)) adjacency.set(a, new Set());
      adjacency.get(a).add(b);
    };
    (data.links || []).forEach(l => {
      const s = typeof l.source === 'object' ? l.source.id : l.source;
      const t = typeof l.target === 'object' ? l.target.id : l.target;
      addAdj(s, t);
      addAdj(t, s);
    });
    let hoveredNodeId = null;
    let pinnedNodeId = null; // keep focus during click/drag
    let lockedNodeId = null;

    // Shared dimming strength for both node fill + labels
    const DIM_ALPHA = 0.05;

    // Hover grow animation (nice, subtle)
    let hoverAnimT = 0;
    let hoverAnimTarget = 0;
    let hoverAnimRaf = 0;
    let hoverAnimLastTs = 0;

    const fadeColor = (color, alpha) => {
      if (!color) return color;
      const c = String(color).trim();

      // #rgb or #rrggbb
      if (c[0] === '#') {
        const hex = c.length === 4
          ? `${c[1]}${c[1]}${c[2]}${c[2]}${c[3]}${c[3]}`
          : c.slice(1);
        if (hex.length === 6) {
          const r = parseInt(hex.slice(0, 2), 16);
          const g = parseInt(hex.slice(2, 4), 16);
          const b = parseInt(hex.slice(4, 6), 16);
          return `rgba(${r},${g},${b},${alpha})`;
        }
      }

      // rgb(r,g,b)
      if (c.startsWith('rgb(')) {
        const inside = c.slice(4, -1);
        return `rgba(${inside},${alpha})`;
      }

      // rgba(r,g,b,a)
      if (c.startsWith('rgba(')) {
        const inside = c.slice(5, -1).split(',').slice(0, 3).join(',');
        return `rgba(${inside},${alpha})`;
      }

      return c;
    };

    const updateBackButtonVisibility = () => {
      if (!backButton) return;
      backButton.classList.toggle('is-visible', Boolean(lockedNodeId));
    };

    const getFocusNodeId = () => lockedNodeId || pinnedNodeId || hoveredNodeId;

    const requestGraphRedraw = (graphInstance) => {
      if (!graphInstance) return;
      if (typeof graphInstance.refresh === 'function') {
        graphInstance.refresh();
        return;
      }
      // Fallback: re-assign accessor to force a redraw
      graphInstance.nodeCanvasObject(graphInstance.nodeCanvasObject());
    };

    const startHoverAnimation = (graphInstance) => {
      if (hoverAnimRaf) return;
      const step = (ts) => {
        const dt = hoverAnimLastTs ? Math.min(64, ts - hoverAnimLastTs) : 16;
        hoverAnimLastTs = ts;

        // Smooth approach (critically damped-ish)
        const k = 1 - Math.exp(-dt / 110);
        hoverAnimT += (hoverAnimTarget - hoverAnimT) * k;

        requestGraphRedraw(graphInstance);

        if (Math.abs(hoverAnimTarget - hoverAnimT) < 0.002) {
          hoverAnimT = hoverAnimTarget;
          hoverAnimLastTs = 0;
          hoverAnimRaf = 0;
          requestGraphRedraw(graphInstance);
          return;
        }
        hoverAnimRaf = requestAnimationFrame(step);
      };
      hoverAnimRaf = requestAnimationFrame(step);
    };

    const getNodeBaseColor = (n) => {
      if (!n) return '#ffffff';
      // Match the non-dimmed nodeColor rules
      if (n.type === 'keyword') {
        return '#f1f0ec';
      }

      if (n.id === largestAuthor?.id && n.type === 'author') return '#ffffff';
      const clusterId = authorClusters.get(n.id);
      if (clusterId === -1) return '#ffffff';
      if (clusterId === undefined) return unclassifiedColor;
      return clusterPalette[clusterId % clusterPalette.length];
    };

    const getLinkEndpointId = (endpoint) => (typeof endpoint === 'object' ? endpoint.id : endpoint);
    const isLinkConnectedToFocus = (link) => {
      const focusId = getFocusNodeId();
      if (!focusId || !link) return false;
      const s = getLinkEndpointId(link.source);
      const t = getLinkEndpointId(link.target);
      return s === focusId || t === focusId;
    };

    const isConnectedToHovered = (node) => {
      const focusId = getFocusNodeId();
      if (!focusId) return true;
      if (!node) return false;
      const id = node.id;
      if (id === focusId) return true;
      return adjacency.get(focusId)?.has(id) || false;
    };

    const applyLockedFocus = (nodeId) => {
      lockedNodeId = nodeId || null;
      updateBackButtonVisibility();
      g.nodeColor(g.nodeColor());
      g.linkColor(g.linkColor());
      requestGraphRedraw(g);
    };

    // Separate author and keyword nodes for sizing
    const authorNodes = data.nodes.filter(n => n.type === 'author');
    const keywordNodes = data.nodes.filter(n => n.type === 'keyword');
    
    const getPaperCount = node => Math.max(1, Number(node.paper_count ?? node.val) || 1);
    const maxAuthorPapers = Math.max(...authorNodes.map(getPaperCount), 1);
    
    // Top authors (limit 6 like before)
    const topSet = new Set([...authorNodes].sort((a,b)=> getPaperCount(b)-getPaperCount(a)).slice(0,6).map(n=>n.id));

    // Top keywords (highlighted)
    const topKeywords = new Set([...keywordNodes].sort((a,b)=> (b.val||0)-(a.val||0)).slice(0,5).map(n=>n.id));

    // Find the largest node to exclude from clustering
    const largestAuthor = authorNodes.find(n => getPaperCount(n) === maxAuthorPapers);
    const excludeFromClustering = new Set(largestAuthor ? [largestAuthor.id] : []);

    const graphVocabularyHash = data.meta?.topic_vocabulary_hash;
    const similarityVocabularyHash = keywordSimData?.vocabulary_hash;
    const similarityVocabularyMatches = !graphVocabularyHash
      || !similarityVocabularyHash
      || graphVocabularyHash === similarityVocabularyHash;
    if (!similarityVocabularyMatches) {
      console.warn('Collaboration clustering skipped stale keyword similarities.');
    }

    const authorClusters = kMeansClustering(
      authorNodes,
      keywordNodes,
      data.links,
      10,
      excludeFromClustering,
      similarityVocabularyMatches ? keywordSimData : null
    );
    const clusterProfiles = authorClusters.meta?.profiles || new Map();
    const getClusterLabel = clusterId => {
      if (clusterId === -1) return 'Collaboration hub';
      if (!Number.isInteger(clusterId) || clusterId < 0) return 'Unclassified';
      return `Cluster ${clusterId + 1}`;
    };
    
    // Largest node gets special cluster ID (-1 means no cluster)
    if (largestAuthor) {
      authorClusters.set(largestAuthor.id, -1);
    }
    
    // Distinct color palette for clusters (rainbow + extended)
    const clusterPalette = [
        '#bf1932', // red
        '#ffbe98',
        '#e2583e', // orange
        '#f5df4d', // lime#f5df4d
        '#88b04b', // green
        '#00bcd4', // cyan
        '#7bc4c4',
        '#0f4c81', // blue
        '#b163a3', // indigo
        '#645495', // purple
        '#d96c9d',
        '#5b8def',
    ];
    const unclassifiedColor = '#9aa4b2';
    const topicLinkDash = [2, 3];
    const getAuthorVisualValue = node => {
      const paperCount = getPaperCount(node);
      return node.id === largestAuthor?.id
        ? 0.5 + Math.sqrt(paperCount) * 0.6
        : 0.25 + Math.sqrt(paperCount) * 0.3;
    };
    const topicClusterLayout = createTopicClusterLayout(
      data.nodes,
      data.links,
      authorClusters,
      clusterProfiles
    );
    const drawTopicClusterFields = (ctx, globalScale) => {
      if (!topicClusterLayout.centers.size) return;
      const scale = Math.max(0.001, Number(globalScale) || 1);
      const focusCluster = authorClusters.get(getFocusNodeId());
      ctx.save();
      topicClusterLayout.centers.forEach((center, clusterId) => {
        const isActive = focusCluster === undefined || focusCluster < 0 || focusCluster === clusterId;
        const color = clusterPalette[clusterId % clusterPalette.length];
        const radius = topicClusterLayout.fieldRadii.get(clusterId) || 42;
        const halo = ctx.createRadialGradient(center.x, center.y, 0, center.x, center.y, radius);
        halo.addColorStop(0, fadeColor(color, isActive ? 0.075 : 0.012));
        halo.addColorStop(0.62, fadeColor(color, isActive ? 0.026 : 0.006));
        halo.addColorStop(1, fadeColor(color, 0));
        ctx.fillStyle = halo;
        ctx.beginPath();
        ctx.arc(center.x, center.y, radius, 0, Math.PI * 2);
        ctx.fill();

        ctx.setLineDash([3.5 / scale, 6 / scale]);
        ctx.lineWidth = 0.8 / scale;
        ctx.strokeStyle = fadeColor(color, isActive ? 0.18 : 0.035);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.beginPath();
        ctx.arc(center.x, center.y, 1.7 / scale, 0, Math.PI * 2);
        ctx.fillStyle = fadeColor(color, isActive ? 0.62 : 0.12);
        ctx.fill();

        const label = getClusterLabel(clusterId);
        const fontSize = Math.max(8.5 / scale, 3.2);
        ctx.font = `500 ${fontSize}px Oswald, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.lineWidth = 2.2 / scale;
        ctx.strokeStyle = isActive ? 'rgba(2,6,17,0.82)' : 'rgba(2,6,17,0.18)';
        ctx.fillStyle = fadeColor(color, isActive ? 0.54 : 0.09);
        const labelY = center.y - radius * 0.7;
        ctx.strokeText(label, center.x, labelY);
        ctx.fillText(label, center.x, labelY);
      });
      ctx.restore();
    };

    const g = ForceGraph()(container)
      .graphData(data)
      .backgroundColor('rgba(0,0,0,0)')
      .autoPauseRedraw(true)
      .onRenderFramePre((ctx, globalScale) => {
        galaxyPainter.draw(ctx, performance.now());
        drawTopicClusterFields(ctx, globalScale);
      })
      .nodeId('id')
      .nodeLabel(n => {
        const displayName = n.name || n.id.replace(/^kw:/, '');
        const escapedName = htmlEscape(displayName);
        
        if (n.type === 'keyword') {
          const paperCount = Number(n.paper_count ?? n.val) || 0;
          const authorCount = Number(n.author_count) || 0;
          return `<div class="collabo-node-tooltip"><div style="color:#f1f0ec;font-size:12px;">◇ KEYWORD</div><div><strong>${escapedName}</strong></div><div class="collabo-tooltip-meta">${paperCount} papers${authorCount ? ` · ${authorCount} researchers` : ''}</div></div>`;
        }
        
        const clusterId = authorClusters.get(n.id);
        const photo = getNodePhoto(n.name);
        const photoMarkup = photo ? `<img class="collabo-node-photo-img" src="${photo}" alt="${escapedName}" loading="lazy"/>` : '';
        const authorColor = getNodeBaseColor(n);
        const clusterLabel = getClusterLabel(clusterId);
        const topicMarkup = (n.top_keywords || [])
          .slice(0, 3)
          .map(topic => `<span class="collabo-topic-chip">${htmlEscape(topic.name)}</span>`)
          .join('');
        const papers = getPaperCount(n);
        const leadPapers = Number(n.first_author_count) || 0;
        const collaborators = Number(n.coauthor_count) || 0;
        const activity = n.active_from
          ? (n.active_to && n.active_to !== n.active_from ? `${n.active_from}–${n.active_to}` : `${n.active_from}`)
          : '';
        return `<div class="collabo-node-tooltip">${photoMarkup}<div style="color:${authorColor} !important;"><strong style="color:${authorColor} !important;">${escapedName}</strong></div><div class="collabo-tooltip-theme" style="color:${authorColor} !important;">${htmlEscape(clusterLabel)}</div>${topicMarkup ? `<div class="collabo-tooltip-topics">${topicMarkup}</div>` : ''}<div class="collabo-tooltip-meta">${papers} papers · ${leadPapers} lead · ${collaborators} coauthors${activity ? ` · ${activity}` : ''}</div></div>`;
      })
      .nodeVal(n => {
        if (n.type === 'keyword') {
          return 0.1 + Math.sqrt(n.paper_count || n.val || 1) * 0.15;
        }
        return getAuthorVisualValue(n);
      })
      .linkWidth(l => l.type === 'coauthor'
        ? 0.35 + 0.2 * Math.sqrt(l.value || 1)
        : 0.2 + 0.1 * Math.sqrt(l.paper_count || l.value || 1))
      .linkLineDash(l => l.type === 'author_keyword' ? topicLinkDash : null)
      .linkColor(l => {
        // Brighten edges connected to the focused node (hover or drag)
        if (l && l.__highlight) return 'rgba(255,255,255,0.55)';
        const focusId = getFocusNodeId();
        const isCoauthor = l.type === 'coauthor';
        const sourceCluster = authorClusters.get(getLinkEndpointId(l.source));
        const targetCluster = authorClusters.get(getLinkEndpointId(l.target));
        const sharedCluster = isCoauthor
          && sourceCluster >= 0
          && sourceCluster === targetCluster
          ? sourceCluster
          : null;
        if (!focusId) {
          if (!isCoauthor) return 'rgba(255,255,255,0.035)';
          return sharedCluster === null
            ? 'rgba(185,214,240,0.06)'
            : fadeColor(clusterPalette[sharedCluster % clusterPalette.length], 0.13);
        }
        if (isLinkConnectedToFocus(l)) {
          if (!isCoauthor) return 'rgba(255,255,255,0.25)';
          return sharedCluster === null
            ? 'rgba(190,225,255,0.38)'
            : fadeColor(clusterPalette[sharedCluster % clusterPalette.length], 0.46);
        }
        return isCoauthor
          ? 'rgba(185,214,240,0.014)'
          : 'rgba(255,255,255,0.008)';
      })
      .nodeColor(n => {
        const isConnected = isConnectedToHovered(n);
        const base = getNodeBaseColor(n);
        return isConnected ? base : fadeColor(base, DIM_ALPHA);
      })
      // Keep the cluster-colored author body, then add a lightweight stellar
      // core. Keywords remain a separate diamond-shaped visual language.
      .nodeCanvasObjectMode(node => node.type === 'keyword' ? 'replace' : 'after')
      .nodeCanvasObject((node, ctx, globalScale) => {
        const displayName = node.name || node.id.replace(/^kw:/, '');
        const isConnected = isConnectedToHovered(node);
        const baseColor = getNodeBaseColor(node);

        if (node.type === 'keyword') {
          const keywordSize = 2.2 + Math.sqrt(node.paper_count || node.val || 1) * 0.34;
          ctx.save();
          ctx.translate(node.x, node.y);
          ctx.rotate(Math.PI / 4);
          ctx.fillStyle = isConnected ? baseColor : fadeColor(baseColor, DIM_ALPHA);
          ctx.fillRect(-keywordSize / 2, -keywordSize / 2, keywordSize, keywordSize);
          ctx.restore();

          const shouldShowKeyword = topKeywords.has(node.id) && globalScale > 1.1;
          if (shouldShowKeyword) {
            const keywordLabel = displayName.length > 30 ? `${displayName.slice(0, 28)}…` : displayName;
            const fontSize = Math.max(8.5 / globalScale, 2.3);
            ctx.save();
            ctx.font = `400 ${fontSize}px Oswald, sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'bottom';
            ctx.lineWidth = 2.4 / globalScale;
            ctx.strokeStyle = 'rgba(2,6,17,0.88)';
            ctx.fillStyle = isConnected ? '#f1f0ec' : fadeColor('#f1f0ec', DIM_ALPHA);
            ctx.strokeText(keywordLabel, node.x, node.y - keywordSize - 1.5 / globalScale);
            ctx.fillText(keywordLabel, node.x, node.y - keywordSize - 1.5 / globalScale);
            ctx.restore();
          }
          return;
        }

        const nodeVal = getPaperCount(node);
        const visualRadius = Math.sqrt(getAuthorVisualValue(node)) * 4;
        const isTop = topSet.has(node.id);
        const isHub = node.id === largestAuthor?.id;
        const isHovered = hoveredNodeId === node.id;
        const brightness = isConnected ? 1 : DIM_ALPHA;
        const hoverBoost = isHovered ? 1 + 0.24 * hoverAnimT : 1;

        // Bloom is intentionally limited to major/hovered stars. The galaxy
        // already has hundreds of gradients, so this keeps animation smooth.
        if (isTop || isHub || isHovered) {
          const glowRadius = visualRadius * (isHub ? 2.45 : 2.05) * hoverBoost;
          const glow = ctx.createRadialGradient(
            node.x,
            node.y,
            visualRadius * 0.72,
            node.x,
            node.y,
            glowRadius
          );
          glow.addColorStop(0, fadeColor(baseColor, 0));
          glow.addColorStop(0.22, fadeColor(baseColor, 0.2 * brightness));
          glow.addColorStop(0.58, fadeColor(baseColor, 0.08 * brightness));
          glow.addColorStop(1, fadeColor(baseColor, 0));
          ctx.save();
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(node.x, node.y, glowRadius, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        // Major authors receive restrained four-way diffraction spikes. At a
        // far zoom they disappear to avoid turning the graph into visual noise.
        if (globalScale >= 0.55 && (isTop || isHub || isHovered)) {
          const flareLength = (
            visualRadius + (isHub ? 7 : isTop ? 4 : 3) / globalScale
          ) * hoverBoost;
          ctx.save();
          ctx.globalCompositeOperation = 'lighter';
          ctx.strokeStyle = fadeColor('#dff2ff', (isHub ? 0.34 : 0.24) * brightness);
          ctx.lineWidth = 0.48 / globalScale;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(node.x, node.y - flareLength);
          ctx.lineTo(node.x, node.y + flareLength);
          ctx.moveTo(node.x - flareLength * 0.72, node.y);
          ctx.lineTo(node.x + flareLength * 0.72, node.y);
          ctx.stroke();
          ctx.restore();
        }

        // A crisp white pinpoint turns every cluster-colored author node into
        // a star while retaining the original circle and pointer hit area.
        const coreRadius = Math.max(
          0.26 / globalScale,
          Math.min(visualRadius * 0.24, 0.9 / globalScale)
        );
        ctx.save();
        ctx.beginPath();
        ctx.arc(node.x, node.y, coreRadius, 0, Math.PI * 2);
        ctx.fillStyle = fadeColor('#ffffff', 0.92 * brightness);
        ctx.fill();
        ctx.restore();

        // Outer orbit encodes the share of publications led by this author.
        const ringRadius = visualRadius + 1.8 / globalScale;
        const leadShare = Math.max(0, Math.min(1, Number(node.first_author_share) || 0));
        ctx.save();
        ctx.lineWidth = 1.35 / globalScale;
        ctx.beginPath();
        ctx.arc(node.x, node.y, ringRadius, 0, Math.PI * 2);
        ctx.strokeStyle = isConnected
          ? 'rgba(255,255,255,0.16)'
          : 'rgba(255,255,255,0.015)';
        ctx.stroke();
        if (leadShare > 0) {
          ctx.beginPath();
          ctx.arc(
            node.x,
            node.y,
            ringRadius,
            -Math.PI / 2,
            -Math.PI / 2 + Math.PI * 2 * leadShare
          );
          ctx.strokeStyle = isConnected
            ? 'rgba(255,255,255,0.9)'
            : 'rgba(255,255,255,0.05)';
          ctx.stroke();
        }
        ctx.restore();

        // Authors: show labels based on zoom level and node size
        // Higher zoom (larger globalScale) = show more labels
        // Larger nodes (higher val) = show at lower zoom levels
        const visibilityThreshold = Math.sqrt(nodeVal) * globalScale;
        
        // Threshold levels:
        // - Top authors (topSet): always visible when zoom > 0.5
        // - Large nodes (val > 10): visible when zoom > 0.8
        // - Medium nodes (val > 5): visible when zoom > 1.2
        // - Small nodes: visible when zoom > 2
        let shouldShow = false;
        if (topSet.has(node.id)) {
          shouldShow = globalScale > 0.5;
        } else if (visibilityThreshold > 4) {
          shouldShow = true;
        } else if (visibilityThreshold > 2.5) {
          shouldShow = globalScale > 1;
        } else if (visibilityThreshold > 1.5) {
          shouldShow = globalScale > 1.5;
        } else {
          shouldShow = globalScale > 2.5;
        }
        
        if (!shouldShow) return;
        
        const baseFontSize = 11 / globalScale;
        // Scale label size with node size (node.val) but keep it bounded.
        const sizeBoost = Math.min(1.4, Math.max(0.5, 0.95 + 0.22 * Math.log2((nodeVal || 1) + 1)));
        const fontSize = Math.max(baseFontSize * sizeBoost, 2.5);
        ctx.font = `${isTop ? '600' : '400'} ${fontSize}px Oswald, sans-serif`;

        ctx.fillStyle = isConnected ? baseColor : fadeColor(baseColor, DIM_ALPHA);
        ctx.strokeStyle = isConnected ? 'rgba(2,6,17,0.86)' : 'rgba(2,6,17,0.08)';
        ctx.lineWidth = 2.6 / globalScale;
        
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        // Position text above node
        const labelY = node.y - ringRadius - fontSize * 0.7;
        ctx.strokeText(displayName, node.x, labelY);
        ctx.fillText(displayName, node.x, labelY);
      })
      .onNodeClick(node => {
        // Center on clicked node
        g.centerAt(node.x, node.y, 1000);
        g.zoom(2, 1000);
        
        // For keywords, search by the keyword name; for authors, search by first name
        if (node.type === 'keyword') {
          const keywordName = node.name || node.id.replace(/^kw:/, '');
          setBibSearchValue(keywordName);
        } else {
          setBibSearchValue(extractFirstName(node.id));
        }
        flashLinks(node, g);
      })
      .onNodeHover(node => {
        const prevId = hoveredNodeId;
        const nextId = node ? node.id : null;
        if (hoveredNodeId !== nextId) {
          hoveredNodeId = nextId;
          // Restart hover grow when switching nodes
          if (nextId && nextId !== prevId) hoverAnimT = 0;
          hoverAnimTarget = nextId ? 1 : 0;
          startHoverAnimation(g);
          // Re-evaluate colors
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
        container.style.cursor = node ? 'pointer':'default';
      })
      .onNodeDrag(node => {
        // While dragging, keep focus pinned so non-neighbors stay dim
        const nextId = node ? node.id : null;
        if (pinnedNodeId !== nextId) {
          pinnedNodeId = nextId;
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
      })
      .onNodeDragEnd(node => {
        // Clear pin after drag so dimming doesn't stick
        if (pinnedNodeId !== null) {
          pinnedNodeId = null;
          g.nodeColor(g.nodeColor());
          g.linkColor(g.linkColor());
        }
      })
      .enableZoomInteraction(true)
      .enablePanInteraction(true)
      .minZoom(0.3)
      .maxZoom(8);

    if (typeof g.d3Force === 'function') {
      g.d3Force('topic-cluster', topicClusterLayout.force);
      const graphLinkForce = g.d3Force('link');
      if (graphLinkForce?.distance && graphLinkForce?.strength) {
        const endpointCluster = endpoint => authorClusters.get(getLinkEndpointId(endpoint));
        graphLinkForce
          .distance(link => {
            const sourceCluster = endpointCluster(link.source);
            const targetCluster = endpointCluster(link.target);
            if (sourceCluster === -1 || targetCluster === -1) return 82;
            if (link.type === 'author_keyword') return 27;
            if (sourceCluster >= 0 && sourceCluster === targetCluster) return 32;
            return 68;
          })
          .strength(link => {
            const sourceCluster = endpointCluster(link.source);
            const targetCluster = endpointCluster(link.target);
            if (sourceCluster === -1 || targetCluster === -1) return 0.006;
            if (link.type === 'author_keyword') return 0.026;
            if (sourceCluster >= 0 && sourceCluster === targetCluster) return 0.11;
            return 0.014;
          });
      }
      if (typeof g.d3ReheatSimulation === 'function') g.d3ReheatSimulation();
    }

    const onDoubleClick = () => {
      if (!hoveredNodeId) return;
      applyLockedFocus(hoveredNodeId);
    };

    container.addEventListener('dblclick', onDoubleClick);
    if (backButton) {
      backButton.addEventListener('click', () => {
        hoveredNodeId = null;
        pinnedNodeId = null;
        hoverAnimTarget = 0;
        applyLockedFocus(null);
        startHoverAnimation(g);
        container.style.cursor = 'default';
      });
    }

    function flashLinks(node, gInstance) {
      const related = new Set();
      gInstance.graphData().links.forEach(l => {
        if (l.source.id === node.id || l.target.id === node.id) related.add(l);
      });
      related.forEach(l => { l.__highlight = true; });
      gInstance.linkColor(gInstance.linkColor());
      setTimeout(() => {
        related.forEach(l => { l.__highlight = false; });
        gInstance.linkColor(gInstance.linkColor());
      }, 1300);
    }

    // Build cluster legend dynamically (inside graph, top-left)
    function buildClusterLegend() {
      const legendContainer = document.getElementById('cluster-legend-container');
      if (!legendContainer) return;
      
      const clusterCounts = new Map();
      authorClusters.forEach((clusterId) => {
        if (clusterId >= 0) {
          clusterCounts.set(clusterId, (clusterCounts.get(clusterId) || 0) + 1);
        }
      });
      
      const sortedClusters = [...clusterCounts.entries()].sort((a, b) => a[0] - b[0]);
      
      let html = '<div class="cluster-legend">';
      html += '<div class="cluster-legend-title">Clusters</div>';
      
      sortedClusters.forEach(([clusterId, count]) => {
        const color = clusterPalette[clusterId % clusterPalette.length];
        const label = getClusterLabel(clusterId);
        html += `<div class="cluster-item" title="${htmlEscape(label)}"><span class="cluster-dot" style="background:${color}"></span><span class="cluster-name">${htmlEscape(label)}</span><span class="cluster-count">${count}</span></div>`;
      });

      const unclassifiedCount = authorClusters.meta?.unclassifiedIds?.length || 0;
      if (unclassifiedCount) {
        html += `<div class="cluster-item"><span class="cluster-dot" style="background:${unclassifiedColor}"></span><span class="cluster-name">${getClusterLabel(undefined)}</span><span class="cluster-count">${unclassifiedCount}</span></div>`;
      }
      html += '<div class="cluster-item"><span class="cluster-dot keyword"></span><span class="cluster-name">Keyword</span></div>';
      html += '<div class="cluster-legend-note">Position + hue = cluster · star size = papers · orbit = lead-author share</div>';
      html += '</div>';
      legendContainer.innerHTML = html;
    }
    
    buildClusterLegend();

    // Initial sizing
    resizeCanvas(g);
    window.addEventListener('resize', () => resizeCanvas(g));

    // Remove loader
    const loader = document.getElementById('coauthor-graph-loader');
    if (loader) loader.remove();

    // Fit once during warmup and again after the clustered layout settles.
    // Once the visitor pans, zooms or selects a node, never override their view.
    let viewportInteracted = false;
    const markViewportInteraction = () => {
      viewportInteracted = true;
    };
    container.addEventListener('pointerdown', markViewportInteraction, { passive: true });
    container.addEventListener('wheel', markViewportInteraction, { passive: true });
    const autoFitView = () => {
      if (!viewportInteracted) {
        // Topic diamonds can sit between several communities; fit to people so
        // rare shared keywords do not make the actual researcher map too small.
        g.zoomToFit(800, 72, node => node.type === 'author');
      }
    };
    const warmupFitTimerId = window.setTimeout(autoFitView, 1400);
    const settledFitTimerId = window.setTimeout(autoFitView, 4200);
    if (typeof g.onEngineStop === 'function') g.onEngineStop(autoFitView);

    const GALAXY_FRAME_INTERVAL = 1000 / 30;
    const galaxyTimerId = window.setInterval(() => {
      if (document.hidden) return;
      requestGraphRedraw(g);
    }, GALAXY_FRAME_INTERVAL);

    const onVisibilityChange = () => {
      if (!document.hidden) requestGraphRedraw(g);
    };
    document.addEventListener('visibilitychange', onVisibilityChange);

    window.addEventListener('pagehide', () => {
      window.clearInterval(galaxyTimerId);
      window.clearTimeout(warmupFitTimerId);
      window.clearTimeout(settledFitTimerId);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      container.removeEventListener('dblclick', onDoubleClick);
      container.removeEventListener('pointerdown', markViewportInteraction);
      container.removeEventListener('wheel', markViewportInteraction);
      galaxyPainter.destroy();
    }, { once: true });

  }

  Promise.all([
    fetch('/assets/json/collabo_graph.json').then(r => r.json()),
    fetch('/assets/json/keyword_similarity.json')
      .then(r => r.ok ? r.json() : null)
      .catch(() => null)
  ])
    .then(([data, keywordSimData]) => buildGraph(data, keywordSimData))
    .catch(err => {
      const loader = document.getElementById('coauthor-graph-loader');
      if (loader) loader.textContent = 'Failed to load graph data.';
      console.error('Graph load error', err);
    });
})();
</script>
